// Tests for CONTROL_UNIT_16B: every opcode and function code, all control
// signals checked (reserved encodings must not enable anything).

TESTS FOR CONTROL_UNIT_16B {
    TEST "SYS HALT (op 0, fn 0)" {
        SET Op[0] 0, Op[1] 0, Op[2] 0, Op[3] 0, Fn[0] 0, Fn[1] 0, Fn[2] 0, Fn[3] 0;
        EVAL;
        ASSERT RegWrite 0; ASSERT ASrc 0; ASSERT BSrc[0] 0; ASSERT BSrc[1] 0; ASSERT ImmSel[0] 0; ASSERT ImmSel[1] 0; ASSERT AluS[0] 0; ASSERT AluS[1] 0;
        ASSERT InvB 0; ASSERT ZeroA 0; ASSERT CinOne 0; ASSERT CinCarry 0; ASSERT WbSel[0] 0; ASSERT WbSel[1] 0; ASSERT LoadZN 0; ASSERT LoadCV 0;
        ASSERT MemWrite 0; ASSERT MemAddrSel[0] 0; ASSERT MemAddrSel[1] 0; ASSERT MemDataSel 0; ASSERT TargetSel[0] 0; ASSERT TargetSel[1] 0; ASSERT Jump 0; ASSERT BranchInstr 0;
        ASSERT Step2 0; ASSERT SpInc 0; ASSERT SpDec 0; ASSERT OutEnable 0; ASSERT Halt 1; ASSERT ShLeft 1; ASSERT ShRot 0; ASSERT ShArith 0; ASSERT ShImm 0;
    }

    TEST "SYS NOP (op 0, fn 1)" {
