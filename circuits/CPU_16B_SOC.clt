// Program-flow tests for CPU_16B_SOC (one memory for instructions and data).
// The harness plays the memory (the program from address 0) and answers every
// bus access: fetch, data read or write. After each clock it checks PC and
// every change of Out, SP and the flags; every access is checked by address,
// writes also by data. Each test starts with a Reset. Generated from the
// simulator, same programs as CPU_16B.clt; the final Out, SP, flags and all
// memory writes match CPU_16B. Tests marked "wait states" answer each
// access with Wait = 1 for that many clocks first.

TESTS FOR CPU_16B_SOC {
    // Arithmetic, logic and flags
    //   MOVI R1, 200
    //   ADDI R1, -50      ; 150
    //   MOVI R2, 7
    //   ADD  R1, R2       ; 157
    //   SUB  R2, R1       ; 7 - 157 = -150, borrow
    //   NEG  R3, R2       ; 150
    //   NOT  R4, R3
    //   MOV  R5, R4
    //   BIC  R5, R2
    //   XOR  R5, R3
    //   OR   R5, R1
    //   AND  R5, R4
    //   LUI  R6, 0x12
    //   ORI  R6, 0x34     ; 0x1234
    //   XORI R6, 0xFF
    //   ANDI R6, 0xF0
    //   LI   R7, 0x8000
    //   ADDI R7, -1       ; 0x7FFF, signed overflow
    //   ADDI R7, 1        ; 0x8000, overflow
    //   CMP  R7, R7
    //   TEST R7, R0
    //   CMPI R1, 100
    //   OUT  R6
    //   LI   R8, 0xFFFF   ; 32-bit add: (R9:R8) = 0x0001FFFF + 0x00000001
    //   MOVI R9, 1
    //   MOVI R10, 1
    //   ADD  R8, R10
    //   ADC  R9, R0       ; 0x0002
    //   SUB  R8, R10      ; 32-bit subtract 1 again
    //   SBC  R9, R0
    //   OUT  R9
    //   HALT
    TEST "Arithmetic, logic and flags (34 clocks, Out = 0x0001)" {
        SET Wait 0;
        SET Reset 1;
        SEQ CLK 0 -> CLK 1 -> CLK 0;
        SET Reset 0;
        EVAL;
        ASSERT PC[0] 0; ASSERT PC[1] 0; ASSERT PC[2] 0; ASSERT PC[3] 0; ASSERT PC[4] 0; ASSERT PC[5] 0; ASSERT PC[6] 0; ASSERT PC[7] 0; ASSERT PC[8] 0; ASSERT PC[9] 0; ASSERT PC[10] 0; ASSERT PC[11] 0; ASSERT PC[12] 0; ASSERT PC[13] 0; ASSERT PC[14] 0; ASSERT PC[15] 0;
        ASSERT Out[0] 0; ASSERT Out[1] 0; ASSERT Out[2] 0; ASSERT Out[3] 0; ASSERT Out[4] 0; ASSERT Out[5] 0; ASSERT Out[6] 0; ASSERT Out[7] 0; ASSERT Out[8] 0; ASSERT Out[9] 0; ASSERT Out[10] 0; ASSERT Out[11] 0; ASSERT Out[12] 0; ASSERT Out[13] 0; ASSERT Out[14] 0; ASSERT Out[15] 0;
        ASSERT SP[0] 0; ASSERT SP[1] 0; ASSERT SP[2] 0; ASSERT SP[3] 0; ASSERT SP[4] 0; ASSERT SP[5] 0; ASSERT SP[6] 0; ASSERT SP[7] 0; ASSERT SP[8] 0; ASSERT SP[9] 0; ASSERT SP[10] 0; ASSERT SP[11] 0; ASSERT SP[12] 0; ASSERT SP[13] 0; ASSERT SP[14] 0; ASSERT SP[15] 0;
        SET In[0] 0, In[1] 0, In[2] 0, In[3] 0, In[4] 0, In[5] 0, In[6] 0, In[7] 0, In[8] 0, In[9] 0, In[10] 0, In[11] 0, In[12] 0, In[13] 0, In[14] 0, In[15] 0;
        // 0x0000: 0x81C8 (fetch)
        SET DataIn[0] 0, DataIn[1] 0, DataIn[2] 0, DataIn[3] 1, DataIn[4] 0, DataIn[5] 0, DataIn[6] 1, DataIn[7] 1, DataIn[8] 1, DataIn[9] 0, DataIn[10] 0, DataIn[11] 0, DataIn[12] 0, DataIn[13] 0, DataIn[14] 0, DataIn[15] 1;
        SET Wait 0;
        EVAL;
        ASSERT Halted 0; ASSERT Fetch 1; ASSERT Write 0;
        ASSERT Addr[0] 0; ASSERT Addr[1] 0; ASSERT Addr[2] 0; ASSERT Addr[3] 0; ASSERT Addr[4] 0; ASSERT Addr[5] 0; ASSERT Addr[6] 0; ASSERT Addr[7] 0; ASSERT Addr[8] 0; ASSERT Addr[9] 0; ASSERT Addr[10] 0; ASSERT Addr[11] 0; ASSERT Addr[12] 0; ASSERT Addr[13] 0; ASSERT Addr[14] 0; ASSERT Addr[15] 0;
        SEQ CLK 0 -> CLK 1 -> CLK 0;
        ASSERT PC[0] 1; ASSERT PC[1] 0; ASSERT PC[2] 0; ASSERT PC[3] 0; ASSERT PC[4] 0; ASSERT PC[5] 0; ASSERT PC[6] 0; ASSERT PC[7] 0; ASSERT PC[8] 0; ASSERT PC[9] 0; ASSERT PC[10] 0; ASSERT PC[11] 0; ASSERT PC[12] 0; ASSERT PC[13] 0; ASSERT PC[14] 0; ASSERT PC[15] 0;
        // 0x0001: 0x91CE (fetch)
        SET DataIn[0] 0, DataIn[1] 1, DataIn[2] 1, DataIn[3] 1, DataIn[4] 0, DataIn[5] 0, DataIn[6] 1, DataIn[7] 1, DataIn[8] 1, DataIn[9] 0, DataIn[10] 0, DataIn[11] 0, DataIn[12] 1, DataIn[13] 0, DataIn[14] 0, DataIn[15] 1;
        SET Wait 0;
        EVAL;
        ASSERT Halted 0; ASSERT Fetch 1; ASSERT Write 0;
        ASSERT Addr[0] 1; ASSERT Addr[1] 0; ASSERT Addr[2] 0; ASSERT Addr[3] 0; ASSERT Addr[4] 0; ASSERT Addr[5] 0; ASSERT Addr[6] 0; ASSERT Addr[7] 0; ASSERT Addr[8] 0; ASSERT Addr[9] 0; ASSERT Addr[10] 0; ASSERT Addr[11] 0; ASSERT Addr[12] 0; ASSERT Addr[13] 0; ASSERT Addr[14] 0; ASSERT Addr[15] 0;
        SEQ CLK 0 -> CLK 1 -> CLK 0;
        ASSERT PC[0] 0; ASSERT PC[1] 1; ASSERT PC[2] 0; ASSERT PC[3] 0; ASSERT PC[4] 0; ASSERT PC[5] 0; ASSERT PC[6] 0; ASSERT PC[7] 0; ASSERT PC[8] 0; ASSERT PC[9] 0; ASSERT PC[10] 0; ASSERT PC[11] 0; ASSERT PC[12] 0; ASSERT PC[13] 0; ASSERT PC[14] 0; ASSERT PC[15] 0;
        // 0x0002: 0x8207 (fetch)
        SET DataIn[0] 1, DataIn[1] 1, DataIn[2] 1, DataIn[3] 0, DataIn[4] 0, DataIn[5] 0, DataIn[6] 0, DataIn[7] 0, DataIn[8] 0, DataIn[9] 1, DataIn[10] 0, DataIn[11] 0, DataIn[12] 0, DataIn[13] 0, DataIn[14] 0, DataIn[15] 1;
        SET Wait 0;
        EVAL;
        ASSERT Halted 0; ASSERT Fetch 1; ASSERT Write 0;
        ASSERT Addr[0] 0; ASSERT Addr[1] 1; ASSERT Addr[2] 0; ASSERT Addr[3] 0; ASSERT Addr[4] 0; ASSERT Addr[5] 0; ASSERT Addr[6] 0; ASSERT Addr[7] 0; ASSERT Addr[8] 0; ASSERT Addr[9] 0; ASSERT Addr[10] 0; ASSERT Addr[11] 0; ASSERT Addr[12] 0; ASSERT Addr[13] 0; ASSERT Addr[14] 0; ASSERT Addr[15] 0;
        SEQ CLK 0 -> CLK 1 -> CLK 0;
        ASSERT PC[0] 1; ASSERT PC[1] 1; ASSERT PC[2] 0; ASSERT PC[3] 0; ASSERT PC[4] 0; ASSERT PC[5] 0; ASSERT PC[6] 0; ASSERT PC[7] 0; ASSERT PC[8] 0; ASSERT PC[9] 0; ASSERT PC[10] 0; ASSERT PC[11] 0; ASSERT PC[12] 0; ASSERT PC[13] 0; ASSERT PC[14] 0; ASSERT PC[15] 0;
        ASSERT FlagZ 0; ASSERT FlagN 0; ASSERT FlagC 1; ASSERT FlagV 0;
        // 0x0003: 0x1120 (fetch)
        SET DataIn[0] 0, DataIn[1] 0, DataIn[2] 0, DataIn[3] 0, DataIn[4] 0, DataIn[5] 1, DataIn[6] 0, DataIn[7] 0, DataIn[8] 1, DataIn[9] 0, DataIn[10] 0, DataIn[11] 0, DataIn[12] 1, DataIn[13] 0, DataIn[14] 0, DataIn[15] 0;
        SET Wait 0;
        EVAL;
        ASSERT Halted 0; ASSERT Fetch 1; ASSERT Write 0;
        ASSERT Addr[0] 1; ASSERT Addr[1] 1; ASSERT Addr[2] 0; ASSERT Addr[3] 0; ASSERT Addr[4] 0; ASSERT Addr[5] 0; ASSERT Addr[6] 0; ASSERT Addr[7] 0; ASSERT Addr[8] 0; ASSERT Addr[9] 0; ASSERT Addr[10] 0; ASSERT Addr[11] 0; ASSERT Addr[12] 0; ASSERT Addr[13] 0; ASSERT Addr[14] 0; ASSERT Addr[15] 0;
        SEQ CLK 0 -> CLK 1 -> CLK 0;
        ASSERT PC[0] 0; ASSERT PC[1] 0; ASSERT PC[2] 1; ASSERT PC[3] 0; ASSERT PC[4] 0; ASSERT PC[5] 0; ASSERT PC[6] 0; ASSERT PC[7] 0; ASSERT PC[8] 0; ASSERT PC[9] 0; ASSERT PC[10] 0; ASSERT PC[11] 0; ASSERT PC[12] 0; ASSERT PC[13] 0; ASSERT PC[14] 0; ASSERT PC[15] 0;
        // 0x0004: 0x1211 (fetch)
        SET DataIn[0] 1, DataIn[1] 0, DataIn[2] 0, DataIn[3] 0, DataIn[4] 1, DataIn[5] 0, DataIn[6] 0, DataIn[7] 0, DataIn[8] 0, DataIn[9] 1, DataIn[10] 0, DataIn[11] 0, DataIn[12] 1, DataIn[13] 0, DataIn[14] 0, DataIn[15] 0;
        SET Wait 0;
        EVAL;
        ASSERT Halted 0; ASSERT Fetch 1; ASSERT Write 0;
        ASSERT Addr[0] 0; ASSERT Addr[1] 0; ASSERT Addr[2] 1; ASSERT Addr[3] 0; ASSERT Addr[4] 0; ASSERT Addr[5] 0; ASSERT Addr[6] 0; ASSERT Addr[7] 0; ASSERT Addr[8] 0; ASSERT Addr[9] 0; ASSERT Addr[10] 0; ASSERT Addr[11] 0; ASSERT Addr[12] 0; ASSERT Addr[13] 0; ASSERT Addr[14] 0; ASSERT Addr[15] 0;
        SEQ CLK 0 -> CLK 1 -> CLK 0;
        ASSERT PC[0] 1; ASSERT PC[1] 0; ASSERT PC[2] 1; ASSERT PC[3] 0; ASSERT PC[4] 0; ASSERT PC[5] 0; ASSERT PC[6] 0; ASSERT PC[7] 0; ASSERT PC[8] 0; ASSERT PC[9] 0; ASSERT PC[10] 0; ASSERT PC[11] 0; ASSERT PC[12] 0; ASSERT PC[13] 0; ASSERT PC[14] 0; ASSERT PC[15] 0;
        ASSERT FlagZ 0; ASSERT FlagN 0; ASSERT FlagC 0; ASSERT FlagV 0;
        // 0x0005: 0x132A (fetch)
        SET DataIn[0] 0, DataIn[1] 1, DataIn[2] 0, DataIn[3] 1, DataIn[4] 0, DataIn[5] 1, DataIn[6] 0, DataIn[7] 0, DataIn[8] 1, DataIn[9] 1, DataIn[10] 0, DataIn[11] 0, DataIn[12] 1, DataIn[13] 0, DataIn[14] 0, DataIn[15] 0;
        SET Wait 0;
        EVAL;
        ASSERT Halted 0; ASSERT Fetch 1; ASSERT Write 0;
        ASSERT Addr[0] 1; ASSERT Addr[1] 0; ASSERT Addr[2] 1; ASSERT Addr[3] 0; ASSERT Addr[4] 0; ASSERT Addr[5] 0; ASSERT Addr[6] 0; ASSERT Addr[7] 0; ASSERT Addr[8] 0; ASSERT Addr[9] 0; ASSERT Addr[10] 0; ASSERT Addr[11] 0; ASSERT Addr[12] 0; ASSERT Addr[13] 0; ASSERT Addr[14] 0; ASSERT Addr[15] 0;
        SEQ CLK 0 -> CLK 1 -> CLK 0;
        ASSERT PC[0] 0; ASSERT PC[1] 1; ASSERT PC[2] 1; ASSERT PC[3] 0; ASSERT PC[4] 0; ASSERT PC[5] 0; ASSERT PC[6] 0; ASSERT PC[7] 0; ASSERT PC[8] 0; ASSERT PC[9] 0; ASSERT PC[10] 0; ASSERT PC[11] 0; ASSERT PC[12] 0; ASSERT PC[13] 0; ASSERT PC[14] 0; ASSERT PC[15] 0;
        ASSERT FlagZ 0; ASSERT FlagN 1; ASSERT FlagC 0; ASSERT FlagV 0;
        // 0x0006: 0x1439 (fetch)
        SET DataIn[0] 1, DataIn[1] 0, DataIn[2] 0, DataIn[3] 1, DataIn[4] 1, DataIn[5] 1, DataIn[6] 0, DataIn[7] 0, DataIn[8] 0, DataIn[9] 0, DataIn[10] 1, DataIn[11] 0, DataIn[12] 1, DataIn[13] 0, DataIn[14] 0, DataIn[15] 0;
        SET Wait 0;
        EVAL;
        ASSERT Halted 0; ASSERT Fetch 1; ASSERT Write 0;
        ASSERT Addr[0] 0; ASSERT Addr[1] 1; ASSERT Addr[2] 1; ASSERT Addr[3] 0; ASSERT Addr[4] 0; ASSERT Addr[5] 0; ASSERT Addr[6] 0; ASSERT Addr[7] 0; ASSERT Addr[8] 0; ASSERT Addr[9] 0; ASSERT Addr[10] 0; ASSERT Addr[11] 0; ASSERT Addr[12] 0; ASSERT Addr[13] 0; ASSERT Addr[14] 0; ASSERT Addr[15] 0;
        SEQ CLK 0 -> CLK 1 -> CLK 0;
        ASSERT PC[0] 1; ASSERT PC[1] 1; ASSERT PC[2] 1; ASSERT PC[3] 0; ASSERT PC[4] 0; ASSERT PC[5] 0; ASSERT PC[6] 0; ASSERT PC[7] 0; ASSERT PC[8] 0; ASSERT PC[9] 0; ASSERT PC[10] 0; ASSERT PC[11] 0; ASSERT PC[12] 0; ASSERT PC[13] 0; ASSERT PC[14] 0; ASSERT PC[15] 0;
        ASSERT FlagZ 0; ASSERT FlagN 0; ASSERT FlagC 0; ASSERT FlagV 0;
        // 0x0007: 0x1548 (fetch)
        SET DataIn[0] 0, DataIn[1] 0, DataIn[2] 0, DataIn[3] 1, DataIn[4] 0, DataIn[5] 0, DataIn[6] 1, DataIn[7] 0, DataIn[8] 1, DataIn[9] 0, DataIn[10] 1, DataIn[11] 0, DataIn[12] 1, DataIn[13] 0, DataIn[14] 0, DataIn[15] 0;
        SET Wait 0;
        EVAL;
        ASSERT Halted 0; ASSERT Fetch 1; ASSERT Write 0;
        ASSERT Addr[0] 1; ASSERT Addr[1] 1; ASSERT Addr[2] 1; ASSERT Addr[3] 0; ASSERT Addr[4] 0; ASSERT Addr[5] 0; ASSERT Addr[6] 0; ASSERT Addr[7] 0; ASSERT Addr[8] 0; ASSERT Addr[9] 0; ASSERT Addr[10] 0; ASSERT Addr[11] 0; ASSERT Addr[12] 0; ASSERT Addr[13] 0; ASSERT Addr[14] 0; ASSERT Addr[15] 0;
        SEQ CLK 0 -> CLK 1 -> CLK 0;
        ASSERT PC[0] 0; ASSERT PC[1] 0; ASSERT PC[2] 0; ASSERT PC[3] 1; ASSERT PC[4] 0; ASSERT PC[5] 0; ASSERT PC[6] 0; ASSERT PC[7] 0; ASSERT PC[8] 0; ASSERT PC[9] 0; ASSERT PC[10] 0; ASSERT PC[11] 0; ASSERT PC[12] 0; ASSERT PC[13] 0; ASSERT PC[14] 0; ASSERT PC[15] 0;
        ASSERT FlagZ 0; ASSERT FlagN 1; ASSERT FlagC 0; ASSERT FlagV 0;
        // 0x0008: 0x1527 (fetch)
        SET DataIn[0] 1, DataIn[1] 1, DataIn[2] 1, DataIn[3] 0, DataIn[4] 0, DataIn[5] 1, DataIn[6] 0, DataIn[7] 0, DataIn[8] 1, DataIn[9] 0, DataIn[10] 1, DataIn[11] 0, DataIn[12] 1, DataIn[13] 0, DataIn[14] 0, DataIn[15] 0;
        SET Wait 0;
        EVAL;
        ASSERT Halted 0; ASSERT Fetch 1; ASSERT Write 0;
        ASSERT Addr[0] 0; ASSERT Addr[1] 0; ASSERT Addr[2] 0; ASSERT Addr[3] 1; ASSERT Addr[4] 0; ASSERT Addr[5] 0; ASSERT Addr[6] 0; ASSERT Addr[7] 0; ASSERT Addr[8] 0; ASSERT Addr[9] 0; ASSERT Addr[10] 0; ASSERT Addr[11] 0; ASSERT Addr[12] 0; ASSERT Addr[13] 0; ASSERT Addr[14] 0; ASSERT Addr[15] 0;
        SEQ CLK 0 -> CLK 1 -> CLK 0;
        ASSERT PC[0] 1; ASSERT PC[1] 0; ASSERT PC[2] 0; ASSERT PC[3] 1; ASSERT PC[4] 0; ASSERT PC[5] 0; ASSERT PC[6] 0; ASSERT PC[7] 0; ASSERT PC[8] 0; ASSERT PC[9] 0; ASSERT PC[10] 0; ASSERT PC[11] 0; ASSERT PC[12] 0; ASSERT PC[13] 0; ASSERT PC[14] 0; ASSERT PC[15] 0;
        // 0x0009: 0x1536 (fetch)
        SET DataIn[0] 0, DataIn[1] 1, DataIn[2] 1, DataIn[3] 0, DataIn[4] 1, DataIn[5] 1, DataIn[6] 0, DataIn[7] 0, DataIn[8] 1, DataIn[9] 0, DataIn[10] 1, DataIn[11] 0, DataIn[12] 1, DataIn[13] 0, DataIn[14] 0, DataIn[15] 0;
        SET Wait 0;
        EVAL;
        ASSERT Halted 0; ASSERT Fetch 1; ASSERT Write 0;
        ASSERT Addr[0] 1; ASSERT Addr[1] 0; ASSERT Addr[2] 0; ASSERT Addr[3] 1; ASSERT Addr[4] 0; ASSERT Addr[5] 0; ASSERT Addr[6] 0; ASSERT Addr[7] 0; ASSERT Addr[8] 0; ASSERT Addr[9] 0; ASSERT Addr[10] 0; ASSERT Addr[11] 0; ASSERT Addr[12] 0; ASSERT Addr[13] 0; ASSERT Addr[14] 0; ASSERT Addr[15] 0;
        SEQ CLK 0 -> CLK 1 -> CLK 0;
        ASSERT PC[0] 0; ASSERT PC[1] 1; ASSERT PC[2] 0; ASSERT PC[3] 1; ASSERT PC[4] 0; ASSERT PC[5] 0; ASSERT PC[6] 0; ASSERT PC[7] 0; ASSERT PC[8] 0; ASSERT PC[9] 0; ASSERT PC[10] 0; ASSERT PC[11] 0; ASSERT PC[12] 0; ASSERT PC[13] 0; ASSERT PC[14] 0; ASSERT PC[15] 0;
        ASSERT FlagZ 0; ASSERT FlagN 0; ASSERT FlagC 0; ASSERT FlagV 0;
        // 0x000A: 0x1515 (fetch)
        SET DataIn[0] 1, DataIn[1] 0, DataIn[2] 1, DataIn[3] 0, DataIn[4] 1, DataIn[5] 0, DataIn[6] 0, DataIn[7] 0, DataIn[8] 1, DataIn[9] 0, DataIn[10] 1, DataIn[11] 0, DataIn[12] 1, DataIn[13] 0, DataIn[14] 0, DataIn[15] 0;
        SET Wait 0;
        EVAL;
        ASSERT Halted 0; ASSERT Fetch 1; ASSERT Write 0;
        ASSERT Addr[0] 0; ASSERT Addr[1] 1; ASSERT Addr[2] 0; ASSERT Addr[3] 1; ASSERT Addr[4] 0; ASSERT Addr[5] 0; ASSERT Addr[6] 0; ASSERT Addr[7] 0; ASSERT Addr[8] 0; ASSERT Addr[9] 0; ASSERT Addr[10] 0; ASSERT Addr[11] 0; ASSERT Addr[12] 0; ASSERT Addr[13] 0; ASSERT Addr[14] 0; ASSERT Addr[15] 0;
        SEQ CLK 0 -> CLK 1 -> CLK 0;
        ASSERT PC[0] 1; ASSERT PC[1] 1; ASSERT PC[2] 0; ASSERT PC[3] 1; ASSERT PC[4] 0; ASSERT PC[5] 0; ASSERT PC[6] 0; ASSERT PC[7] 0; ASSERT PC[8] 0; ASSERT PC[9] 0; ASSERT PC[10] 0; ASSERT PC[11] 0; ASSERT PC[12] 0; ASSERT PC[13] 0; ASSERT PC[14] 0; ASSERT PC[15] 0;
