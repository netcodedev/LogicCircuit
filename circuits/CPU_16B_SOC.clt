    // Loops and conditional branches
    //   MOVI R1, 0        ; sum
    //   MOVI R2, 10       ; counter
    //   loop:
    //   ADD  R1, R2
    //   ADDI R2, -1
    //   BNE  loop         ; sum 10..1 = 55
    //   OUT  R1
    //   MOVI R3, 5
    //   LI   R4, 0xFFFE   ; -2
    //   CMP  R4, R3
    //   BLT  signed_ok
    //   HALT
    //   signed_ok:
    //   CMP  R4, R3
    //   BHI  unsigned_ok  ; 0xFFFE > 5 unsigned
    //   HALT
    //   unsigned_ok:
    //   CMP  R3, R3
    //   BGT  bad
    //   BLE  le_ok
    //   bad:
    //   HALT
    //   le_ok:
    //   CMPI R3, 5
    //   BEQ  eq_ok
    //   HALT
    //   eq_ok:
    //   BRA  done
    //   OUT  R0
    //   done:
    //   ADDI R1, 1
    //   OUT  R1           ; 56
    //   HALT
    TEST "Loops and conditional branches (54 clocks, Out = 0x0038)" {
        SET Wait 0;
        SET Reset 1;
        SEQ CLK 0 -> CLK 1 -> CLK 0;
        SET Reset 0;
        EVAL;
