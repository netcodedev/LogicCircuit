// Tests for IMM_RV32: every immediate format (and none)
//
// Generated by `cargo test --release --lib riscv::clt_gen -- --ignored`
// from the simulator; the circuit is checked against Rust references and the
// instruction-level simulator in src/riscv/tests.rs and cpu_tests.rs.

TESTS FOR IMM_RV32 {
    TEST "vectors 0..9" {
        SET Ir[31:0] 0xD60EEBC7, FmtI 1, FmtS 0, FmtB 0, FmtU 0, FmtJ 0;
        EVAL;
        ASSERT Imm[31:0] 0xFFFFFD60;
        SET Ir[31:0] 0x44C0E7D0, FmtI 0, FmtS 1, FmtB 0, FmtU 0, FmtJ 0;
        EVAL;
        ASSERT Imm[31:0] 0x0000044F;
        SET Ir[31:0] 0xA8B4921F, FmtI 0, FmtS 0, FmtB 1, FmtU 0, FmtJ 0;
        EVAL;
        ASSERT Imm[31:0] 0xFFFFF284;
        SET Ir[31:0] 0x4F749CFB, FmtI 0, FmtS 0, FmtB 0, FmtU 1, FmtJ 0;
        EVAL;
        ASSERT Imm[31:0] 0x4F749000;
        SET Ir[31:0] 0xF3562B02, FmtI 0, FmtS 0, FmtB 0, FmtU 0, FmtJ 1;
        EVAL;
        ASSERT Imm[31:0] 0xFFF62F34;
        SET Ir[31:0] 0xE7F207D4, FmtI 0, FmtS 0, FmtB 0, FmtU 0, FmtJ 0;
        EVAL;
        ASSERT Imm[31:0] 0x00000000;
        SET Ir[31:0] 0xE7F096DB, FmtI 1, FmtS 0, FmtB 0, FmtU 0, FmtJ 0;
        EVAL;
        ASSERT Imm[31:0] 0xFFFFFE7F;
        SET Ir[31:0] 0x9EADA136, FmtI 0, FmtS 1, FmtB 0, FmtU 0, FmtJ 0;
        EVAL;
        ASSERT Imm[31:0] 0xFFFFF9E2;
        SET Ir[31:0] 0xCB3677F4, FmtI 0, FmtS 0, FmtB 1, FmtU 0, FmtJ 0;
        EVAL;
        ASSERT Imm[31:0] 0xFFFFFCAE;
        SET Ir[31:0] 0x91F5661B, FmtI 0, FmtS 0, FmtB 0, FmtU 1, FmtJ 0;
        EVAL;
        ASSERT Imm[31:0] 0x91F56000;
    }

    TEST "vectors 10..19" {
        SET Ir[31:0] 0x9B626A17, FmtI 0, FmtS 0, FmtB 0, FmtU 0, FmtJ 1;
        EVAL;
        ASSERT Imm[31:0] 0xFFF261B6;
        SET Ir[31:0] 0x898ACB03, FmtI 0, FmtS 0, FmtB 0, FmtU 0, FmtJ 0;
        EVAL;
        ASSERT Imm[31:0] 0x00000000;
        SET Ir[31:0] 0xD5E17E55, FmtI 1, FmtS 0, FmtB 0, FmtU 0, FmtJ 0;
        EVAL;
        ASSERT Imm[31:0] 0xFFFFFD5E;
        SET Ir[31:0] 0xD60D89E9, FmtI 0, FmtS 1, FmtB 0, FmtU 0, FmtJ 0;
        EVAL;
        ASSERT Imm[31:0] 0xFFFFFD73;
        SET Ir[31:0] 0xA68AC8BA, FmtI 0, FmtS 0, FmtB 1, FmtU 0, FmtJ 0;
        EVAL;
        ASSERT Imm[31:0] 0xFFFFFA70;
        SET Ir[31:0] 0x9534B3AB, FmtI 0, FmtS 0, FmtB 0, FmtU 1, FmtJ 0;
        EVAL;
        ASSERT Imm[31:0] 0x9534B000;
        SET Ir[31:0] 0xF75F500C, FmtI 0, FmtS 0, FmtB 0, FmtU 0, FmtJ 1;
        EVAL;
        ASSERT Imm[31:0] 0xFFFF5F74;
        SET Ir[31:0] 0xC23C6DAC, FmtI 0, FmtS 0, FmtB 0, FmtU 0, FmtJ 0;
        EVAL;
        ASSERT Imm[31:0] 0x00000000;
        SET Ir[31:0] 0xC1F8FE77, FmtI 1, FmtS 0, FmtB 0, FmtU 0, FmtJ 0;
        EVAL;
        ASSERT Imm[31:0] 0xFFFFFC1F;
        SET Ir[31:0] 0x971C724B, FmtI 0, FmtS 1, FmtB 0, FmtU 0, FmtJ 0;
        EVAL;
        ASSERT Imm[31:0] 0xFFFFF964;
    }

    TEST "vectors 20..29" {
        SET Ir[31:0] 0x6DB9B86F, FmtI 0, FmtS 0, FmtB 1, FmtU 0, FmtJ 0;
        EVAL;
        ASSERT Imm[31:0] 0x000006D0;
        SET Ir[31:0] 0x93BF30DF, FmtI 0, FmtS 0, FmtB 0, FmtU 1, FmtJ 0;
        EVAL;
        ASSERT Imm[31:0] 0x93BF3000;
        SET Ir[31:0] 0x9DB3997E, FmtI 0, FmtS 0, FmtB 0, FmtU 0, FmtJ 1;
        EVAL;
        ASSERT Imm[31:0] 0xFFF399DA;
        SET Ir[31:0] 0x34D961CC, FmtI 0, FmtS 0, FmtB 0, FmtU 0, FmtJ 0;
        EVAL;
        ASSERT Imm[31:0] 0x00000000;
        SET Ir[31:0] 0x5ACF200F, FmtI 1, FmtS 0, FmtB 0, FmtU 0, FmtJ 0;
        EVAL;
        ASSERT Imm[31:0] 0x000005AC;
        SET Ir[31:0] 0x66AD5D8F, FmtI 0, FmtS 1, FmtB 0, FmtU 0, FmtJ 0;
        EVAL;
        ASSERT Imm[31:0] 0x0000067B;
        SET Ir[31:0] 0x996E84F4, FmtI 0, FmtS 0, FmtB 1, FmtU 0, FmtJ 0;
        EVAL;
        ASSERT Imm[31:0] 0xFFFFF988;
        SET Ir[31:0] 0xB499E4FD, FmtI 0, FmtS 0, FmtB 0, FmtU 1, FmtJ 0;
        EVAL;
        ASSERT Imm[31:0] 0xB499E000;
        SET Ir[31:0] 0x91FE4874, FmtI 0, FmtS 0, FmtB 0, FmtU 0, FmtJ 1;
        EVAL;
        ASSERT Imm[31:0] 0xFFFE491E;
        SET Ir[31:0] 0x7D8929E4, FmtI 0, FmtS 0, FmtB 0, FmtU 0, FmtJ 0;
        EVAL;
        ASSERT Imm[31:0] 0x00000000;
    }

    TEST "vectors 30..39" {
        SET Ir[31:0] 0x616AC2B7, FmtI 1, FmtS 0, FmtB 0, FmtU 0, FmtJ 0;
        EVAL;
        ASSERT Imm[31:0] 0x00000616;
        SET Ir[31:0] 0x66AA5AF2, FmtI 0, FmtS 1, FmtB 0, FmtU 0, FmtJ 0;
        EVAL;
        ASSERT Imm[31:0] 0x00000675;
        SET Ir[31:0] 0x2E21F2C7, FmtI 0, FmtS 0, FmtB 1, FmtU 0, FmtJ 0;
        EVAL;
        ASSERT Imm[31:0] 0x00000AE4;
        SET Ir[31:0] 0x779DE0E2, FmtI 0, FmtS 0, FmtB 0, FmtU 1, FmtJ 0;
        EVAL;
        ASSERT Imm[31:0] 0x779DE000;
        SET Ir[31:0] 0xFD50A3A3, FmtI 0, FmtS 0, FmtB 0, FmtU 0, FmtJ 1;
        EVAL;
        ASSERT Imm[31:0] 0xFFF0AFD4;
        SET Ir[31:0] 0x56BE8A24, FmtI 0, FmtS 0, FmtB 0, FmtU 0, FmtJ 0;
        EVAL;
        ASSERT Imm[31:0] 0x00000000;
        SET Ir[31:0] 0xE295FE30, FmtI 1, FmtS 0, FmtB 0, FmtU 0, FmtJ 0;
        EVAL;
        ASSERT Imm[31:0] 0xFFFFFE29;
        SET Ir[31:0] 0x3A7159CC, FmtI 0, FmtS 1, FmtB 0, FmtU 0, FmtJ 0;
        EVAL;
        ASSERT Imm[31:0] 0x000003B3;
        SET Ir[31:0] 0xC194487F, FmtI 0, FmtS 0, FmtB 1, FmtU 0, FmtJ 0;
        EVAL;
        ASSERT Imm[31:0] 0xFFFFF410;
        SET Ir[31:0] 0x6C549F2F, FmtI 0, FmtS 0, FmtB 0, FmtU 1, FmtJ 0;
        EVAL;
        ASSERT Imm[31:0] 0x6C549000;
    }

    TEST "vectors 40..49" {
        SET Ir[31:0] 0x03EC1DD1, FmtI 0, FmtS 0, FmtB 0, FmtU 0, FmtJ 1;
        EVAL;
        ASSERT Imm[31:0] 0x000C103E;
        SET Ir[31:0] 0x5E0291AA, FmtI 0, FmtS 0, FmtB 0, FmtU 0, FmtJ 0;
        EVAL;
        ASSERT Imm[31:0] 0x00000000;
        SET Ir[31:0] 0x163DBE09, FmtI 1, FmtS 0, FmtB 0, FmtU 0, FmtJ 0;
        EVAL;
        ASSERT Imm[31:0] 0x00000163;
        SET Ir[31:0] 0x92D56735, FmtI 0, FmtS 1, FmtB 0, FmtU 0, FmtJ 0;
        EVAL;
        ASSERT Imm[31:0] 0xFFFFF92E;
        SET Ir[31:0] 0x5539A0BB, FmtI 0, FmtS 0, FmtB 1, FmtU 0, FmtJ 0;
        EVAL;
        ASSERT Imm[31:0] 0x00000D40;
        SET Ir[31:0] 0xAB989D3A, FmtI 0, FmtS 0, FmtB 0, FmtU 1, FmtJ 0;
        EVAL;
        ASSERT Imm[31:0] 0xAB989000;
        SET Ir[31:0] 0xA24FA280, FmtI 0, FmtS 0, FmtB 0, FmtU 0, FmtJ 1;
        EVAL;
        ASSERT Imm[31:0] 0xFFFFA224;
        SET Ir[31:0] 0xB5399DC5, FmtI 0, FmtS 0, FmtB 0, FmtU 0, FmtJ 0;
        EVAL;
        ASSERT Imm[31:0] 0x00000000;
        SET Ir[31:0] 0x50F03FBE, FmtI 1, FmtS 0, FmtB 0, FmtU 0, FmtJ 0;
        EVAL;
        ASSERT Imm[31:0] 0x0000050F;
        SET Ir[31:0] 0xF12BF041, FmtI 0, FmtS 1, FmtB 0, FmtU 0, FmtJ 0;
        EVAL;
        ASSERT Imm[31:0] 0xFFFFFF00;
    }

    TEST "vectors 50..59" {
        SET Ir[31:0] 0x65FF97E1, FmtI 0, FmtS 0, FmtB 1, FmtU 0, FmtJ 0;
        EVAL;
        ASSERT Imm[31:0] 0x00000E4E;
