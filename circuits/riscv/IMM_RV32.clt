        EVAL;
        ASSERT Imm[31:0] 0xFFFFFD04;
        SET Ir[31:0] 0x26F9934D, FmtI 0, FmtS 0, FmtB 0, FmtU 1, FmtJ 0;
        EVAL;
        ASSERT Imm[31:0] 0x26F99000;
        SET Ir[31:0] 0x7EEF132B, FmtI 0, FmtS 0, FmtB 0, FmtU 0, FmtJ 1;
