        SET Ir[31:0] 0x7D332878, FmtI 1, FmtS 0, FmtB 0, FmtU 0, FmtJ 0;
        EVAL;
        ASSERT Imm[31:0] 0x000007D3;
        SET Ir[31:0] 0xDA5C5028, FmtI 0, FmtS 1, FmtB 0, FmtU 0, FmtJ 0;
        EVAL;
