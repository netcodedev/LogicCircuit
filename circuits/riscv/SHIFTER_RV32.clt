// Tests for SHIFTER_RV32: sll, srl, sra by every kind of amount
//
// Generated by `cargo test --release --lib riscv::clt_gen -- --ignored`
// from the simulator; the circuit is checked against Rust references and the
// instruction-level simulator in src/riscv/tests.rs and cpu_tests.rs.

TESTS FOR SHIFTER_RV32 {
    TEST "vectors 0..9" {
        SET A[31:0] 0x0300D406, Amt[4:0] 0x00, Left 0, Arith 1;
        EVAL;
        ASSERT Out[31:0] 0x0300D406;
        SET A[31:0] 0xC31B5204, Amt[4:0] 0x01, Left 1, Arith 1;
        EVAL;
        ASSERT Out[31:0] 0x8636A409;
        SET A[31:0] 0xF714EA9F, Amt[4:0] 0x02, Left 1, Arith 0;
        EVAL;
        ASSERT Out[31:0] 0xDC53AA7C;
        SET A[31:0] 0x269AE77A, Amt[4:0] 0x03, Left 1, Arith 0;
        EVAL;
        ASSERT Out[31:0] 0x34D73BD0;
        SET A[31:0] 0x636A5A20, Amt[4:0] 0x04, Left 0, Arith 0;
        EVAL;
        ASSERT Out[31:0] 0x0636A5A2;
        SET A[31:0] 0x00000075, Amt[4:0] 0x05, Left 1, Arith 0;
        EVAL;
        ASSERT Out[31:0] 0x00000EA0;
        SET A[31:0] 0xED840060, Amt[4:0] 0x06, Left 0, Arith 0;
        EVAL;
        ASSERT Out[31:0] 0x03B61001;
        SET A[31:0] 0x28F3B8A5, Amt[4:0] 0x07, Left 0, Arith 1;
        EVAL;
        ASSERT Out[31:0] 0x0051E771;
        SET A[31:0] 0xB51C0B4C, Amt[4:0] 0x08, Left 1, Arith 1;
        EVAL;
        ASSERT Out[31:0] 0x1C0B4CFF;
        SET A[31:0] 0x000000E6, Amt[4:0] 0x09, Left 1, Arith 0;
        EVAL;
        ASSERT Out[31:0] 0x0001CC00;
    }

    TEST "vectors 10..19" {
        SET A[31:0] 0xC73A8DCB, Amt[4:0] 0x0A, Left 1, Arith 1;
        EVAL;
        ASSERT Out[31:0] 0xEA372FFF;
        SET A[31:0] 0x21DAD9F0, Amt[4:0] 0x0B, Left 1, Arith 1;
        EVAL;
        ASSERT Out[31:0] 0xD6CF8000;
        SET A[31:0] 0x00000000, Amt[4:0] 0x0C, Left 1, Arith 0;
        EVAL;
        ASSERT Out[31:0] 0x00000000;
        SET A[31:0] 0xFFFFFF09, Amt[4:0] 0x0D, Left 1, Arith 0;
        EVAL;
        ASSERT Out[31:0] 0xFFE12000;
        SET A[31:0] 0x948B4723, Amt[4:0] 0x0E, Left 0, Arith 1;
        EVAL;
        ASSERT Out[31:0] 0xFFFE522D;
        SET A[31:0] 0x03CDAE55, Amt[4:0] 0x0F, Left 0, Arith 1;
        EVAL;
        ASSERT Out[31:0] 0x0000079B;
        SET A[31:0] 0x92CF3F37, Amt[4:0] 0x10, Left 0, Arith 0;
        EVAL;
        ASSERT Out[31:0] 0x000092CF;
        SET A[31:0] 0x49C1E3A3, Amt[4:0] 0x11, Left 1, Arith 0;
        EVAL;
        ASSERT Out[31:0] 0xC7460000;
        SET A[31:0] 0xFFFFFFCC, Amt[4:0] 0x12, Left 0, Arith 1;
        EVAL;
        ASSERT Out[31:0] 0xFFFFFFFF;
        SET A[31:0] 0x791466B0, Amt[4:0] 0x13, Left 0, Arith 1;
        EVAL;
        ASSERT Out[31:0] 0x00000F22;
    }

    TEST "vectors 20..29" {
        SET A[31:0] 0x8217C8C4, Amt[4:0] 0x14, Left 0, Arith 1;
        EVAL;
        ASSERT Out[31:0] 0xFFFFF821;
        SET A[31:0] 0x619AA36C, Amt[4:0] 0x15, Left 0, Arith 0;
        EVAL;
        ASSERT Out[31:0] 0x0000030C;
        SET A[31:0] 0xD65A9A7E, Amt[4:0] 0x16, Left 0, Arith 1;
        EVAL;
        ASSERT Out[31:0] 0xFFFFFF59;
        SET A[31:0] 0xC8EFE93E, Amt[4:0] 0x17, Left 1, Arith 0;
        EVAL;
        ASSERT Out[31:0] 0x9F000000;
        SET A[31:0] 0xFFFFFFC4, Amt[4:0] 0x18, Left 1, Arith 1;
        EVAL;
        ASSERT Out[31:0] 0xC4FFFFFF;
        SET A[31:0] 0xA63EF4CD, Amt[4:0] 0x19, Left 0, Arith 0;
        EVAL;
        ASSERT Out[31:0] 0x00000053;
        SET A[31:0] 0xFAF99576, Amt[4:0] 0x1A, Left 0, Arith 0;
        EVAL;
        ASSERT Out[31:0] 0x0000003E;
        SET A[31:0] 0xCD461E42, Amt[4:0] 0x1B, Left 1, Arith 1;
        EVAL;
        ASSERT Out[31:0] 0x17FFFFFF;
        SET A[31:0] 0x00000020, Amt[4:0] 0x1C, Left 1, Arith 1;
        EVAL;
        ASSERT Out[31:0] 0x00000000;
        SET A[31:0] 0x00000001, Amt[4:0] 0x1D, Left 1, Arith 1;
        EVAL;
        ASSERT Out[31:0] 0x20000000;
    }

    TEST "vectors 30..39" {
        SET A[31:0] 0xCBD803F6, Amt[4:0] 0x1E, Left 0, Arith 0;
        EVAL;
        ASSERT Out[31:0] 0x00000003;
        SET A[31:0] 0x28B83E6B, Amt[4:0] 0x1F, Left 0, Arith 0;
        EVAL;
        ASSERT Out[31:0] 0x00000000;
        SET A[31:0] 0xC032AD2B, Amt[4:0] 0x08, Left 0, Arith 0;
        EVAL;
        ASSERT Out[31:0] 0x00C032AD;
        SET A[31:0] 0x5CDF0BC2, Amt[4:0] 0x02, Left 1, Arith 0;
        EVAL;
        ASSERT Out[31:0] 0x737C2F08;
        SET A[31:0] 0x9D573FA7, Amt[4:0] 0x0D, Left 0, Arith 0;
        EVAL;
        ASSERT Out[31:0] 0x0004EAB9;
        SET A[31:0] 0xC9E79869, Amt[4:0] 0x1B, Left 1, Arith 1;
        EVAL;
        ASSERT Out[31:0] 0x4FFFFFFF;
        SET A[31:0] 0x80000000, Amt[4:0] 0x17, Left 0, Arith 1;
        EVAL;
        ASSERT Out[31:0] 0xFFFFFF00;
        SET A[31:0] 0x00000041, Amt[4:0] 0x13, Left 0, Arith 1;
        EVAL;
        ASSERT Out[31:0] 0x00000000;
        SET A[31:0] 0xFFFFFF6E, Amt[4:0] 0x17, Left 1, Arith 0;
        EVAL;
        ASSERT Out[31:0] 0xB7000000;
        SET A[31:0] 0x0000002B, Amt[4:0] 0x1F, Left 1, Arith 0;
        EVAL;
        ASSERT Out[31:0] 0x80000000;
    }

    TEST "vectors 40..49" {
        SET A[31:0] 0x00000020, Amt[4:0] 0x0C, Left 1, Arith 1;
        EVAL;
        ASSERT Out[31:0] 0x00020000;
        SET A[31:0] 0xFFA575F2, Amt[4:0] 0x0D, Left 1, Arith 0;
        EVAL;
        ASSERT Out[31:0] 0xAEBE4000;
        SET A[31:0] 0x80000000, Amt[4:0] 0x11, Left 1, Arith 0;
        EVAL;
        ASSERT Out[31:0] 0x00000000;
        SET A[31:0] 0xFFFFFFB2, Amt[4:0] 0x17, Left 0, Arith 0;
        EVAL;
        ASSERT Out[31:0] 0x000001FF;
        SET A[31:0] 0xE1E17A9D, Amt[4:0] 0x12, Left 0, Arith 0;
        EVAL;
        ASSERT Out[31:0] 0x00003878;
        SET A[31:0] 0x000000B6, Amt[4:0] 0x0C, Left 1, Arith 1;
        EVAL;
        ASSERT Out[31:0] 0x000B6000;
        SET A[31:0] 0xFFFFFF66, Amt[4:0] 0x16, Left 1, Arith 0;
        EVAL;
        ASSERT Out[31:0] 0xD9800000;
        SET A[31:0] 0x0000002B, Amt[4:0] 0x07, Left 1, Arith 1;
        EVAL;
        ASSERT Out[31:0] 0x00001580;
        SET A[31:0] 0x00000000, Amt[4:0] 0x0D, Left 0, Arith 1;
        EVAL;
        ASSERT Out[31:0] 0x00000000;
        SET A[31:0] 0x4A815232, Amt[4:0] 0x0A, Left 0, Arith 1;
        EVAL;
        ASSERT Out[31:0] 0x0012A054;
    }

    TEST "vectors 50..59" {
        SET A[31:0] 0x1805F875, Amt[4:0] 0x1F, Left 1, Arith 0;
        EVAL;
        ASSERT Out[31:0] 0x80000000;
        SET A[31:0] 0x80000000, Amt[4:0] 0x14, Left 0, Arith 1;
        EVAL;
        ASSERT Out[31:0] 0xFFFFF800;
        SET A[31:0] 0xE6AA35C3, Amt[4:0] 0x07, Left 0, Arith 0;
        EVAL;
        ASSERT Out[31:0] 0x01CD546B;
        SET A[31:0] 0x0DA931A0, Amt[4:0] 0x16, Left 0, Arith 0;
        EVAL;
        ASSERT Out[31:0] 0x00000036;
        SET A[31:0] 0xFFFFFF37, Amt[4:0] 0x00, Left 0, Arith 1;
        EVAL;
        ASSERT Out[31:0] 0xFFFFFF37;
        SET A[31:0] 0xAE2FB031, Amt[4:0] 0x08, Left 0, Arith 1;
        EVAL;
        ASSERT Out[31:0] 0xFFAE2FB0;
        SET A[31:0] 0x00000001, Amt[4:0] 0x12, Left 1, Arith 0;
        EVAL;
        ASSERT Out[31:0] 0x00040000;
        SET A[31:0] 0xB4933AA9, Amt[4:0] 0x0C, Left 0, Arith 1;
        EVAL;
        ASSERT Out[31:0] 0xFFFB4933;
        SET A[31:0] 0x870FBE96, Amt[4:0] 0x0C, Left 0, Arith 1;
        EVAL;
        ASSERT Out[31:0] 0xFFF870FB;
        SET A[31:0] 0xFFFFFFFF, Amt[4:0] 0x07, Left 1, Arith 0;
        EVAL;
        ASSERT Out[31:0] 0xFFFFFF80;
    }
}
