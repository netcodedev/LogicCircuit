// Tests for SHIFTER_RV32: sll, srl, sra by every kind of amount
//
// Generated by `cargo test --release --lib riscv::clt_gen -- --ignored`
// from the simulator; the circuit is checked against Rust references and the
// instruction-level simulator in src/riscv/tests.rs and cpu_tests.rs.

TESTS FOR SHIFTER_RV32 {
    TEST "vectors 0..9" {
        SET A[31:0] 0x0300D406, Amt[4:0] 0x00, Arith 0;
        EVAL;
        ASSERT Shl[31:0] 0x0300D406; ASSERT Shr[31:0] 0x0300D406;
        SET A[31:0] 0x7F0502A8, Amt[4:0] 0x01, Arith 1;
        EVAL;
        ASSERT Shl[31:0] 0xFE0A0550; ASSERT Shr[31:0] 0x3F828154;
        SET A[31:0] 0x78296E9E, Amt[4:0] 0x02, Arith 1;
        EVAL;
        ASSERT Shl[31:0] 0xE0A5BA78; ASSERT Shr[31:0] 0x1E0A5BA7;
        SET A[31:0] 0xF714EA9F, Amt[4:0] 0x03, Arith 1;
        EVAL;
        ASSERT Shl[31:0] 0xB8A754F8; ASSERT Shr[31:0] 0xFEE29D53;
        SET A[31:0] 0x692A8710, Amt[4:0] 0x04, Arith 1;
        EVAL;
        ASSERT Shl[31:0] 0x92A87100; ASSERT Shr[31:0] 0x0692A871;
        SET A[31:0] 0xB74BBC73, Amt[4:0] 0x05, Arith 0;
        EVAL;
        ASSERT Shl[31:0] 0xE9778E60; ASSERT Shr[31:0] 0x05BA5DE3;
        SET A[31:0] 0x636A5A20, Amt[4:0] 0x06, Arith 0;
        EVAL;
        ASSERT Shl[31:0] 0xDA968800; ASSERT Shr[31:0] 0x018DA968;
        SET A[31:0] 0x00000001, Amt[4:0] 0x07, Arith 1;
        EVAL;
        ASSERT Shl[31:0] 0x00000080; ASSERT Shr[31:0] 0x00000000;
        SET A[31:0] 0x349DC9EF, Amt[4:0] 0x08, Arith 0;
        EVAL;
        ASSERT Shl[31:0] 0x9DC9EF00; ASSERT Shr[31:0] 0x00349DC9;
        SET A[31:0] 0xED840060, Amt[4:0] 0x09, Arith 0;
        EVAL;
        ASSERT Shl[31:0] 0x0800C000; ASSERT Shr[31:0] 0x0076C200;
    }

    TEST "vectors 10..19" {
        SET A[31:0] 0xFFFFFFB2, Amt[4:0] 0x0A, Arith 1;
        EVAL;
        ASSERT Shl[31:0] 0xFFFEC800; ASSERT Shr[31:0] 0xFFFFFFFF;
        SET A[31:0] 0x107F676F, Amt[4:0] 0x0B, Arith 1;
        EVAL;
        ASSERT Shl[31:0] 0xFB3B7800; ASSERT Shr[31:0] 0x00020FEC;
        SET A[31:0] 0xB51C0B4C, Amt[4:0] 0x0C, Arith 1;
        EVAL;
        ASSERT Shl[31:0] 0xC0B4C000; ASSERT Shr[31:0] 0xFFFB51C0;
        SET A[31:0] 0x0E24A583, Amt[4:0] 0x0D, Arith 1;
        EVAL;
        ASSERT Shl[31:0] 0x94B06000; ASSERT Shr[31:0] 0x00007125;
        SET A[31:0] 0xF24D24C6, Amt[4:0] 0x0E, Arith 0;
        EVAL;
        ASSERT Shl[31:0] 0x49318000; ASSERT Shr[31:0] 0x0003C934;
        SET A[31:0] 0xC73A8DCB, Amt[4:0] 0x0F, Arith 1;
        EVAL;
        ASSERT Shl[31:0] 0x46E58000; ASSERT Shr[31:0] 0xFFFF8E75;
        SET A[31:0] 0xDB2039BD, Amt[4:0] 0x10, Arith 1;
        EVAL;
        ASSERT Shl[31:0] 0x39BD0000; ASSERT Shr[31:0] 0xFFFFDB20;
        SET A[31:0] 0x66D6D6E9, Amt[4:0] 0x11, Arith 1;
        EVAL;
        ASSERT Shl[31:0] 0xADD20000; ASSERT Shr[31:0] 0x0000336B;
        SET A[31:0] 0x00000000, Amt[4:0] 0x12, Arith 1;
        EVAL;
        ASSERT Shl[31:0] 0x00000000; ASSERT Shr[31:0] 0x00000000;
        SET A[31:0] 0xB6BCD547, Amt[4:0] 0x13, Arith 0;
        EVAL;
        ASSERT Shl[31:0] 0xAA380000; ASSERT Shr[31:0] 0x000016D7;
    }

    TEST "vectors 20..29" {
        SET A[31:0] 0xF78F1551, Amt[4:0] 0x14, Arith 0;
        EVAL;
        ASSERT Shl[31:0] 0x55100000; ASSERT Shr[31:0] 0x00000F78;
        SET A[31:0] 0x948B4723, Amt[4:0] 0x15, Arith 0;
        EVAL;
        ASSERT Shl[31:0] 0xE4600000; ASSERT Shr[31:0] 0x000004A4;
        SET A[31:0] 0x140019A3, Amt[4:0] 0x16, Arith 1;
        EVAL;
        ASSERT Shl[31:0] 0x68C00000; ASSERT Shr[31:0] 0x00000050;
        SET A[31:0] 0x71B272B0, Amt[4:0] 0x17, Arith 1;
        EVAL;
        ASSERT Shl[31:0] 0x58000000; ASSERT Shr[31:0] 0x000000E3;
        SET A[31:0] 0x92CF3F37, Amt[4:0] 0x18, Arith 0;
        EVAL;
        ASSERT Shl[31:0] 0x37000000; ASSERT Shr[31:0] 0x00000092;
        SET A[31:0] 0x00000020, Amt[4:0] 0x19, Arith 1;
        EVAL;
        ASSERT Shl[31:0] 0x40000000; ASSERT Shr[31:0] 0x00000000;
        SET A[31:0] 0x000000CB, Amt[4:0] 0x1A, Arith 0;
        EVAL;
        ASSERT Shl[31:0] 0x2C000000; ASSERT Shr[31:0] 0x00000000;
        SET A[31:0] 0xFFFFFFCC, Amt[4:0] 0x1B, Arith 0;
        EVAL;
        ASSERT Shl[31:0] 0x60000000; ASSERT Shr[31:0] 0x0000001F;
        SET A[31:0] 0x71EBA870, Amt[4:0] 0x1C, Arith 0;
        EVAL;
        ASSERT Shl[31:0] 0x00000000; ASSERT Shr[31:0] 0x00000007;
        SET A[31:0] 0xC4DAB135, Amt[4:0] 0x1D, Arith 1;
        EVAL;
        ASSERT Shl[31:0] 0xA0000000; ASSERT Shr[31:0] 0xFFFFFFFE;
    }

    TEST "vectors 30..39" {
        SET A[31:0] 0x8217C8C4, Amt[4:0] 0x1E, Arith 0;
        EVAL;
        ASSERT Shl[31:0] 0x00000000; ASSERT Shr[31:0] 0x00000002;
        SET A[31:0] 0x000000D3, Amt[4:0] 0x1F, Arith 1;
        EVAL;
        ASSERT Shl[31:0] 0x80000000; ASSERT Shr[31:0] 0x00000000;
        SET A[31:0] 0xB7FCFC1C, Amt[4:0] 0x04, Arith 1;
        EVAL;
        ASSERT Shl[31:0] 0x7FCFC1C0; ASSERT Shr[31:0] 0xFB7FCFC1;
        SET A[31:0] 0xA8BF8478, Amt[4:0] 0x03, Arith 1;
        EVAL;
        ASSERT Shl[31:0] 0x45FC23C0; ASSERT Shr[31:0] 0xF517F08F;
        SET A[31:0] 0x000000E1, Amt[4:0] 0x1A, Arith 0;
        EVAL;
        ASSERT Shl[31:0] 0x84000000; ASSERT Shr[31:0] 0x00000000;
        SET A[31:0] 0x30025645, Amt[4:0] 0x0B, Arith 1;
        EVAL;
        ASSERT Shl[31:0] 0x12B22800; ASSERT Shr[31:0] 0x0006004A;
        SET A[31:0] 0xB03B4F9E, Amt[4:0] 0x14, Arith 0;
        EVAL;
        ASSERT Shl[31:0] 0xF9E00000; ASSERT Shr[31:0] 0x00000B03;
        SET A[31:0] 0xFFFFFFC9, Amt[4:0] 0x1C, Arith 1;
        EVAL;
        ASSERT Shl[31:0] 0x90000000; ASSERT Shr[31:0] 0xFFFFFFFF;
        SET A[31:0] 0x47424C0E, Amt[4:0] 0x13, Arith 0;
        EVAL;
        ASSERT Shl[31:0] 0x60700000; ASSERT Shr[31:0] 0x000008E8;
        SET A[31:0] 0x0000007C, Amt[4:0] 0x09, Arith 0;
        EVAL;
        ASSERT Shl[31:0] 0x0000F800; ASSERT Shr[31:0] 0x00000000;
    }

    TEST "vectors 40..49" {
        SET A[31:0] 0x2506CF9E, Amt[4:0] 0x01, Arith 1;
        EVAL;
        ASSERT Shl[31:0] 0x4A0D9F3C; ASSERT Shr[31:0] 0x128367CF;
        SET A[31:0] 0x3130C81C, Amt[4:0] 0x18, Arith 1;
        EVAL;
        ASSERT Shl[31:0] 0x1C000000; ASSERT Shr[31:0] 0x00000031;
        SET A[31:0] 0xFFFFFF78, Amt[4:0] 0x1A, Arith 1;
        EVAL;
        ASSERT Shl[31:0] 0xE0000000; ASSERT Shr[31:0] 0xFFFFFFFF;
        SET A[31:0] 0x80000000, Amt[4:0] 0x0A, Arith 0;
        EVAL;
        ASSERT Shl[31:0] 0x00000000; ASSERT Shr[31:0] 0x00200000;
        SET A[31:0] 0x5CDF0BC2, Amt[4:0] 0x02, Arith 1;
        EVAL;
        ASSERT Shl[31:0] 0x737C2F08; ASSERT Shr[31:0] 0x1737C2F0;
        SET A[31:0] 0x583A8806, Amt[4:0] 0x0C, Arith 1;
        EVAL;
        ASSERT Shl[31:0] 0xA8806000; ASSERT Shr[31:0] 0x000583A8;
        SET A[31:0] 0x5EC26AF6, Amt[4:0] 0x06, Arith 0;
        EVAL;
        ASSERT Shl[31:0] 0xB09ABD80; ASSERT Shr[31:0] 0x017B09AB;
        SET A[31:0] 0xF972E300, Amt[4:0] 0x1B, Arith 1;
        EVAL;
        ASSERT Shl[31:0] 0x00000000; ASSERT Shr[31:0] 0xFFFFFFFF;
        SET A[31:0] 0x80000000, Amt[4:0] 0x17, Arith 0;
        EVAL;
        ASSERT Shl[31:0] 0x00000000; ASSERT Shr[31:0] 0x00000100;
        SET A[31:0] 0x72EDDC87, Amt[4:0] 0x11, Arith 1;
        EVAL;
        ASSERT Shl[31:0] 0xB90E0000; ASSERT Shr[31:0] 0x00003976;
    }

    TEST "vectors 50..59" {
        SET A[31:0] 0x0000001F, Amt[4:0] 0x1F, Arith 0;
        EVAL;
        ASSERT Shl[31:0] 0x80000000; ASSERT Shr[31:0] 0x00000000;
        SET A[31:0] 0xE148A6D3, Amt[4:0] 0x19, Arith 0;
        EVAL;
        ASSERT Shl[31:0] 0xA6000000; ASSERT Shr[31:0] 0x00000070;
        SET A[31:0] 0x0000002B, Amt[4:0] 0x1F, Arith 1;
        EVAL;
        ASSERT Shl[31:0] 0x80000000; ASSERT Shr[31:0] 0x00000000;
        SET A[31:0] 0x7FFFFFFF, Amt[4:0] 0x08, Arith 0;
        EVAL;
        ASSERT Shl[31:0] 0xFFFFFF00; ASSERT Shr[31:0] 0x007FFFFF;
        SET A[31:0] 0x5DB03834, Amt[4:0] 0x15, Arith 0;
        EVAL;
        ASSERT Shl[31:0] 0x06800000; ASSERT Shr[31:0] 0x000002ED;
        SET A[31:0] 0x28B8A41A, Amt[4:0] 0x1B, Arith 0;
        EVAL;
        ASSERT Shl[31:0] 0xD0000000; ASSERT Shr[31:0] 0x00000005;
        SET A[31:0] 0x80000000, Amt[4:0] 0x11, Arith 1;
        EVAL;
        ASSERT Shl[31:0] 0x00000000; ASSERT Shr[31:0] 0xFFFFC000;
        SET A[31:0] 0x28B0CDA7, Amt[4:0] 0x0A, Arith 1;
        EVAL;
        ASSERT Shl[31:0] 0xC3369C00; ASSERT Shr[31:0] 0x000A2C33;
        SET A[31:0] 0xFFFFFF1F, Amt[4:0] 0x08, Arith 0;
        EVAL;
        ASSERT Shl[31:0] 0xFFFF1F00; ASSERT Shr[31:0] 0x00FFFFFF;
        SET A[31:0] 0xFFFFFF11, Amt[4:0] 0x0C, Arith 0;
        EVAL;
        ASSERT Shl[31:0] 0xFFF11000; ASSERT Shr[31:0] 0x000FFFFF;
    }
}
