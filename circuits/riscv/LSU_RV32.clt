        SET Rs2[31:0] 0x00CB9716, Word[31:0] 0x80000000, Size[1:0] 0x0, Unsigned 0, Addr[1:0] 0x0;
        EVAL;
        ASSERT StoreData[31:0] 0x16161616; ASSERT ByteEn[3:0] 0x1; ASSERT LoadData[31:0] 0x00000000;
        SET Rs2[31:0] 0x7756A041, Word[31:0] 0xFFFFFFB2, Size[1:0] 0x1, Unsigned 0, Addr[1:0] 0x0;
        EVAL;
        ASSERT StoreData[31:0] 0xA041A041; ASSERT ByteEn[3:0] 0x3; ASSERT LoadData[31:0] 0xFFFFFFB2;
    }

    TEST "vectors 50..59" {
