// Tests for LSU_RV32: every size, signedness and address offset
//
// Generated by `cargo test --release --lib riscv::clt_gen -- --ignored`
// from the simulator; the circuit is checked against Rust references and the
// instruction-level simulator in src/riscv/tests.rs and cpu_tests.rs.

TESTS FOR LSU_RV32 {
    TEST "vectors 0..9" {
        SET Rs2[31:0] 0x0301D60E, Word[31:0] 0x0000001F, Size[1:0] 0x0, Unsigned 0, Addr[1:0] 0x0;
        EVAL;
        ASSERT StoreData[31:0] 0x0E0E0E0E; ASSERT ByteEn[3:0] 0x1; ASSERT LoadData[31:0] 0x0000001F;
        SET Rs2[31:0] 0x6DB0A8B4, Word[31:0] 0x87524F74, Size[1:0] 0x1, Unsigned 0, Addr[1:0] 0x0;
        EVAL;
        ASSERT StoreData[31:0] 0xA8B4A8B4; ASSERT ByteEn[3:0] 0x3; ASSERT LoadData[31:0] 0x00004F74;
        SET Rs2[31:0] 0xFFFFFFD5, Word[31:0] 0x3448E7F2, Size[1:0] 0x2, Unsigned 0, Addr[1:0] 0x0;
        EVAL;
        ASSERT StoreData[31:0] 0xFFFFFFD5; ASSERT ByteEn[3:0] 0xF; ASSERT LoadData[31:0] 0x3448E7F2;
        SET Rs2[31:0] 0x7E6AE7F0, Word[31:0] 0x2B529EAD, Size[1:0] 0x0, Unsigned 1, Addr[1:0] 0x0;
        EVAL;
        ASSERT StoreData[31:0] 0xF0F0F0F0; ASSERT ByteEn[3:0] 0x1; ASSERT LoadData[31:0] 0x000000AD;
        SET Rs2[31:0] 0x8FCACB36, Word[31:0] 0x668791F5, Size[1:0] 0x1, Unsigned 1, Addr[1:0] 0x0;
        EVAL;
        ASSERT StoreData[31:0] 0xCB36CB36; ASSERT ByteEn[3:0] 0x3; ASSERT LoadData[31:0] 0x000091F5;
        SET Rs2[31:0] 0x4B089B62, Word[31:0] 0x95CD898A, Size[1:0] 0x2, Unsigned 1, Addr[1:0] 0x0;
        EVAL;
        ASSERT StoreData[31:0] 0x4B089B62; ASSERT ByteEn[3:0] 0xF; ASSERT LoadData[31:0] 0x95CD898A;
        SET Rs2[31:0] 0x1E23D5E1, Word[31:0] 0x00000089, Size[1:0] 0x0, Unsigned 0, Addr[1:0] 0x1;
        EVAL;
        ASSERT StoreData[31:0] 0xE1E1E1E1; ASSERT ByteEn[3:0] 0x2; ASSERT LoadData[31:0] 0x00000000;
        SET Rs2[31:0] 0xFFFFFF38, Word[31:0] 0xF40C9534, Size[1:0] 0x1, Unsigned 0, Addr[1:0] 0x1;
        EVAL;
        ASSERT StoreData[31:0] 0xFF38FF38; ASSERT ByteEn[3:0] 0x3; ASSERT LoadData[31:0] 0xFFFF9595;
        SET Rs2[31:0] 0x24E9F75F, Word[31:0] 0x66FEC23C, Size[1:0] 0x2, Unsigned 0, Addr[1:0] 0x1;
        EVAL;
        ASSERT StoreData[31:0] 0x24E9F75F; ASSERT ByteEn[3:0] 0xF; ASSERT LoadData[31:0] 0x66FEC2C2;
        SET Rs2[31:0] 0xA9E9C1F8, Word[31:0] 0x25E1971C, Size[1:0] 0x0, Unsigned 1, Addr[1:0] 0x1;
        EVAL;
        ASSERT StoreData[31:0] 0xF8F8F8F8; ASSERT ByteEn[3:0] 0x2; ASSERT LoadData[31:0] 0x00000097;
    }

    TEST "vectors 10..19" {
        SET Rs2[31:0] 0x4BE36DB9, Word[31:0] 0xF61A93BF, Size[1:0] 0x1, Unsigned 1, Addr[1:0] 0x1;
        EVAL;
        ASSERT StoreData[31:0] 0x6DB96DB9; ASSERT ByteEn[3:0] 0x3; ASSERT LoadData[31:0] 0x00009393;
        SET Rs2[31:0] 0x99BA9DB3, Word[31:0] 0xE31A34D9, Size[1:0] 0x2, Unsigned 1, Addr[1:0] 0x1;
        EVAL;
        ASSERT StoreData[31:0] 0x99BA9DB3; ASSERT ByteEn[3:0] 0xF; ASSERT LoadData[31:0] 0xE31A3434;
        SET Rs2[31:0] 0xDD685ACF, Word[31:0] 0xE6FB66AD, Size[1:0] 0x0, Unsigned 0, Addr[1:0] 0x2;
        EVAL;
        ASSERT StoreData[31:0] 0xCFCFCFCF; ASSERT ByteEn[3:0] 0x4; ASSERT LoadData[31:0] 0xFFFFFFFB;
        SET Rs2[31:0] 0x7637996E, Word[31:0] 0x40D7B499, Size[1:0] 0x1, Unsigned 0, Addr[1:0] 0x2;
        EVAL;
        ASSERT StoreData[31:0] 0x996E996E; ASSERT ByteEn[3:0] 0xC; ASSERT LoadData[31:0] 0x000040D7;
        SET Rs2[31:0] 0x790491FE, Word[31:0] 0xE86F7D89, Size[1:0] 0x2, Unsigned 0, Addr[1:0] 0x2;
        EVAL;
        ASSERT StoreData[31:0] 0x790491FE; ASSERT ByteEn[3:0] 0xF; ASSERT LoadData[31:0] 0xE86FE86F;
        SET Rs2[31:0] 0x2BD8616A, Word[31:0] 0xFFFFFFA6, Size[1:0] 0x0, Unsigned 1, Addr[1:0] 0x2;
        EVAL;
        ASSERT StoreData[31:0] 0x6A6A6A6A; ASSERT ByteEn[3:0] 0x4; ASSERT LoadData[31:0] 0x000000FF;
        SET Rs2[31:0] 0xB0172E21, Word[31:0] 0xFFFFFF20, Size[1:0] 0x1, Unsigned 1, Addr[1:0] 0x2;
        EVAL;
        ASSERT StoreData[31:0] 0x2E212E21; ASSERT ByteEn[3:0] 0xC; ASSERT LoadData[31:0] 0x0000FFFF;
        SET Rs2[31:0] 0x6E7FFD50, Word[31:0] 0xE51B56BE, Size[1:0] 0x2, Unsigned 1, Addr[1:0] 0x2;
        EVAL;
        ASSERT StoreData[31:0] 0x6E7FFD50; ASSERT ByteEn[3:0] 0xF; ASSERT LoadData[31:0] 0xE51BE51B;
        SET Rs2[31:0] 0xFFFFFFFF, Word[31:0] 0x22EE3A71, Size[1:0] 0x0, Unsigned 0, Addr[1:0] 0x3;
        EVAL;
        ASSERT StoreData[31:0] 0xFFFFFFFF; ASSERT ByteEn[3:0] 0x8; ASSERT LoadData[31:0] 0x00000022;
        SET Rs2[31:0] 0x40BFC194, Word[31:0] 0x53E96C54, Size[1:0] 0x1, Unsigned 0, Addr[1:0] 0x3;
        EVAL;
        ASSERT StoreData[31:0] 0xC194C194; ASSERT ByteEn[3:0] 0xC; ASSERT LoadData[31:0] 0x00005353;
    }

    TEST "vectors 20..29" {
        SET Rs2[31:0] 0x0000001D, Word[31:0] 0xFFFFFF6F, Size[1:0] 0x2, Unsigned 0, Addr[1:0] 0x3;
        EVAL;
        ASSERT StoreData[31:0] 0x0000001D; ASSERT ByteEn[3:0] 0xF; ASSERT LoadData[31:0] 0xFFFFFFFF;
        SET Rs2[31:0] 0x000000BE, Word[31:0] 0xD8CF92D5, Size[1:0] 0x0, Unsigned 1, Addr[1:0] 0x3;
        EVAL;
        ASSERT StoreData[31:0] 0xBEBEBEBE; ASSERT ByteEn[3:0] 0x8; ASSERT LoadData[31:0] 0x000000D8;
        SET Rs2[31:0] 0x945F5539, Word[31:0] 0xFFFFFF63, Size[1:0] 0x1, Unsigned 1, Addr[1:0] 0x3;
        EVAL;
        ASSERT StoreData[31:0] 0x55395539; ASSERT ByteEn[3:0] 0xC; ASSERT LoadData[31:0] 0x0000FFFF;
        SET Rs2[31:0] 0x7FFFFFFF, Word[31:0] 0x4E73B539, Size[1:0] 0x2, Unsigned 1, Addr[1:0] 0x3;
        EVAL;
        ASSERT StoreData[31:0] 0x7FFFFFFF; ASSERT ByteEn[3:0] 0xF; ASSERT LoadData[31:0] 0x4E734E4E;
        SET Rs2[31:0] 0x31BD50F0, Word[31:0] 0x000000F0, Size[1:0] 0x0, Unsigned 0, Addr[1:0] 0x0;
        EVAL;
        ASSERT StoreData[31:0] 0xF0F0F0F0; ASSERT ByteEn[3:0] 0x1; ASSERT LoadData[31:0] 0xFFFFFFF0;
        SET Rs2[31:0] 0x00000097, Word[31:0] 0x0D0E3531, Size[1:0] 0x1, Unsigned 0, Addr[1:0] 0x0;
        EVAL;
        ASSERT StoreData[31:0] 0x00970097; ASSERT ByteEn[3:0] 0x3; ASSERT LoadData[31:0] 0x00003531;
        SET Rs2[31:0] 0x027333F8, Word[31:0] 0x5FF85A00, Size[1:0] 0x2, Unsigned 0, Addr[1:0] 0x0;
        EVAL;
        ASSERT StoreData[31:0] 0x027333F8; ASSERT ByteEn[3:0] 0xF; ASSERT LoadData[31:0] 0x5FF85A00;
        SET Rs2[31:0] 0x00000000, Word[31:0] 0x00000000, Size[1:0] 0x0, Unsigned 1, Addr[1:0] 0x0;
        EVAL;
        ASSERT StoreData[31:0] 0x00000000; ASSERT ByteEn[3:0] 0x1; ASSERT LoadData[31:0] 0x00000000;
        SET Rs2[31:0] 0x0000001F, Word[31:0] 0xC27926F9, Size[1:0] 0x1, Unsigned 1, Addr[1:0] 0x0;
        EVAL;
        ASSERT StoreData[31:0] 0x001F001F; ASSERT ByteEn[3:0] 0x3; ASSERT LoadData[31:0] 0x000026F9;
        SET Rs2[31:0] 0x8A197EEF, Word[31:0] 0x91E9DA29, Size[1:0] 0x2, Unsigned 1, Addr[1:0] 0x0;
        EVAL;
        ASSERT StoreData[31:0] 0x8A197EEF; ASSERT ByteEn[3:0] 0xF; ASSERT LoadData[31:0] 0x91E9DA29;
    }

    TEST "vectors 30..39" {
        SET Rs2[31:0] 0xFFFFFF9A, Word[31:0] 0x3D4C2FF3, Size[1:0] 0x0, Unsigned 0, Addr[1:0] 0x1;
        EVAL;
        ASSERT StoreData[31:0] 0x9A9A9A9A; ASSERT ByteEn[3:0] 0x2; ASSERT LoadData[31:0] 0x0000002F;
        SET Rs2[31:0] 0x8E7AF3D0, Word[31:0] 0x49BFEE83, Size[1:0] 0x1, Unsigned 0, Addr[1:0] 0x1;
        EVAL;
        ASSERT StoreData[31:0] 0xF3D0F3D0; ASSERT ByteEn[3:0] 0x3; ASSERT LoadData[31:0] 0xFFFFEEEE;
        SET Rs2[31:0] 0x966BEC3A, Word[31:0] 0x3765D879, Size[1:0] 0x2, Unsigned 0, Addr[1:0] 0x1;
        EVAL;
        ASSERT StoreData[31:0] 0x966BEC3A; ASSERT ByteEn[3:0] 0xF; ASSERT LoadData[31:0] 0x3765D8D8;
        SET Rs2[31:0] 0x30B250F8, Word[31:0] 0x4E155CD0, Size[1:0] 0x0, Unsigned 1, Addr[1:0] 0x1;
        EVAL;
        ASSERT StoreData[31:0] 0xF8F8F8F8; ASSERT ByteEn[3:0] 0x2; ASSERT LoadData[31:0] 0x0000005C;
