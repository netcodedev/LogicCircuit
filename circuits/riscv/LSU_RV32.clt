        EVAL;
        ASSERT StoreData[31:0] 0xFFA9FFA9; ASSERT ByteEn[3:0] 0x3; ASSERT LoadData[31:0] 0x0000D2D2;
        SET Rs2[31:0] 0xD27C870C, Word[31:0] 0x0000003C, Size[1:0] 0x2, Unsigned 1, Addr[1:0] 0x1;
        EVAL;
        ASSERT StoreData[31:0] 0xD27C870C; ASSERT ByteEn[3:0] 0xF; ASSERT LoadData[31:0] 0x00000000;
        SET Rs2[31:0] 0x000000DC, Word[31:0] 0x00000061, Size[1:0] 0x0, Unsigned 0, Addr[1:0] 0x2;
        EVAL;
        ASSERT StoreData[31:0] 0xDCDCDCDC; ASSERT ByteEn[3:0] 0x4; ASSERT LoadData[31:0] 0x00000000;
