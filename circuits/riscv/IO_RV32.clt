        ASSERT Sel 1; ASSERT RData[31:0] 0x00000000; ASSERT GpioOut[31:0] 0x0000A600; ASSERT Display[31:0] 0x2FA80000; ASSERT Tx 1; ASSERT MTIP 1; ASSERT MEIP 0;
        SEQ CLK 0 -> CLK 1 -> CLK 0;
        ASSERT Sel 1; ASSERT RData[31:0] 0x00000000; ASSERT GpioOut[31:0] 0x0000A600; ASSERT Display[31:0] 0x2FA80000; ASSERT Tx 1; ASSERT MTIP 1; ASSERT MEIP 0;
        SET Addr[31:0] 0x10000014, WData[31:0] 0x44BDE960, ByteEn[3:0] 0x4, Write 1, DataRead 0, GpioIn[31:0] 0x19B466CD, Rx 1;
        EVAL;
        ASSERT Sel 1; ASSERT RData[31:0] 0x00000000; ASSERT GpioOut[31:0] 0x0000A600; ASSERT Display[31:0] 0x2FA80000; ASSERT Tx 1; ASSERT MTIP 1; ASSERT MEIP 0;
        SEQ CLK 0 -> CLK 1 -> CLK 0;
        ASSERT Sel 1; ASSERT RData[31:0] 0x00000000; ASSERT GpioOut[31:0] 0x0000A600; ASSERT Display[31:0] 0x2FA80000; ASSERT Tx 1; ASSERT MTIP 1; ASSERT MEIP 0;
        SET Addr[31:0] 0x10000018, WData[31:0] 0x00000003, ByteEn[3:0] 0x8, Write 1, DataRead 0, GpioIn[31:0] 0xDE123146, Rx 1;
        EVAL;
        ASSERT Sel 1; ASSERT RData[31:0] 0x00000000; ASSERT GpioOut[31:0] 0x0000A600; ASSERT Display[31:0] 0x2FA80000; ASSERT Tx 1; ASSERT MTIP 1; ASSERT MEIP 0;
        SEQ CLK 0 -> CLK 1 -> CLK 0;
        ASSERT Sel 1; ASSERT RData[31:0] 0x00000000; ASSERT GpioOut[31:0] 0x0000A600; ASSERT Display[31:0] 0x2FA80000; ASSERT Tx 1; ASSERT MTIP 1; ASSERT MEIP 0;
        SET Addr[31:0] 0x10000068, WData[31:0] 0x0000003E, ByteEn[3:0] 0x3, Write 0, DataRead 0, GpioIn[31:0] 0x46967E60, Rx 1;
        EVAL;
        ASSERT Sel 1; ASSERT RData[31:0] 0x00000000; ASSERT GpioOut[31:0] 0x0000A600; ASSERT Display[31:0] 0x2FA80000; ASSERT Tx 1; ASSERT MTIP 1; ASSERT MEIP 0;
        SEQ CLK 0 -> CLK 1 -> CLK 0;
        ASSERT Sel 1; ASSERT RData[31:0] 0x00000000; ASSERT GpioOut[31:0] 0x0000A600; ASSERT Display[31:0] 0x2FA80000; ASSERT Tx 1; ASSERT MTIP 1; ASSERT MEIP 0;
        SET Addr[31:0] 0x10000048, WData[31:0] 0xFFFFFF09, ByteEn[3:0] 0x8, Write 0, DataRead 1, GpioIn[31:0] 0xFFFFFF82, Rx 1;
        EVAL;
        ASSERT Sel 1; ASSERT RData[31:0] 0x2FA80000; ASSERT GpioOut[31:0] 0x0000A600; ASSERT Display[31:0] 0x2FA80000; ASSERT Tx 1; ASSERT MTIP 1; ASSERT MEIP 0;
        SEQ CLK 0 -> CLK 1 -> CLK 0;
        ASSERT Sel 1; ASSERT RData[31:0] 0x2FA80000; ASSERT GpioOut[31:0] 0x0000A600; ASSERT Display[31:0] 0x2FA80000; ASSERT Tx 1; ASSERT MTIP 1; ASSERT MEIP 0;
        SET Addr[31:0] 0x1000005C, WData[31:0] 0x00000043, ByteEn[3:0] 0xC, Write 1, DataRead 0, GpioIn[31:0] 0xFFFFFFFF, Rx 1;
        EVAL;
        ASSERT Sel 1; ASSERT RData[31:0] 0x00000000; ASSERT GpioOut[31:0] 0x0000A600; ASSERT Display[31:0] 0x2FA80000; ASSERT Tx 1; ASSERT MTIP 1; ASSERT MEIP 0;
        SEQ CLK 0 -> CLK 1 -> CLK 0;
        ASSERT Sel 1; ASSERT RData[31:0] 0x00000000; ASSERT GpioOut[31:0] 0x0000A600; ASSERT Display[31:0] 0x2FA80000; ASSERT Tx 1; ASSERT MTIP 1; ASSERT MEIP 0;
    }

    TEST "not the I/O region" {
        SET Addr[31:0] 0x00000008, Write 1, WData[31:0] 0x12345678, ByteEn[3:0] 0xF, DataRead 0;
        EVAL;
        ASSERT Sel 0; ASSERT RData[31:0] 0x2FA80000; ASSERT GpioOut[31:0] 0x0000A600; ASSERT Display[31:0] 0x2FA80000; ASSERT Tx 1; ASSERT MTIP 1; ASSERT MEIP 0;
        SEQ CLK 0 -> CLK 1 -> CLK 0;
        SET Addr[31:0] 0x20000008, Write 0;
        EVAL;
        ASSERT Sel 0; ASSERT RData[31:0] 0x2FA80000; ASSERT GpioOut[31:0] 0x0000A600; ASSERT Display[31:0] 0x2FA80000; ASSERT Tx 1; ASSERT MTIP 1; ASSERT MEIP 0;
    }
}
