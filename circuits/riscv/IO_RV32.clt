        EVAL;
        ASSERT Sel 1; ASSERT RData[31:0] 0x00000000; ASSERT GpioOut[31:0] 0x00000000; ASSERT Display[31:0] 0x00000000; ASSERT Tx 1; ASSERT MTIP 1; ASSERT MEIP 0;
