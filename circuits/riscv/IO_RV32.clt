// Tests for IO_RV32: GPIO, display, UART registers and line, mtime/mtimecmp, byte lanes
//
// Generated by `cargo test --release --lib riscv::clt_gen -- --ignored`
// from the simulator; the circuit is checked against Rust references and the
// instruction-level simulator in src/riscv/tests.rs and cpu_tests.rs.

TESTS FOR IO_RV32 {
    TEST "reset" {
        SET Reset 1, Rx 1;
        SEQ CLK 0 -> CLK 1 -> CLK 0;
        SET Reset 0;
        EVAL;
        ASSERT Sel 0; ASSERT RData[31:0] 0x00000000; ASSERT GpioOut[31:0] 0x00000000; ASSERT Display[31:0] 0x00000000; ASSERT Tx 1; ASSERT MTIP 1; ASSERT MEIP 0;
    }

    TEST "random accesses 0" {
