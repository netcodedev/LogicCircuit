// Tests for ALU_RV32: every function, with edge-case operands
//
// Generated by `cargo test --release --lib riscv::clt_gen -- --ignored`
// from the simulator; the circuit is checked against Rust references and the
// instruction-level simulator in src/riscv/tests.rs and cpu_tests.rs.

TESTS FOR ALU_RV32 {
    TEST "vectors 0..9" {
        SET A[31:0] 0x0301D60E, B[31:0] 0x0000001F, F[2:0] 0x0, Sub 0, Arith 0;
        EVAL;
        ASSERT Result[31:0] 0x0301D62D; ASSERT Eq 0; ASSERT Lt 0; ASSERT Ltu 1;
        SET A[31:0] 0x6DB0A8B4, B[31:0] 0x87524F74, F[2:0] 0x1, Sub 0, Arith 0;
        EVAL;
        ASSERT Result[31:0] 0x8B400000; ASSERT Eq 0; ASSERT Lt 0; ASSERT Ltu 1;
        SET A[31:0] 0xFFFFFFD5, B[31:0] 0x3448E7F2, F[2:0] 0x2, Sub 0, Arith 0;
        EVAL;
        ASSERT Result[31:0] 0x00000001; ASSERT Eq 0; ASSERT Lt 1; ASSERT Ltu 0;
        SET A[31:0] 0x7E6AE7F0, B[31:0] 0x2B529EAD, F[2:0] 0x3, Sub 0, Arith 0;
        EVAL;
        ASSERT Result[31:0] 0x00000001; ASSERT Eq 0; ASSERT Lt 1; ASSERT Ltu 1;
        SET A[31:0] 0x8FCACB36, B[31:0] 0x668791F5, F[2:0] 0x4, Sub 0, Arith 0;
        EVAL;
        ASSERT Result[31:0] 0xE94D5AC3; ASSERT Eq 0; ASSERT Lt 1; ASSERT Ltu 1;
        SET A[31:0] 0x4B089B62, B[31:0] 0x95CD898A, F[2:0] 0x5, Sub 0, Arith 0;
        EVAL;
        ASSERT Result[31:0] 0x0012C226; ASSERT Eq 0; ASSERT Lt 0; ASSERT Ltu 1;
        SET A[31:0] 0x1E23D5E1, B[31:0] 0x00000089, F[2:0] 0x6, Sub 0, Arith 0;
        EVAL;
        ASSERT Result[31:0] 0x1E23D5E9; ASSERT Eq 0; ASSERT Lt 0; ASSERT Ltu 1;
        SET A[31:0] 0xFFFFFF38, B[31:0] 0xF40C9534, F[2:0] 0x7, Sub 0, Arith 0;
        EVAL;
        ASSERT Result[31:0] 0xF40C9530; ASSERT Eq 0; ASSERT Lt 1; ASSERT Ltu 0;
        SET A[31:0] 0x24E9F75F, B[31:0] 0x66FEC23C, F[2:0] 0x0, Sub 1, Arith 0;
        EVAL;
        ASSERT Result[31:0] 0xBDEB3523; ASSERT Eq 0; ASSERT Lt 1; ASSERT Ltu 1;
        SET A[31:0] 0xA9E9C1F8, B[31:0] 0x25E1971C, F[2:0] 0x1, Sub 1, Arith 0;
        EVAL;
        ASSERT Result[31:0] 0x80000000; ASSERT Eq 0; ASSERT Lt 1; ASSERT Ltu 0;
    }

