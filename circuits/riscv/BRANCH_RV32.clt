// Tests for BRANCH_RV32: every branch condition, with equal and sign-crossing operands
//
// Generated by `cargo test --release --lib riscv::clt_gen -- --ignored`
// from the simulator; the circuit is checked against Rust references and the
// instruction-level simulator in src/riscv/tests.rs and cpu_tests.rs.

TESTS FOR BRANCH_RV32 {
    TEST "vectors 0..9" {
        SET A[31:0] 0x03011788, B[31:0] 0x03011788, F[2:0] 0x0;
        EVAL;
        ASSERT Cond 1;
        SET A[31:0] 0xFFFFFF25, B[31:0] 0xFFFFFF25, F[2:0] 0x1;
        EVAL;
        ASSERT Cond 0;
        SET A[31:0] 0x60C5133C, B[31:0] 0x60C5133C, F[2:0] 0x4;
        EVAL;
        ASSERT Cond 0;
        SET A[31:0] 0x50759491, B[31:0] 0x50759491, F[2:0] 0x5;
        EVAL;
        ASSERT Cond 1;
        SET A[31:0] 0x8FE32DEA, B[31:0] 0x8FE32DEA, F[2:0] 0x6;
        EVAL;
        ASSERT Cond 0;
        SET A[31:0] 0xEFCD9F8F, B[31:0] 0xEFCD9F8F, F[2:0] 0x7;
        EVAL;
        ASSERT Cond 1;
        SET A[31:0] 0x9B461CFB, B[31:0] 0x1B461CFB, F[2:0] 0x0;
        EVAL;
        ASSERT Cond 0;
        SET A[31:0] 0x1BADEA64, B[31:0] 0x9BADEA64, F[2:0] 0x1;
        EVAL;
        ASSERT Cond 1;
        SET A[31:0] 0x8615ED92, B[31:0] 0x0615ED92, F[2:0] 0x4;
        EVAL;
        ASSERT Cond 1;
        SET A[31:0] 0x00000020, B[31:0] 0x80000020, F[2:0] 0x5;
        EVAL;
        ASSERT Cond 1;
    }

    TEST "vectors 10..19" {
        SET A[31:0] 0xE5A9C37F, B[31:0] 0x65A9C37F, F[2:0] 0x6;
        EVAL;
        ASSERT Cond 0;
        SET A[31:0] 0xC752927B, B[31:0] 0x4752927B, F[2:0] 0x7;
        EVAL;
        ASSERT Cond 1;
        SET A[31:0] 0x7A7EE79A, B[31:0] 0x13B3167F, F[2:0] 0x0;
        EVAL;
        ASSERT Cond 0;
        SET A[31:0] 0xFFFFFF95, B[31:0] 0xED1CF978, F[2:0] 0x1;
        EVAL;
        ASSERT Cond 1;
        SET A[31:0] 0xD0CA4AC2, B[31:0] 0xFFFFFFFF, F[2:0] 0x4;
        EVAL;
        ASSERT Cond 1;
        SET A[31:0] 0xBEC9FF9D, B[31:0] 0x73011976, F[2:0] 0x5;
        EVAL;
        ASSERT Cond 0;
        SET A[31:0] 0xE95605E6, B[31:0] 0x690640F5, F[2:0] 0x6;
        EVAL;
        ASSERT Cond 0;
        SET A[31:0] 0x9555703F, B[31:0] 0x00000092, F[2:0] 0x7;
        EVAL;
        ASSERT Cond 1;
        SET A[31:0] 0xDAE8E0C6, B[31:0] 0xFE05C082, F[2:0] 0x0;
        EVAL;
        ASSERT Cond 0;
        SET A[31:0] 0xFFFFFFBB, B[31:0] 0x00000001, F[2:0] 0x1;
        EVAL;
        ASSERT Cond 1;
    }

    TEST "vectors 20..29" {
        SET A[31:0] 0x3E4EAD4D, B[31:0] 0xFFFFFFBA, F[2:0] 0x4;
        EVAL;
        ASSERT Cond 0;
        SET A[31:0] 0xD4062515, B[31:0] 0xF4F985A2, F[2:0] 0x5;
        EVAL;
        ASSERT Cond 0;
        SET A[31:0] 0x67B06504, B[31:0] 0x000000B1, F[2:0] 0x6;
        EVAL;
        ASSERT Cond 0;
        SET A[31:0] 0xFFFFFF88, B[31:0] 0x580FAC99, F[2:0] 0x7;
        EVAL;
        ASSERT Cond 1;
        SET A[31:0] 0x6F5A80A2, B[31:0] 0x6F5A80A2, F[2:0] 0x0;
        EVAL;
        ASSERT Cond 1;
        SET A[31:0] 0x6A14268C, B[31:0] 0x6A14268C, F[2:0] 0x1;
        EVAL;
        ASSERT Cond 0;
        SET A[31:0] 0xD383B403, B[31:0] 0xD383B403, F[2:0] 0x4;
        EVAL;
        ASSERT Cond 0;
        SET A[31:0] 0x7FFFFFFF, B[31:0] 0x7FFFFFFF, F[2:0] 0x5;
        EVAL;
        ASSERT Cond 1;
        SET A[31:0] 0xBDD19AF6, B[31:0] 0xBDD19AF6, F[2:0] 0x6;
        EVAL;
        ASSERT Cond 0;
        SET A[31:0] 0x28C97FC3, B[31:0] 0x28C97FC3, F[2:0] 0x7;
        EVAL;
        ASSERT Cond 1;
    }

    TEST "vectors 30..39" {
        SET A[31:0] 0x69E051D7, B[31:0] 0xE9E051D7, F[2:0] 0x0;
        EVAL;
        ASSERT Cond 0;
        SET A[31:0] 0xFFFFFF99, B[31:0] 0x7FFFFF99, F[2:0] 0x1;
        EVAL;
        ASSERT Cond 1;
        SET A[31:0] 0xEA12EFA2, B[31:0] 0x6A12EFA2, F[2:0] 0x4;
        EVAL;
        ASSERT Cond 1;
        SET A[31:0] 0xFFFFFF77, B[31:0] 0x7FFFFF77, F[2:0] 0x5;
        EVAL;
        ASSERT Cond 0;
        SET A[31:0] 0x00000001, B[31:0] 0x80000001, F[2:0] 0x6;
        EVAL;
        ASSERT Cond 1;
        SET A[31:0] 0x02A12B06, B[31:0] 0x82A12B06, F[2:0] 0x7;
        EVAL;
        ASSERT Cond 0;
        SET A[31:0] 0x624ECD6A, B[31:0] 0x2F6A7387, F[2:0] 0x0;
        EVAL;
        ASSERT Cond 0;
        SET A[31:0] 0xCCDB159D, B[31:0] 0xEEB63FBD, F[2:0] 0x1;
        EVAL;
        ASSERT Cond 1;
        SET A[31:0] 0x8E083371, B[31:0] 0x64ED5F67, F[2:0] 0x4;
        EVAL;
        ASSERT Cond 1;
        SET A[31:0] 0x829C420F, B[31:0] 0x0000001F, F[2:0] 0x5;
        EVAL;
        ASSERT Cond 0;
    }

    TEST "vectors 40..49" {
        SET A[31:0] 0x4CDDAB46, B[31:0] 0x8DFCF183, F[2:0] 0x6;
        EVAL;
        ASSERT Cond 1;
        SET A[31:0] 0xCABC6C97, B[31:0] 0xFF80BDFA, F[2:0] 0x7;
        EVAL;
        ASSERT Cond 0;
        SET A[31:0] 0x18AFED3E, B[31:0] 0x27034C2E, F[2:0] 0x0;
        EVAL;
        ASSERT Cond 0;
        SET A[31:0] 0x00000001, B[31:0] 0x6B74279C, F[2:0] 0x1;
        EVAL;
        ASSERT Cond 1;
        SET A[31:0] 0x6B055C78, B[31:0] 0xB6E9A067, F[2:0] 0x4;
        EVAL;
        ASSERT Cond 0;
        SET A[31:0] 0x66C08B6A, B[31:0] 0xAF67C874, F[2:0] 0x5;
        EVAL;
        ASSERT Cond 1;
        SET A[31:0] 0x1C57DC1F, B[31:0] 0x00000000, F[2:0] 0x6;
        EVAL;
        ASSERT Cond 0;
        SET A[31:0] 0xFFFFFFFD, B[31:0] 0x5C3AC855, F[2:0] 0x7;
        EVAL;
        ASSERT Cond 1;
        SET A[31:0] 0x47CBF7AE, B[31:0] 0x47CBF7AE, F[2:0] 0x0;
        EVAL;
        ASSERT Cond 1;
        SET A[31:0] 0xFFFFFF05, B[31:0] 0xFFFFFF05, F[2:0] 0x1;
        EVAL;
        ASSERT Cond 0;
    }

    TEST "vectors 50..59" {
        SET A[31:0] 0xB6AD3B4E, B[31:0] 0xB6AD3B4E, F[2:0] 0x4;
        EVAL;
        ASSERT Cond 0;
        SET A[31:0] 0x32DEC254, B[31:0] 0x32DEC254, F[2:0] 0x5;
        EVAL;
        ASSERT Cond 1;
        SET A[31:0] 0x3B92B9F1, B[31:0] 0x3B92B9F1, F[2:0] 0x6;
        EVAL;
        ASSERT Cond 0;
        SET A[31:0] 0x48B0B468, B[31:0] 0x48B0B468, F[2:0] 0x7;
        EVAL;
        ASSERT Cond 1;
        SET A[31:0] 0x03DA51F7, B[31:0] 0x83DA51F7, F[2:0] 0x0;
        EVAL;
        ASSERT Cond 0;
        SET A[31:0] 0x3B3661EA, B[31:0] 0xBB3661EA, F[2:0] 0x1;
        EVAL;
        ASSERT Cond 1;
        SET A[31:0] 0x37CEBEDD, B[31:0] 0xB7CEBEDD, F[2:0] 0x4;
        EVAL;
        ASSERT Cond 0;
        SET A[31:0] 0x3D5A913D, B[31:0] 0xBD5A913D, F[2:0] 0x5;
        EVAL;
        ASSERT Cond 1;
        SET A[31:0] 0x0000008A, B[31:0] 0x8000008A, F[2:0] 0x6;
        EVAL;
        ASSERT Cond 1;
        SET A[31:0] 0xFDA745B5, B[31:0] 0x7DA745B5, F[2:0] 0x7;
        EVAL;
        ASSERT Cond 1;
    }

    TEST "vectors 60..69" {
        SET A[31:0] 0x33825272, B[31:0] 0x24710F31, F[2:0] 0x0;
        EVAL;
        ASSERT Cond 0;
        SET A[31:0] 0xA6F7B49B, B[31:0] 0x814B1E11, F[2:0] 0x1;
        EVAL;
        ASSERT Cond 1;
        SET A[31:0] 0x4ECB96A5, B[31:0] 0xFFFFFFFF, F[2:0] 0x4;
        EVAL;
        ASSERT Cond 0;
        SET A[31:0] 0x681CFCD1, B[31:0] 0xFFFFFFD1, F[2:0] 0x5;
        EVAL;
        ASSERT Cond 1;
        SET A[31:0] 0xDCCF659D, B[31:0] 0x2583B759, F[2:0] 0x6;
        EVAL;
        ASSERT Cond 0;
        SET A[31:0] 0x0000001F, B[31:0] 0x000000F2, F[2:0] 0x7;
        EVAL;
        ASSERT Cond 0;
        SET A[31:0] 0x0B7A78C7, B[31:0] 0xFFFFFF7E, F[2:0] 0x0;
        EVAL;
        ASSERT Cond 0;
        SET A[31:0] 0x900D8450, B[31:0] 0x000000F6, F[2:0] 0x1;
        EVAL;
        ASSERT Cond 1;
        SET A[31:0] 0xACBF931F, B[31:0] 0xFFFFFF33, F[2:0] 0x4;
        EVAL;
        ASSERT Cond 1;
        SET A[31:0] 0x80000000, B[31:0] 0xC5916D24, F[2:0] 0x5;
        EVAL;
        ASSERT Cond 0;
    }

    TEST "vectors 70..71" {
        SET A[31:0] 0xFFFFFF71, B[31:0] 0x79A7F2D7, F[2:0] 0x6;
        EVAL;
        ASSERT Cond 0;
        SET A[31:0] 0x000000E3, B[31:0] 0xC9015BE5, F[2:0] 0x7;
        EVAL;
        ASSERT Cond 0;
    }
}
