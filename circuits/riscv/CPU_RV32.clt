        SEQ CLK 0 -> CLK 1 -> CLK 0;
        SET DataIn[31:0] 0x00328293, Wait 0, MTIP 0, MEIP 0;
        EVAL;
        ASSERT Addr[31:0] 0x00000024; ASSERT PC[31:0] 0x00000024;
        SEQ CLK 0 -> CLK 1 -> CLK 0;
        SET DataIn[31:0] 0xFFF30313, Wait 0, MTIP 0, MEIP 0;
        EVAL;
        ASSERT Addr[31:0] 0x00000028; ASSERT ByteEn[3:0] 0x3; ASSERT PC[31:0] 0x00000028;
        SEQ CLK 0 -> CLK 1 -> CLK 0;
        SET DataIn[31:0] 0xFE031CE3, Wait 0, MTIP 0, MEIP 0;
        EVAL;
        ASSERT Addr[31:0] 0x0000002C; ASSERT ByteEn[3:0] 0x1; ASSERT PC[31:0] 0x0000002C;
        SEQ CLK 0 -> CLK 1 -> CLK 0;
        SET DataIn[31:0] 0x00328293, Wait 0, MTIP 0, MEIP 0;
        EVAL;
        ASSERT Addr[31:0] 0x00000024; ASSERT PC[31:0] 0x00000024;
        SEQ CLK 0 -> CLK 1 -> CLK 0;
        SET DataIn[31:0] 0x008000EF, Wait 0, MTIP 0, MEIP 0;
        EVAL;
        ASSERT Addr[31:0] 0x00000030; ASSERT ByteEn[3:0] 0x3; ASSERT PC[31:0] 0x00000030;
        SEQ CLK 0 -> CLK 1 -> CLK 0;
        SET DataIn[31:0] 0x00001417, Wait 0, MTIP 0, MEIP 0;
        EVAL;
        ASSERT Addr[31:0] 0x00000038; ASSERT ByteEn[3:0] 0x8; ASSERT PC[31:0] 0x00000038;
        SEQ CLK 0 -> CLK 1 -> CLK 0;
        SET DataIn[31:0] 0x00008067, Wait 0, MTIP 0, MEIP 0;
        EVAL;
        ASSERT Addr[31:0] 0x0000003C; ASSERT ByteEn[3:0] 0x1; ASSERT PC[31:0] 0x0000003C;
        SEQ CLK 0 -> CLK 1 -> CLK 0;
        SET DataIn[31:0] 0x00000000, Wait 0, MTIP 0, MEIP 0;
        EVAL;
        ASSERT Addr[31:0] 0x00000040; ASSERT ByteEn[3:0] 0x3; ASSERT PC[31:0] 0x00000040;
        SEQ CLK 0 -> CLK 1 -> CLK 0;
        SET DataIn[31:0] 0x00100073, Wait 0, MTIP 0, MEIP 0;
        EVAL;
        ASSERT Addr[31:0] 0x00000034; ASSERT ByteEn[3:0] 0x1; ASSERT PC[31:0] 0x00000034;
        SEQ CLK 0 -> CLK 1 -> CLK 0;
        SET DataIn[31:0] 0x00001417, Wait 0, MTIP 0, MEIP 0;
        EVAL;
        ASSERT Addr[31:0] 0x00000038; ASSERT PC[31:0] 0x00000038;
        SEQ CLK 0 -> CLK 1 -> CLK 0;
        SET DataIn[31:0] 0x00008067, Wait 0, MTIP 0, MEIP 0;
        EVAL;
        ASSERT Addr[31:0] 0x0000003C; ASSERT DataOut[31:0] 0x34343434; ASSERT PC[31:0] 0x0000003C; ASSERT Halted 1;
        ASSERT Addr[31:0] 0x0000003C; ASSERT DataOut[31:0] 0x34343434; ASSERT ByteEn[3:0] 0x1; ASSERT Write 0; ASSERT Read 0; ASSERT Fetch 1; ASSERT PC[31:0] 0x0000003C; ASSERT Halted 1;
        ASSERT RegFile.R_1.Q[31:0] 0x00000034; ASSERT RegFile.R_2.Q[31:0] 0x00000000; ASSERT RegFile.R_3.Q[31:0] 0x00000000; ASSERT RegFile.R_4.Q[31:0] 0x00000000; ASSERT RegFile.R_5.Q[31:0] 0x0000000C; ASSERT RegFile.R_6.Q[31:0] 0x00000000; ASSERT RegFile.R_7.Q[31:0] 0x00000000; ASSERT RegFile.R_8.Q[31:0] 0x00001038; ASSERT RegFile.R_9.Q[31:0] 0x00000000; ASSERT RegFile.R_10.Q[31:0] 0x12345678; ASSERT RegFile.R_11.Q[31:0] 0xFFFFFFF9; ASSERT RegFile.R_12.Q[31:0] 0x12345671; ASSERT RegFile.R_13.Q[31:0] 0x1234567F; ASSERT RegFile.R_14.Q[31:0] 0xEDCBA981; ASSERT RegFile.R_15.Q[31:0] 0xFFFFFFFF; ASSERT RegFile.R_16.Q[31:0] 0x00000000; ASSERT RegFile.R_17.Q[31:0] 0x00000000; ASSERT RegFile.R_18.Q[31:0] 0x00000000; ASSERT RegFile.R_19.Q[31:0] 0x00000000; ASSERT RegFile.R_20.Q[31:0] 0x00000000; ASSERT RegFile.R_21.Q[31:0] 0x00000000; ASSERT RegFile.R_22.Q[31:0] 0x00000000; ASSERT RegFile.R_23.Q[31:0] 0x00000000; ASSERT RegFile.R_24.Q[31:0] 0x00000000; ASSERT RegFile.R_25.Q[31:0] 0x00000000; ASSERT RegFile.R_26.Q[31:0] 0x00000000; ASSERT RegFile.R_27.Q[31:0] 0x00000000; ASSERT RegFile.R_28.Q[31:0] 0x00000000; ASSERT RegFile.R_29.Q[31:0] 0x00000000; ASSERT RegFile.R_30.Q[31:0] 0x00000000; ASSERT RegFile.R_31.Q[31:0] 0x00000000;
