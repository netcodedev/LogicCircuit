        // ebreak
        // handler:
        // csrr s0, mepc
        // csrr s1, mtval
        // addi s0, s0, 4
        // csrw mepc, s0
        // addi s2, s2, 1
        // mret
        SET Reset 1;
        SET DataIn[31:0] 0x343024F3, Wait 0, MTIP 0, MEIP 0;
        SEQ CLK 0 -> CLK 1 -> CLK 0;
        SET DataIn[31:0] 0x000002B7, Wait 0, MTIP 0, MEIP 0;
