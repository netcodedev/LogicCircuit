    TEST "multiply and divide" {
        // li a0, -1234567
        // li a1, 321
        // mul a2, a0, a1
        // mulh a3, a0, a1
        // div a4, a0, a1
        // remu a5, a0, a1
        // div a6, a0, zero
        // ebreak
        SET Reset 1;
        SET DataIn[31:0] 0x00000000, Wait 0, MTIP 0, MEIP 0;
        SEQ CLK 0 -> CLK 1 -> CLK 0;
        SET DataIn[31:0] 0xFFED3537, Wait 0, MTIP 0, MEIP 0;
        SEQ CLK 0 -> CLK 1 -> CLK 0;
        SET DataIn[31:0] 0xFFED3537, Wait 0, MTIP 0, MEIP 0;
        SEQ CLK 0 -> CLK 1 -> CLK 0;
        SET Reset 0;
        SET DataIn[31:0] 0xFFED3537, Wait 0, MTIP 0, MEIP 0;
        EVAL;
        ASSERT Addr[31:0] 0x00000000; ASSERT DataOut[31:0] 0x00000000; ASSERT ByteEn[3:0] 0x1; ASSERT Write 0; ASSERT Read 0; ASSERT Fetch 1; ASSERT PC[31:0] 0x00000000; ASSERT Halted 0;
        SEQ CLK 0 -> CLK 1 -> CLK 0;
        SET DataIn[31:0] 0x97950513, Wait 0, MTIP 0, MEIP 0;
        EVAL;
        ASSERT Addr[31:0] 0x00000004; ASSERT ByteEn[3:0] 0xF; ASSERT PC[31:0] 0x00000004;
        SEQ CLK 0 -> CLK 1 -> CLK 0;
        SET DataIn[31:0] 0x14100593, Wait 0, MTIP 0, MEIP 0;
        EVAL;
        ASSERT Addr[31:0] 0x00000008; ASSERT PC[31:0] 0x00000008;
        SEQ CLK 0 -> CLK 1 -> CLK 0;
        SET DataIn[31:0] 0x02B50633, Wait 0, MTIP 0, MEIP 0;
        EVAL;
        ASSERT Addr[31:0] 0x0000000C; ASSERT ByteEn[3:0] 0x2; ASSERT PC[31:0] 0x0000000C;
        SEQ CLK 0 -> CLK 1 -> CLK 0;
        SET DataIn[31:0] 0x02B516B3, Wait 0, MTIP 0, MEIP 0;
        EVAL;
        ASSERT Addr[31:0] 0x00000010; ASSERT DataOut[31:0] 0x34343434; ASSERT PC[31:0] 0x00000010;
        SEQ CLK 0 -> CLK 1 -> CLK 0;
        SET DataIn[31:0] 0x02B516B3, Wait 0, MTIP 0, MEIP 0;
        EVAL;
        ASSERT DataOut[31:0] 0x41414141; ASSERT ByteEn[3:0] 0x1;
        SEQ CLK 0 -> CLK 1 -> CLK 0;
        SET DataIn[31:0] 0x02B516B3, Wait 0, MTIP 0, MEIP 0;
        EVAL;
        ASSERT ByteEn[3:0] 0x2;
        SEQ CLK 0 -> CLK 1 -> CLK 0;
        SET DataIn[31:0] 0x02B516B3, Wait 0, MTIP 0, MEIP 0;
        EVAL;
        ASSERT ByteEn[3:0] 0x1;
        SEQ CLK 0 -> CLK 1 -> CLK 0;
        SET DataIn[31:0] 0x02B516B3, Wait 0, MTIP 0, MEIP 0;
        EVAL;
        SEQ CLK 0 -> CLK 1 -> CLK 0;
        SET DataIn[31:0] 0x02B516B3, Wait 0, MTIP 0, MEIP 0;
        EVAL;
        ASSERT ByteEn[3:0] 0x2;
        SEQ CLK 0 -> CLK 1 -> CLK 0;
        SET DataIn[31:0] 0x02B516B3, Wait 0, MTIP 0, MEIP 0;
        EVAL;
        SEQ CLK 0 -> CLK 1 -> CLK 0;
        SET DataIn[31:0] 0x02B516B3, Wait 0, MTIP 0, MEIP 0;
        EVAL;
        ASSERT ByteEn[3:0] 0x1;
        SEQ CLK 0 -> CLK 1 -> CLK 0;
        SET DataIn[31:0] 0x02B516B3, Wait 0, MTIP 0, MEIP 0;
        EVAL;
        SEQ CLK 0 -> CLK 1 -> CLK 0;
        SET DataIn[31:0] 0x02B516B3, Wait 0, MTIP 0, MEIP 0;
        EVAL;
        SEQ CLK 0 -> CLK 1 -> CLK 0;
        SET DataIn[31:0] 0x02B516B3, Wait 0, MTIP 0, MEIP 0;
        EVAL;
        SEQ CLK 0 -> CLK 1 -> CLK 0;
        SET DataIn[31:0] 0x02B516B3, Wait 0, MTIP 0, MEIP 0;
        EVAL;
        SEQ CLK 0 -> CLK 1 -> CLK 0;
        SET DataIn[31:0] 0x02B516B3, Wait 0, MTIP 0, MEIP 0;
        EVAL;
        SEQ CLK 0 -> CLK 1 -> CLK 0;
        SET DataIn[31:0] 0x02B516B3, Wait 0, MTIP 0, MEIP 0;
        EVAL;
        SEQ CLK 0 -> CLK 1 -> CLK 0;
        SET DataIn[31:0] 0x02B516B3, Wait 0, MTIP 0, MEIP 0;
