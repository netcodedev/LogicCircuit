// Program-flow tests for CPU_RV32 (one bus, the harness plays the memory)
//
// Generated by `cargo test --release --lib riscv::clt_gen -- --ignored`
// from the simulator; the circuit is checked against Rust references and the
// instruction-level simulator in src/riscv/tests.rs and cpu_tests.rs.

TESTS FOR CPU_RV32 {
    TEST "alu and branches" {
        // li a0, 0x12345678
        // li a1, -7
        // add a2, a0, a1
        // sub a3, a0, a1
        // xor a4, a0, a1
        // sra a5, a1, a0
        // sltu a6, a1, a0
        // li t1, 4
        // 1:  addi t0, t0, 3
        // addi t1, t1, -1
        // bnez t1, 1b
        // jal ra, 2f
        // ebreak
        // 2:  auipc s0, 1
        // ret
        SET Reset 1;
        SET DataIn[31:0] 0x12345537, Wait 0, MTIP 0, MEIP 0;
        SEQ CLK 0 -> CLK 1 -> CLK 0;
        SET DataIn[31:0] 0x12345537, Wait 0, MTIP 0, MEIP 0;
        SEQ CLK 0 -> CLK 1 -> CLK 0;
        SET DataIn[31:0] 0x12345537, Wait 0, MTIP 0, MEIP 0;
        SEQ CLK 0 -> CLK 1 -> CLK 0;
        SET Reset 0;
        SET DataIn[31:0] 0x12345537, Wait 0, MTIP 0, MEIP 0;
        EVAL;
        ASSERT Addr[31:0] 0x00000000; ASSERT DataOut[31:0] 0x00000000; ASSERT ByteEn[3:0] 0x1; ASSERT Write 0; ASSERT Read 0; ASSERT Fetch 1; ASSERT PC[31:0] 0x00000000; ASSERT Halted 0;
        SEQ CLK 0 -> CLK 1 -> CLK 0;
        SET DataIn[31:0] 0x67850513, Wait 0, MTIP 0, MEIP 0;
        EVAL;
        ASSERT Addr[31:0] 0x00000004; ASSERT ByteEn[3:0] 0x3; ASSERT PC[31:0] 0x00000004;
        SEQ CLK 0 -> CLK 1 -> CLK 0;
        SET DataIn[31:0] 0xFF900593, Wait 0, MTIP 0, MEIP 0;
        EVAL;
        ASSERT Addr[31:0] 0x00000008; ASSERT PC[31:0] 0x00000008;
        SEQ CLK 0 -> CLK 1 -> CLK 0;
        SET DataIn[31:0] 0x00B50633, Wait 0, MTIP 0, MEIP 0;
        EVAL;
        ASSERT Addr[31:0] 0x0000000C; ASSERT ByteEn[3:0] 0x1; ASSERT PC[31:0] 0x0000000C;
        SEQ CLK 0 -> CLK 1 -> CLK 0;
        SET DataIn[31:0] 0x40B506B3, Wait 0, MTIP 0, MEIP 0;
        EVAL;
        ASSERT Addr[31:0] 0x00000010; ASSERT ByteEn[3:0] 0x2; ASSERT PC[31:0] 0x00000010;
        SEQ CLK 0 -> CLK 1 -> CLK 0;
        SET DataIn[31:0] 0x00B54733, Wait 0, MTIP 0, MEIP 0;
        EVAL;
        ASSERT Addr[31:0] 0x00000014; ASSERT DataOut[31:0] 0xF9F9F9F9; ASSERT PC[31:0] 0x00000014;
        SEQ CLK 0 -> CLK 1 -> CLK 0;
        SET DataIn[31:0] 0x40A5D7B3, Wait 0, MTIP 0, MEIP 0;
        EVAL;
        ASSERT Addr[31:0] 0x00000018; ASSERT ByteEn[3:0] 0x8; ASSERT PC[31:0] 0x00000018;
        SEQ CLK 0 -> CLK 1 -> CLK 0;
        SET DataIn[31:0] 0x00A5B833, Wait 0, MTIP 0, MEIP 0;
        EVAL;
        ASSERT Addr[31:0] 0x0000001C; ASSERT ByteEn[3:0] 0x2; ASSERT PC[31:0] 0x0000001C;
        SEQ CLK 0 -> CLK 1 -> CLK 0;
        SET DataIn[31:0] 0x00400313, Wait 0, MTIP 0, MEIP 0;
        EVAL;
        ASSERT Addr[31:0] 0x00000020; ASSERT DataOut[31:0] 0x56785678; ASSERT ByteEn[3:0] 0xC; ASSERT PC[31:0] 0x00000020;
        SEQ CLK 0 -> CLK 1 -> CLK 0;
        SET DataIn[31:0] 0x00328293, Wait 0, MTIP 0, MEIP 0;
        EVAL;
        ASSERT Addr[31:0] 0x00000024; ASSERT DataOut[31:0] 0x12345678; ASSERT ByteEn[3:0] 0xF; ASSERT PC[31:0] 0x00000024;
        SEQ CLK 0 -> CLK 1 -> CLK 0;
        SET DataIn[31:0] 0xFFF30313, Wait 0, MTIP 0, MEIP 0;
        EVAL;
        ASSERT Addr[31:0] 0x00000028; ASSERT DataOut[31:0] 0x00000000; ASSERT ByteEn[3:0] 0x1; ASSERT PC[31:0] 0x00000028;
        SEQ CLK 0 -> CLK 1 -> CLK 0;
        SET DataIn[31:0] 0xFE031CE3, Wait 0, MTIP 0, MEIP 0;
        EVAL;
        ASSERT Addr[31:0] 0x0000002C; ASSERT ByteEn[3:0] 0x8; ASSERT PC[31:0] 0x0000002C;
        SEQ CLK 0 -> CLK 1 -> CLK 0;
        SET DataIn[31:0] 0x00328293, Wait 0, MTIP 0, MEIP 0;
        EVAL;
        ASSERT Addr[31:0] 0x00000024; ASSERT PC[31:0] 0x00000024;
        SEQ CLK 0 -> CLK 1 -> CLK 0;
        SET DataIn[31:0] 0xFFF30313, Wait 0, MTIP 0, MEIP 0;
        EVAL;
        ASSERT Addr[31:0] 0x00000028; ASSERT ByteEn[3:0] 0xC; ASSERT PC[31:0] 0x00000028;
        SEQ CLK 0 -> CLK 1 -> CLK 0;
        SET DataIn[31:0] 0xFE031CE3, Wait 0, MTIP 0, MEIP 0;
        EVAL;
        ASSERT Addr[31:0] 0x0000002C; ASSERT ByteEn[3:0] 0x4; ASSERT PC[31:0] 0x0000002C;
        SEQ CLK 0 -> CLK 1 -> CLK 0;
        SET DataIn[31:0] 0x00328293, Wait 0, MTIP 0, MEIP 0;
        EVAL;
        ASSERT Addr[31:0] 0x00000024; ASSERT PC[31:0] 0x00000024;
        SEQ CLK 0 -> CLK 1 -> CLK 0;
        SET DataIn[31:0] 0xFFF30313, Wait 0, MTIP 0, MEIP 0;
        EVAL;
        ASSERT Addr[31:0] 0x00000028; ASSERT ByteEn[3:0] 0xC; ASSERT PC[31:0] 0x00000028;
        SEQ CLK 0 -> CLK 1 -> CLK 0;
