    TEST "loads and stores" {
        // la s0, data
        // li a0, 0x8090A0B0
        // sw a0, 0(s0)
        // lw a1, 0(s0)
        // add a2, a1, a1
        // lb a3, 1(s0)
        // lhu a4, 2(s0)
        // sb a0, 5(s0)
        // sh a0, 6(s0)
        // lw a5, 4(s0)
        // ebreak
        // .align 3
        // data:
        // .word 0, 0
        SET Reset 1;
        SET DataIn[31:0] 0x00000000, Wait 0, MTIP 0, MEIP 0;
        SEQ CLK 0 -> CLK 1 -> CLK 0;
        SET DataIn[31:0] 0x00000437, Wait 0, MTIP 0, MEIP 0;
        SEQ CLK 0 -> CLK 1 -> CLK 0;
        SET DataIn[31:0] 0x00000437, Wait 0, MTIP 0, MEIP 0;
        SEQ CLK 0 -> CLK 1 -> CLK 0;
        SET Reset 0;
        SET DataIn[31:0] 0x00000437, Wait 0, MTIP 0, MEIP 0;
        EVAL;
        ASSERT Addr[31:0] 0x00000000; ASSERT DataOut[31:0] 0x00000000; ASSERT ByteEn[3:0] 0x1; ASSERT Write 0; ASSERT Read 0; ASSERT Fetch 1; ASSERT PC[31:0] 0x00000000; ASSERT Halted 0;
        SEQ CLK 0 -> CLK 1 -> CLK 0;
        SET DataIn[31:0] 0x03840413, Wait 0, MTIP 0, MEIP 0;
        EVAL;
        ASSERT Addr[31:0] 0x00000004; ASSERT PC[31:0] 0x00000004;
        SEQ CLK 0 -> CLK 1 -> CLK 0;
        SET DataIn[31:0] 0x8090A537, Wait 0, MTIP 0, MEIP 0;
        EVAL;
        ASSERT Addr[31:0] 0x00000008; ASSERT PC[31:0] 0x00000008;
        SEQ CLK 0 -> CLK 1 -> CLK 0;
        SET DataIn[31:0] 0x0B050513, Wait 0, MTIP 0, MEIP 0;
        EVAL;
        ASSERT Addr[31:0] 0x0000000C; ASSERT PC[31:0] 0x0000000C;
        SEQ CLK 0 -> CLK 1 -> CLK 0;
        SET DataIn[31:0] 0x00A42023, Wait 0, MTIP 0, MEIP 0;
        EVAL;
        ASSERT Addr[31:0] 0x00000010; ASSERT ByteEn[3:0] 0xF; ASSERT PC[31:0] 0x00000010;
        SEQ CLK 0 -> CLK 1 -> CLK 0;
        SET DataIn[31:0] 0x00042583, Wait 0, MTIP 0, MEIP 0;
        EVAL;
        ASSERT Addr[31:0] 0x00000014; ASSERT ByteEn[3:0] 0x1; ASSERT PC[31:0] 0x00000014;
        SEQ CLK 0 -> CLK 1 -> CLK 0;
        SET DataIn[31:0] 0x00000000, Wait 0, MTIP 0, MEIP 0;
        EVAL;
        ASSERT Addr[31:0] 0x00000038; ASSERT DataOut[31:0] 0x8090A0B0; ASSERT ByteEn[3:0] 0xF; ASSERT Write 1; ASSERT Fetch 0; ASSERT PC[31:0] 0x00000018;
        SEQ CLK 0 -> CLK 1 -> CLK 0;
        SET DataIn[31:0] 0x8090A0B0, Wait 0, MTIP 0, MEIP 0;
        EVAL;
        ASSERT DataOut[31:0] 0x00000000; ASSERT Write 0; ASSERT Read 1;
        SEQ CLK 0 -> CLK 1 -> CLK 0;
        SET DataIn[31:0] 0x00B58633, Wait 0, MTIP 0, MEIP 0;
        EVAL;
        ASSERT Addr[31:0] 0x00000018; ASSERT ByteEn[3:0] 0x1; ASSERT Read 0; ASSERT Fetch 1;
        SEQ CLK 0 -> CLK 1 -> CLK 0;
        SET DataIn[31:0] 0x00140683, Wait 0, MTIP 0, MEIP 0;
        EVAL;
        ASSERT Addr[31:0] 0x0000001C; ASSERT ByteEn[3:0] 0xF; ASSERT PC[31:0] 0x0000001C;
        SEQ CLK 0 -> CLK 1 -> CLK 0;
        SET DataIn[31:0] 0x00245703, Wait 0, MTIP 0, MEIP 0;
        EVAL;
        ASSERT Addr[31:0] 0x00000020; ASSERT DataOut[31:0] 0xB0B0B0B0; ASSERT ByteEn[3:0] 0x1; ASSERT PC[31:0] 0x00000020;
        SEQ CLK 0 -> CLK 1 -> CLK 0;
        SET DataIn[31:0] 0x8090A0B0, Wait 0, MTIP 0, MEIP 0;
        EVAL;
        ASSERT Addr[31:0] 0x00000039; ASSERT DataOut[31:0] 0x34343434; ASSERT ByteEn[3:0] 0x2; ASSERT Read 1; ASSERT Fetch 0; ASSERT PC[31:0] 0x00000024;
        SEQ CLK 0 -> CLK 1 -> CLK 0;
        SET DataIn[31:0] 0x8090A0B0, Wait 0, MTIP 0, MEIP 0;
        EVAL;
        ASSERT Addr[31:0] 0x0000003A; ASSERT DataOut[31:0] 0x00000000; ASSERT ByteEn[3:0] 0xC;
        SEQ CLK 0 -> CLK 1 -> CLK 0;
        SET DataIn[31:0] 0x00A402A3, Wait 0, MTIP 0, MEIP 0;
        EVAL;
        ASSERT Addr[31:0] 0x00000024; ASSERT ByteEn[3:0] 0xF; ASSERT Read 0; ASSERT Fetch 1;
        SEQ CLK 0 -> CLK 1 -> CLK 0;
        SET DataIn[31:0] 0x00A41323, Wait 0, MTIP 0, MEIP 0;
        EVAL;
        ASSERT Addr[31:0] 0x00000028; ASSERT PC[31:0] 0x00000028;
        SEQ CLK 0 -> CLK 1 -> CLK 0;
        SET DataIn[31:0] 0x00000000, Wait 0, MTIP 0, MEIP 0;
        EVAL;
        ASSERT Addr[31:0] 0x0000003D; ASSERT DataOut[31:0] 0xB0B0B0B0; ASSERT ByteEn[3:0] 0x2; ASSERT Write 1; ASSERT Fetch 0; ASSERT PC[31:0] 0x0000002C;
        SEQ CLK 0 -> CLK 1 -> CLK 0;
        SET DataIn[31:0] 0x0000B000, Wait 0, MTIP 0, MEIP 0;
        EVAL;
        ASSERT Addr[31:0] 0x0000003E; ASSERT DataOut[31:0] 0xA0B0A0B0; ASSERT ByteEn[3:0] 0xC;
        SEQ CLK 0 -> CLK 1 -> CLK 0;
        SET DataIn[31:0] 0x00442783, Wait 0, MTIP 0, MEIP 0;
        EVAL;
        ASSERT Addr[31:0] 0x0000002C; ASSERT DataOut[31:0] 0x00000000; ASSERT ByteEn[3:0] 0x1; ASSERT Write 0; ASSERT Fetch 1;
        SEQ CLK 0 -> CLK 1 -> CLK 0;
        SET DataIn[31:0] 0x00100073, Wait 0, MTIP 0, MEIP 0;
        EVAL;
        ASSERT Addr[31:0] 0x00000030; ASSERT ByteEn[3:0] 0xF; ASSERT PC[31:0] 0x00000030;
        SEQ CLK 0 -> CLK 1 -> CLK 0;
        SET DataIn[31:0] 0xA0B0B000, Wait 0, MTIP 0, MEIP 0;
        EVAL;
        ASSERT Addr[31:0] 0x0000003C; ASSERT Read 1; ASSERT Fetch 0; ASSERT PC[31:0] 0x00000034;
        SEQ CLK 0 -> CLK 1 -> CLK 0;
        SET DataIn[31:0] 0x00000000, Wait 0, MTIP 0, MEIP 0;
        EVAL;
        ASSERT Addr[31:0] 0x00000034; ASSERT DataOut[31:0] 0x34343434; ASSERT ByteEn[3:0] 0x1; ASSERT Read 0; ASSERT Fetch 1; ASSERT Halted 1;
        ASSERT Addr[31:0] 0x00000034; ASSERT DataOut[31:0] 0x34343434; ASSERT ByteEn[3:0] 0x1; ASSERT Write 0; ASSERT Read 0; ASSERT Fetch 1; ASSERT PC[31:0] 0x00000034; ASSERT Halted 1;
        ASSERT RegFile.R_1.Q[31:0] 0x00000034; ASSERT RegFile.R_2.Q[31:0] 0x00000000; ASSERT RegFile.R_3.Q[31:0] 0x00000000; ASSERT RegFile.R_4.Q[31:0] 0x00000000; ASSERT RegFile.R_5.Q[31:0] 0x0000000C; ASSERT RegFile.R_6.Q[31:0] 0x00000000; ASSERT RegFile.R_7.Q[31:0] 0x00000000; ASSERT RegFile.R_8.Q[31:0] 0x00000038; ASSERT RegFile.R_9.Q[31:0] 0x00000000; ASSERT RegFile.R_10.Q[31:0] 0x8090A0B0; ASSERT RegFile.R_11.Q[31:0] 0x8090A0B0; ASSERT RegFile.R_12.Q[31:0] 0x01214160; ASSERT RegFile.R_13.Q[31:0] 0xFFFFFFA0; ASSERT RegFile.R_14.Q[31:0] 0x00008090; ASSERT RegFile.R_15.Q[31:0] 0xA0B0B000; ASSERT RegFile.R_16.Q[31:0] 0x00000000; ASSERT RegFile.R_17.Q[31:0] 0x00000000; ASSERT RegFile.R_18.Q[31:0] 0x00000000; ASSERT RegFile.R_19.Q[31:0] 0x00000000; ASSERT RegFile.R_20.Q[31:0] 0x00000000; ASSERT RegFile.R_21.Q[31:0] 0x00000000; ASSERT RegFile.R_22.Q[31:0] 0x00000000; ASSERT RegFile.R_23.Q[31:0] 0x00000000; ASSERT RegFile.R_24.Q[31:0] 0x00000000; ASSERT RegFile.R_25.Q[31:0] 0x00000000; ASSERT RegFile.R_26.Q[31:0] 0x00000000; ASSERT RegFile.R_27.Q[31:0] 0x00000000; ASSERT RegFile.R_28.Q[31:0] 0x00000000; ASSERT RegFile.R_29.Q[31:0] 0x00000000; ASSERT RegFile.R_30.Q[31:0] 0x00000000; ASSERT RegFile.R_31.Q[31:0] 0x00000000;
