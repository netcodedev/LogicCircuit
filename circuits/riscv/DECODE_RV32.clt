// Tests for DECODE_RV32: every instruction decoded into the registers, Load = 0 holds
//
// Generated by `cargo test --release --lib riscv::clt_gen -- --ignored`
// from the simulator; the circuit is checked against Rust references and the
// instruction-level simulator in src/riscv/tests.rs and cpu_tests.rs.

TESTS FOR DECODE_RV32 {
    TEST "reset" {
        SET Reset 1, Load 0, Word[31:0] 0x00000000;
        SEQ CLK 0 -> CLK 1 -> CLK 0;
        SET Reset 0;
        EVAL;
        ASSERT IsLoad 0; ASSERT IsStore 0; ASSERT IsBranch 0; ASSERT IsJal 0; ASSERT IsJalr 0; ASSERT IsCsr 0; ASSERT CsrImm 0; ASSERT Ecall 0; ASSERT Ebreak 0; ASSERT Mret 0; ASSERT IsMulDiv 0; ASSERT Illegal 0; ASSERT RegWrite 0; ASSERT ASelPc 0; ASSERT ASelZero 0; ASSERT BSelImm 0; ASSERT BSelFour 0; ASSERT AluF[2:0] 0x0; ASSERT AluSub 0; ASSERT AluArith 0; ASSERT CsrHi[15:0] 0x0000; ASSERT CsrMid[15:0] 0x0000; ASSERT CsrLo[15:0] 0x0000; ASSERT Imm[31:0] 0x00000000;
    }

