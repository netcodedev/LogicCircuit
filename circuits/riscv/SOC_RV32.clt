// Program-flow tests for SOC_RV32 (the harness plays the external memory)
//
// Generated by `cargo test --release --lib riscv::clt_gen -- --ignored`
// from the simulator; the circuit is checked against Rust references and the
// instruction-level simulator in src/riscv/tests.rs and cpu_tests.rs.

TESTS FOR SOC_RV32 {
    TEST "GPIO, display, UART" {
        // li s0, 0x10000000
        // li t0, 0xCAFE1234
        // sw t0, 8(s0)
        // lw t1, 4(s0)
        // sw t1, 0(s0)
        // li t0, 'O'
        // sb t0, 12(s0)
        // 1:  lw t2, 16(s0)
        // andi t2, t2, 1
        // bnez t2, 1b
        // li t0, 'K'
        // sb t0, 12(s0)
        // ebreak
        SET Reset 1;
        SET DataIn[31:0] 0x10000437, Wait 0, GpioIn[31:0] 0x0000A5A5, Rx 1;
        SEQ CLK 0 -> CLK 1 -> CLK 0;
        SET DataIn[31:0] 0xCAFE12B7, Wait 0, GpioIn[31:0] 0x0000A5A5, Rx 1;
        SEQ CLK 0 -> CLK 1 -> CLK 0;
        SET DataIn[31:0] 0x23428293, Wait 0, GpioIn[31:0] 0x0000A5A5, Rx 1;
        SEQ CLK 0 -> CLK 1 -> CLK 0;
        SET DataIn[31:0] 0x10000437, Wait 0, GpioIn[31:0] 0x0000A5A5, Rx 1;
        SEQ CLK 0 -> CLK 1 -> CLK 0;
        SET DataIn[31:0] 0x10000437, Wait 0, GpioIn[31:0] 0x0000A5A5, Rx 1;
        SEQ CLK 0 -> CLK 1 -> CLK 0;
        SET Reset 0;
        SET DataIn[31:0] 0x10000437, Wait 0, GpioIn[31:0] 0x0000A5A5, Rx 1;
        SEQ CLK 0 -> CLK 1 -> CLK 0;
        SET DataIn[31:0] 0x10000437, Wait 0, GpioIn[31:0] 0x0000A5A5, Rx 1;
        SEQ CLK 0 -> CLK 1 -> CLK 0;
        SET DataIn[31:0] 0x10000437, Wait 0, GpioIn[31:0] 0x0000A5A5, Rx 1;
        EVAL;
        ASSERT Addr[31:0] 0x00000000; ASSERT DataOut[31:0] 0x00000000; ASSERT ByteEn[3:0] 0x1; ASSERT Write 0; ASSERT Read 0; ASSERT Fetch 1; ASSERT PC[31:0] 0x00000000; ASSERT Halted 0; ASSERT GpioOut[31:0] 0x00000000; ASSERT Tx 1; ASSERT Seg7[6:0] 0x3F; ASSERT Seg6[6:0] 0x3F; ASSERT Seg5[6:0] 0x3F; ASSERT Seg4[6:0] 0x3F; ASSERT Seg3[6:0] 0x3F; ASSERT Seg2[6:0] 0x3F; ASSERT Seg1[6:0] 0x3F; ASSERT Seg0[6:0] 0x3F;
