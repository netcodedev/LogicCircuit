// Tests for CSR_RV32: reads, writes (set/clear), traps, mret, counters, interrupts
//
// Generated by `cargo test --release --lib riscv::clt_gen -- --ignored`
// from the simulator; the circuit is checked against Rust references and the
// instruction-level simulator in src/riscv/tests.rs and cpu_tests.rs.

TESTS FOR CSR_RV32 {
    TEST "reset" {
        SET Reset 1;
        SEQ CLK 0 -> CLK 1 -> CLK 0;
        SET Reset 0;
        EVAL;
        ASSERT ReadValue[31:0] 0x00000000; ASSERT WData[31:0] 0x00000000; ASSERT Exists 0; ASSERT ReadOnly 0; ASSERT Mtvec[31:0] 0x00000000; ASSERT Mepc[31:0] 0x00000000; ASSERT IrqPending 0; ASSERT IrqExternal 0;
    }

    TEST "random accesses 0" {
        SET CsrHi[15:0] 0x0008, CsrMid[15:0] 0x0010, CsrLo[15:0] 0x0001, Op[1:0] 0x2, Src[31:0] 0xE5D67B9D, CsrWrite 1, Trap 0, CauseInt 1, CauseCode[3:0] 0x2, TrapPc[31:0] 0x0000000F, TrapVal[31:0] 0x79B59AC3, Mret 0, Retire 1, MTIP 1, MEIP 0;
