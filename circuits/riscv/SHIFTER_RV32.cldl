CIRCUIT SHIFTER_RV32 {
    // 32-bit barrel shifter for SLL, SRL and SRA: shifts A by Amt (0..31).
    //
    //   Shl = A << Amt                      (SLL: zeros in from the right)
    //   Shr = A >> Amt, Arith = 0 -> SRL    (zeros in from the left)
    //                   Arith = 1 -> SRA    (copies of A[31] in from the left)
    //
    // A left and a right shifter side by side, five 2:1 mux stages each
    // (1, 2, 4, 8, 16); the ALU's result mux picks one, so there is no
    // bit reversal on the path. RV64 needs a sixth stage (Amt[5]).
    INPUT A[32];
    INPUT Amt[5];
    INPUT Arith;

    OUTPUT Shl[32];
    OUTPUT Shr[32];

    PART L1: SHIFT_STAGE_L<32, 1>;
    PART L2: SHIFT_STAGE_L<32, 2>;
    PART L4: SHIFT_STAGE_L<32, 4>;
    PART L8: SHIFT_STAGE_L<32, 8>;
    PART L16: SHIFT_STAGE_L<32, 16>;
    PART R1: SHIFT_STAGE_R<32, 1>;
    PART R2: SHIFT_STAGE_R<32, 2>;
    PART R4: SHIFT_STAGE_R<32, 4>;
    PART R8: SHIFT_STAGE_R<32, 8>;
    PART R16: SHIFT_STAGE_R<32, 16>;
    PART FillAnd: AND;             // fill bit = Arith AND A[31]

    CONNECT Arith -> FillAnd.in1;
    CONNECT A[31] -> FillAnd.in2;

    CONNECT A -> L1.In;
    CONNECT L1.Out -> L2.In;
    CONNECT L2.Out -> L4.In;
    CONNECT L4.Out -> L8.In;
    CONNECT L8.Out -> L16.In;
    CONNECT L16.Out -> Shl;
    CONNECT Amt[0] -> L1.Sel;
    CONNECT Amt[1] -> L2.Sel;
    CONNECT Amt[2] -> L4.Sel;
    CONNECT Amt[3] -> L8.Sel;
    CONNECT Amt[4] -> L16.Sel;

    CONNECT A -> R1.In;
    CONNECT R1.Out -> R2.In;
    CONNECT R2.Out -> R4.In;
    CONNECT R4.Out -> R8.In;
    CONNECT R8.Out -> R16.In;
    CONNECT R16.Out -> Shr;
    CONNECT Amt[0] -> R1.Sel;
    CONNECT Amt[1] -> R2.Sel;
    CONNECT Amt[2] -> R4.Sel;
    CONNECT Amt[3] -> R8.Sel;
    CONNECT Amt[4] -> R16.Sel;
    CONNECT FillAnd.out -> R1.Fill;
    CONNECT FillAnd.out -> R2.Fill;
    CONNECT FillAnd.out -> R4.Fill;
    CONNECT FillAnd.out -> R8.Fill;
    CONNECT FillAnd.out -> R16.Fill;
}
