CIRCUIT BRANCH_RV32 {
    // Branch condition of an RV32 branch, straight from the forwarded rs1/rs2
    // (A, B): its own comparator keeps the immediate and operand muxes of
    // the ALU off the branch path. F = funct3:
    //   000 beq, 001 bne, 100 blt, 101 bge, 110 bltu, 111 bgeu
    // One comparator (CMP_KS5, the carry network of A + ~B + 1):
    //   Eq  = A == B: all propagate bits A XOR ~B are 1
    //   Ltu = A < B unsigned: no carry out
    //   Lt  = A < B signed: A[31] if the signs differ, else Ltu
    // Cond = (F[2] ? (F[1] ? Ltu : Lt) : Eq) XOR F[0]
    INPUT A[32];
    INPUT B[32];
    INPUT F[3];

    OUTPUT Cond;

    PART C_TRUE: NOR;              // Constant 1 (VCC), NOR(0,0) = 1
    PART BNot: NOT_BUS<32>;
    PART Cmp: CMP_KS5<32>;         // A + ~B + 1
    PART SignDiff: XOR;
    PART LtuNot: NOT;
    PART LtSel: MUX_2_1;           // signs equal: Ltu; differ: A[31]
    PART LtMux: MUX_2_1;           // Lt, Ltu by F[1]
    PART CondMux: MUX_2_1;         // Eq, LtMux by F[2]
    PART CondX: XOR;               // ... XOR F[0]

    CONNECT B -> BNot.A;
    CONNECT A -> Cmp.A;
    CONNECT BNot.Out -> Cmp.B;
    CONNECT C_TRUE.out -> Cmp.Cin;

    CONNECT A[31] -> SignDiff.in1;
    CONNECT B[31] -> SignDiff.in2;
    CONNECT Cmp.Cout -> LtuNot.in;
    CONNECT LtuNot.out -> LtSel.A;
    CONNECT A[31] -> LtSel.B;
    CONNECT SignDiff.out -> LtSel.S;

    CONNECT LtSel.Out -> LtMux.A;
    CONNECT LtuNot.out -> LtMux.B;
    CONNECT F[1] -> LtMux.S;
    CONNECT Cmp.PAll -> CondMux.A;
    CONNECT LtMux.Out -> CondMux.B;
    CONNECT F[2] -> CondMux.S;
    CONNECT CondMux.Out -> CondX.in1;
    CONNECT F[0] -> CondX.in2;
    CONNECT CondX.out -> Cond;
}
