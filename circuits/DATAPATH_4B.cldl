CIRCUIT DATAPATH_4B {
    // This is the core datapath of the CPU.
    // It combines the Register File and the ALU.

    // --- Control Inputs (from Control Unit) ---
    INPUT ReadAddrA[4];     // Selects RegFile.DataOutA
    INPUT ReadAddrB[4];     // Selects RegFile.DataOutB
    INPUT WriteAddr[4];     // Selects RegFile register to write
    INPUT WriteEnable;      // Enables writing to the RegFile
    INPUT ALUSel[2];        // Selects the ALU operation
    INPUT ALUCin;           // Carry-in for the ALU
    INPUT CLK;              // Master clock signal

    // --- Data Inputs & Controls ---
    INPUT MemDataIn[4];     // Data from Memory (or test harness)
    INPUT MemToReg;         // 1 = Write MemDataIn to Reg, 0 = Write ALU.Result to Reg

    // --- Immediate Inputs & Control ---
    INPUT Immediate[4];     // 4-bit immediate value from instruction
    INPUT ALUSrc;           // 1 = Select Immediate, 0 = Select RegFile.DataOutB

    // --- Flag Outputs (to Control Unit) ---
    OUTPUT ALU_Cout;        // ALU Carry Out flag
    OUTPUT ALU_Z;          // ALU Zero flag

    // --- Core Components ---
    PART RegFile: REG_FILE_16x4;
    PART Alu: ALU_4B;

    // --- Muxes (Refactored to use 4-bit parts) ---
    PART DataInMux: MUX_4B_2_1;  // Mux for RegFile DataIn
    PART AluSrcMux: MUX_4B_2_1;  // Mux for ALU 'B' Input

    // --- Connections ---

    // 1. Connect Control Signals
    // RegFile control
    CONNECT ReadAddrA -> RegFile.ReadAddrA;
    CONNECT ReadAddrB -> RegFile.ReadAddrB;
    CONNECT WriteAddr -> RegFile.WriteAddr;
    CONNECT WriteEnable -> RegFile.WriteEnable;
    CONNECT CLK -> RegFile.CLK;

    // ALU control
    CONNECT ALUSel -> Alu.S;
    CONNECT ALUCin -> Alu.Cin;

    // 2. Connect Datapath Loop
    // Connect RegFile Read Port A to ALU Input A
    CONNECT RegFile.DataOutA -> Alu.A;

    // 3. Connect ALU 'B' Input Mux
    // Mux S=0 selects A (RegFile.DataOutB)
    // Mux S=1 selects B (Immediate[4])
    CONNECT ALUSrc -> AluSrcMux.S;
    CONNECT RegFile.DataOutB -> AluSrcMux.A;

    // Connect 4-bit immediate to the 4-bit Mux input.
    CONNECT Immediate -> AluSrcMux.B;

    CONNECT AluSrcMux.Out -> Alu.B; // Connect 4-bit bus

    // 4. Connect Data-In Mux (ALU.Result or MemDataIn)
    // Mux S=0 selects A (ALU Result)
    // Mux S=1 selects B (Memory Data)
    CONNECT MemToReg -> DataInMux.S;
    CONNECT Alu.Result -> DataInMux.A; // Connect 4-bit bus
    CONNECT MemDataIn -> DataInMux.B;  // Connect 4-bit bus
    CONNECT DataInMux.Out -> RegFile.DataIn; // Connect 4-bit bus

    // 5. Connect Datapath Outputs
    CONNECT Alu.Cout -> ALU_Cout;
    CONNECT Alu.Z -> ALU_Z;
}