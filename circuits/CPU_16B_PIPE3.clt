    // Pipeline hazards: forwarding, load-use stalls, RET, R0, store before HALT
    //   LI   R1, 0x2000
    //   MOVI R2, 5
    //   SW   R2, R1, 0
    //   LW   R3, R1, 0      ; load ...
    //   ADD  R3, R3         ; ... and use at once: stall, 10
    //   ADDI R3, 1          ; forwarded: 11
    //   SW   R3, R1, 1      ; forwarded store data
    //   LW   R4, R1, 1
    //   OUT  R4             ; load-use on OUT
    //   PUSH R4
    //   POP  R5
    //   CALL sub            ; RET target comes from memory
    //   LI   R6, target
    //   SW   R6, R1, 2
    //   LW   R7, R1, 2
    //   JR   R7             ; load-use on a jump target
    //   HALT
    //   target:
    //   CMP  R5, R4
    //   BEQ  ok
    //   HALT
    //   ok:
    //   ADD  R0, R5         ; R0 stays 0, nothing to forward
    //   MOV  R8, R0
    //   ADD  R8, R5         ; 11
    //   OUT  R8
