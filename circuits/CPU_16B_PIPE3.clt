        ASSERT FlagZ 0; ASSERT FlagN 0; ASSERT FlagC 0; ASSERT FlagV 0;
        // 0x0007: 0x1548
        SET Instruction[0] 0, Instruction[1] 0, Instruction[2] 0, Instruction[3] 1, Instruction[4] 0, Instruction[5] 0, Instruction[6] 1, Instruction[7] 0, Instruction[8] 1, Instruction[9] 0, Instruction[10] 1, Instruction[11] 0, Instruction[12] 1, Instruction[13] 0, Instruction[14] 0, Instruction[15] 0;
        SET InstructionNext[0] 1, InstructionNext[1] 1, InstructionNext[2] 1, InstructionNext[3] 0, InstructionNext[4] 0, InstructionNext[5] 1, InstructionNext[6] 0, InstructionNext[7] 0, InstructionNext[8] 1, InstructionNext[9] 0, InstructionNext[10] 1, InstructionNext[11] 0, InstructionNext[12] 1, InstructionNext[13] 0, InstructionNext[14] 0, InstructionNext[15] 0;
