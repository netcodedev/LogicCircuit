    // Loops and conditional branches
    //   MOVI R1, 0        ; sum
    //   MOVI R2, 10       ; counter
    //   loop:
    //   ADD  R1, R2
    //   ADDI R2, -1
    //   BNE  loop         ; sum 10..1 = 55
    //   OUT  R1
    //   MOVI R3, 5
    //   LI   R4, 0xFFFE   ; -2
    //   CMP  R4, R3
    //   BLT  signed_ok
    //   HALT
    //   signed_ok:
    //   CMP  R4, R3
    //   BHI  unsigned_ok  ; 0xFFFE > 5 unsigned
    //   HALT
    //   unsigned_ok:
    //   CMP  R3, R3
    //   BGT  bad
    //   BLE  le_ok
    //   bad:
    //   HALT
    //   le_ok:
    //   CMPI R3, 5
    //   BEQ  eq_ok
    //   HALT
    //   eq_ok:
    //   BRA  done
    //   OUT  R0
    //   done:
    //   ADDI R1, 1
    //   OUT  R1           ; 56
    //   HALT
    TEST "Loops and conditional branches (62 clocks, Out = 0x0038)" {
        SET IWait 0, DWait 0;
        SET Reset 1;
        SEQ CLK 0 -> CLK 1 -> CLK 0;
        SET Reset 0;
        EVAL;
        ASSERT PC[0] 0; ASSERT PC[1] 0; ASSERT PC[2] 0; ASSERT PC[3] 0; ASSERT PC[4] 0; ASSERT PC[5] 0; ASSERT PC[6] 0; ASSERT PC[7] 0; ASSERT PC[8] 0; ASSERT PC[9] 0; ASSERT PC[10] 0; ASSERT PC[11] 0; ASSERT PC[12] 0; ASSERT PC[13] 0; ASSERT PC[14] 0; ASSERT PC[15] 0;
        ASSERT Out[0] 0; ASSERT Out[1] 0; ASSERT Out[2] 0; ASSERT Out[3] 0; ASSERT Out[4] 0; ASSERT Out[5] 0; ASSERT Out[6] 0; ASSERT Out[7] 0; ASSERT Out[8] 0; ASSERT Out[9] 0; ASSERT Out[10] 0; ASSERT Out[11] 0; ASSERT Out[12] 0; ASSERT Out[13] 0; ASSERT Out[14] 0; ASSERT Out[15] 0;
        ASSERT SP[0] 0; ASSERT SP[1] 0; ASSERT SP[2] 0; ASSERT SP[3] 0; ASSERT SP[4] 0; ASSERT SP[5] 0; ASSERT SP[6] 0; ASSERT SP[7] 0; ASSERT SP[8] 0; ASSERT SP[9] 0; ASSERT SP[10] 0; ASSERT SP[11] 0; ASSERT SP[12] 0; ASSERT SP[13] 0; ASSERT SP[14] 0; ASSERT SP[15] 0;
        SET In[0] 0, In[1] 0, In[2] 0, In[3] 0, In[4] 0, In[5] 0, In[6] 0, In[7] 0, In[8] 0, In[9] 0, In[10] 0, In[11] 0, In[12] 0, In[13] 0, In[14] 0, In[15] 0;
        // 0x0000: 0x8100
        SET Instruction[0] 0, Instruction[1] 0, Instruction[2] 0, Instruction[3] 0, Instruction[4] 0, Instruction[5] 0, Instruction[6] 0, Instruction[7] 0, Instruction[8] 1, Instruction[9] 0, Instruction[10] 0, Instruction[11] 0, Instruction[12] 0, Instruction[13] 0, Instruction[14] 0, Instruction[15] 1;
        SET InstructionNext[0] 0, InstructionNext[1] 1, InstructionNext[2] 0, InstructionNext[3] 1, InstructionNext[4] 0, InstructionNext[5] 0, InstructionNext[6] 0, InstructionNext[7] 0, InstructionNext[8] 0, InstructionNext[9] 1, InstructionNext[10] 0, InstructionNext[11] 0, InstructionNext[12] 0, InstructionNext[13] 0, InstructionNext[14] 0, InstructionNext[15] 1;
        SET MemDataIn[0] 0, MemDataIn[1] 0, MemDataIn[2] 0, MemDataIn[3] 0, MemDataIn[4] 0, MemDataIn[5] 0, MemDataIn[6] 0, MemDataIn[7] 0, MemDataIn[8] 0, MemDataIn[9] 0, MemDataIn[10] 0, MemDataIn[11] 0, MemDataIn[12] 0, MemDataIn[13] 0, MemDataIn[14] 0, MemDataIn[15] 0;
        SET IWait 0, DWait 0;
        EVAL;
        ASSERT Halted 0; ASSERT MemWrite 0;
        SEQ CLK 0 -> CLK 1 -> CLK 0;
        ASSERT PC[0] 1; ASSERT PC[1] 0; ASSERT PC[2] 0; ASSERT PC[3] 0; ASSERT PC[4] 0; ASSERT PC[5] 0; ASSERT PC[6] 0; ASSERT PC[7] 0; ASSERT PC[8] 0; ASSERT PC[9] 0; ASSERT PC[10] 0; ASSERT PC[11] 0; ASSERT PC[12] 0; ASSERT PC[13] 0; ASSERT PC[14] 0; ASSERT PC[15] 0;
