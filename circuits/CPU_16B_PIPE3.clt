// Program-flow tests for CPU_16B_PIPE3 (pipelined). The harness plays both
// memories like CPU_16B.clt (same programs): it feeds the words at PC and
// PC+1 and answers data-memory reads. After each clock it checks PC and every
// change of Out, SP and the flags; memory writes are checked as address and
// data. Each test starts with a Reset. Generated from the simulator; the
// final Out, SP, flags and all memory writes match CPU_16B (more clocks:
// lost clocks after jumps, branches and RET, load-use stalls, the reset; the
// tests marked "wait states" model slow memories with IWait/DWait).

TESTS FOR CPU_16B_PIPE3 {
    // Arithmetic, logic and flags
    //   MOVI R1, 200
    //   ADDI R1, -50      ; 150
    //   MOVI R2, 7
    //   ADD  R1, R2       ; 157
    //   SUB  R2, R1       ; 7 - 157 = -150, borrow
    //   NEG  R3, R2       ; 150
    //   NOT  R4, R3
    //   MOV  R5, R4
    //   BIC  R5, R2
    //   XOR  R5, R3
    //   OR   R5, R1
    //   AND  R5, R4
    //   LUI  R6, 0x12
    //   ORI  R6, 0x34     ; 0x1234
    //   XORI R6, 0xFF
    //   ANDI R6, 0xF0
    //   LI   R7, 0x8000
    //   ADDI R7, -1       ; 0x7FFF, signed overflow
    //   ADDI R7, 1        ; 0x8000, overflow
    //   CMP  R7, R7
    //   TEST R7, R0
    //   CMPI R1, 100
    //   OUT  R6
    //   LI   R8, 0xFFFF   ; 32-bit add: (R9:R8) = 0x0001FFFF + 0x00000001
    //   MOVI R9, 1
    //   MOVI R10, 1
    //   ADD  R8, R10
    //   ADC  R9, R0       ; 0x0002
    //   SUB  R8, R10      ; 32-bit subtract 1 again
    //   SBC  R9, R0
    //   OUT  R9
    //   HALT
    TEST "Arithmetic, logic and flags (32 clocks, Out = 0x0001)" {
        SET IWait 0, DWait 0;
        SET Reset 1;
        SEQ CLK 0 -> CLK 1 -> CLK 0;
        SET Reset 0;
        EVAL;
        ASSERT PC[0] 0; ASSERT PC[1] 0; ASSERT PC[2] 0; ASSERT PC[3] 0; ASSERT PC[4] 0; ASSERT PC[5] 0; ASSERT PC[6] 0; ASSERT PC[7] 0; ASSERT PC[8] 0; ASSERT PC[9] 0; ASSERT PC[10] 0; ASSERT PC[11] 0; ASSERT PC[12] 0; ASSERT PC[13] 0; ASSERT PC[14] 0; ASSERT PC[15] 0;
        ASSERT Out[0] 0; ASSERT Out[1] 0; ASSERT Out[2] 0; ASSERT Out[3] 0; ASSERT Out[4] 0; ASSERT Out[5] 0; ASSERT Out[6] 0; ASSERT Out[7] 0; ASSERT Out[8] 0; ASSERT Out[9] 0; ASSERT Out[10] 0; ASSERT Out[11] 0; ASSERT Out[12] 0; ASSERT Out[13] 0; ASSERT Out[14] 0; ASSERT Out[15] 0;
        ASSERT SP[0] 0; ASSERT SP[1] 0; ASSERT SP[2] 0; ASSERT SP[3] 0; ASSERT SP[4] 0; ASSERT SP[5] 0; ASSERT SP[6] 0; ASSERT SP[7] 0; ASSERT SP[8] 0; ASSERT SP[9] 0; ASSERT SP[10] 0; ASSERT SP[11] 0; ASSERT SP[12] 0; ASSERT SP[13] 0; ASSERT SP[14] 0; ASSERT SP[15] 0;
        SET In[0] 0, In[1] 0, In[2] 0, In[3] 0, In[4] 0, In[5] 0, In[6] 0, In[7] 0, In[8] 0, In[9] 0, In[10] 0, In[11] 0, In[12] 0, In[13] 0, In[14] 0, In[15] 0;
        // 0x0000: 0x81C8
        SET Instruction[0] 0, Instruction[1] 0, Instruction[2] 0, Instruction[3] 1, Instruction[4] 0, Instruction[5] 0, Instruction[6] 1, Instruction[7] 1, Instruction[8] 1, Instruction[9] 0, Instruction[10] 0, Instruction[11] 0, Instruction[12] 0, Instruction[13] 0, Instruction[14] 0, Instruction[15] 1;
        SET InstructionNext[0] 0, InstructionNext[1] 1, InstructionNext[2] 1, InstructionNext[3] 1, InstructionNext[4] 0, InstructionNext[5] 0, InstructionNext[6] 1, InstructionNext[7] 1, InstructionNext[8] 1, InstructionNext[9] 0, InstructionNext[10] 0, InstructionNext[11] 0, InstructionNext[12] 1, InstructionNext[13] 0, InstructionNext[14] 0, InstructionNext[15] 1;
        SET MemDataIn[0] 0, MemDataIn[1] 0, MemDataIn[2] 0, MemDataIn[3] 0, MemDataIn[4] 0, MemDataIn[5] 0, MemDataIn[6] 0, MemDataIn[7] 0, MemDataIn[8] 0, MemDataIn[9] 0, MemDataIn[10] 0, MemDataIn[11] 0, MemDataIn[12] 0, MemDataIn[13] 0, MemDataIn[14] 0, MemDataIn[15] 0;
        SET IWait 0, DWait 0;
        EVAL;
        ASSERT Halted 0; ASSERT MemWrite 0;
        SEQ CLK 0 -> CLK 1 -> CLK 0;
        ASSERT PC[0] 1; ASSERT PC[1] 0; ASSERT PC[2] 0; ASSERT PC[3] 0; ASSERT PC[4] 0; ASSERT PC[5] 0; ASSERT PC[6] 0; ASSERT PC[7] 0; ASSERT PC[8] 0; ASSERT PC[9] 0; ASSERT PC[10] 0; ASSERT PC[11] 0; ASSERT PC[12] 0; ASSERT PC[13] 0; ASSERT PC[14] 0; ASSERT PC[15] 0;
        // 0x0001: 0x91CE
        SET Instruction[0] 0, Instruction[1] 1, Instruction[2] 1, Instruction[3] 1, Instruction[4] 0, Instruction[5] 0, Instruction[6] 1, Instruction[7] 1, Instruction[8] 1, Instruction[9] 0, Instruction[10] 0, Instruction[11] 0, Instruction[12] 1, Instruction[13] 0, Instruction[14] 0, Instruction[15] 1;
        SET InstructionNext[0] 1, InstructionNext[1] 1, InstructionNext[2] 1, InstructionNext[3] 0, InstructionNext[4] 0, InstructionNext[5] 0, InstructionNext[6] 0, InstructionNext[7] 0, InstructionNext[8] 0, InstructionNext[9] 1, InstructionNext[10] 0, InstructionNext[11] 0, InstructionNext[12] 0, InstructionNext[13] 0, InstructionNext[14] 0, InstructionNext[15] 1;
        SET MemDataIn[0] 0, MemDataIn[1] 0, MemDataIn[2] 0, MemDataIn[3] 0, MemDataIn[4] 0, MemDataIn[5] 0, MemDataIn[6] 0, MemDataIn[7] 0, MemDataIn[8] 0, MemDataIn[9] 0, MemDataIn[10] 0, MemDataIn[11] 0, MemDataIn[12] 0, MemDataIn[13] 0, MemDataIn[14] 0, MemDataIn[15] 0;
        SET IWait 0, DWait 0;
        EVAL;
        ASSERT Halted 0; ASSERT MemWrite 0;
        SEQ CLK 0 -> CLK 1 -> CLK 0;
        ASSERT PC[0] 0; ASSERT PC[1] 1; ASSERT PC[2] 0; ASSERT PC[3] 0; ASSERT PC[4] 0; ASSERT PC[5] 0; ASSERT PC[6] 0; ASSERT PC[7] 0; ASSERT PC[8] 0; ASSERT PC[9] 0; ASSERT PC[10] 0; ASSERT PC[11] 0; ASSERT PC[12] 0; ASSERT PC[13] 0; ASSERT PC[14] 0; ASSERT PC[15] 0;
        // 0x0002: 0x8207
        SET Instruction[0] 1, Instruction[1] 1, Instruction[2] 1, Instruction[3] 0, Instruction[4] 0, Instruction[5] 0, Instruction[6] 0, Instruction[7] 0, Instruction[8] 0, Instruction[9] 1, Instruction[10] 0, Instruction[11] 0, Instruction[12] 0, Instruction[13] 0, Instruction[14] 0, Instruction[15] 1;
        SET InstructionNext[0] 0, InstructionNext[1] 0, InstructionNext[2] 0, InstructionNext[3] 0, InstructionNext[4] 0, InstructionNext[5] 1, InstructionNext[6] 0, InstructionNext[7] 0, InstructionNext[8] 1, InstructionNext[9] 0, InstructionNext[10] 0, InstructionNext[11] 0, InstructionNext[12] 1, InstructionNext[13] 0, InstructionNext[14] 0, InstructionNext[15] 0;
        SET MemDataIn[0] 0, MemDataIn[1] 0, MemDataIn[2] 0, MemDataIn[3] 0, MemDataIn[4] 0, MemDataIn[5] 0, MemDataIn[6] 0, MemDataIn[7] 0, MemDataIn[8] 0, MemDataIn[9] 0, MemDataIn[10] 0, MemDataIn[11] 0, MemDataIn[12] 0, MemDataIn[13] 0, MemDataIn[14] 0, MemDataIn[15] 0;
        SET IWait 0, DWait 0;
        EVAL;
        ASSERT Halted 0; ASSERT MemWrite 0;
        SEQ CLK 0 -> CLK 1 -> CLK 0;
        ASSERT PC[0] 1; ASSERT PC[1] 1; ASSERT PC[2] 0; ASSERT PC[3] 0; ASSERT PC[4] 0; ASSERT PC[5] 0; ASSERT PC[6] 0; ASSERT PC[7] 0; ASSERT PC[8] 0; ASSERT PC[9] 0; ASSERT PC[10] 0; ASSERT PC[11] 0; ASSERT PC[12] 0; ASSERT PC[13] 0; ASSERT PC[14] 0; ASSERT PC[15] 0;
        ASSERT FlagZ 0; ASSERT FlagN 0; ASSERT FlagC 1; ASSERT FlagV 0;
        // 0x0003: 0x1120
        SET Instruction[0] 0, Instruction[1] 0, Instruction[2] 0, Instruction[3] 0, Instruction[4] 0, Instruction[5] 1, Instruction[6] 0, Instruction[7] 0, Instruction[8] 1, Instruction[9] 0, Instruction[10] 0, Instruction[11] 0, Instruction[12] 1, Instruction[13] 0, Instruction[14] 0, Instruction[15] 0;
        SET InstructionNext[0] 1, InstructionNext[1] 0, InstructionNext[2] 0, InstructionNext[3] 0, InstructionNext[4] 1, InstructionNext[5] 0, InstructionNext[6] 0, InstructionNext[7] 0, InstructionNext[8] 0, InstructionNext[9] 1, InstructionNext[10] 0, InstructionNext[11] 0, InstructionNext[12] 1, InstructionNext[13] 0, InstructionNext[14] 0, InstructionNext[15] 0;
        SET MemDataIn[0] 0, MemDataIn[1] 0, MemDataIn[2] 0, MemDataIn[3] 0, MemDataIn[4] 0, MemDataIn[5] 0, MemDataIn[6] 0, MemDataIn[7] 0, MemDataIn[8] 0, MemDataIn[9] 0, MemDataIn[10] 0, MemDataIn[11] 0, MemDataIn[12] 0, MemDataIn[13] 0, MemDataIn[14] 0, MemDataIn[15] 0;
        SET IWait 0, DWait 0;
        EVAL;
        ASSERT Halted 0; ASSERT MemWrite 0;
        SEQ CLK 0 -> CLK 1 -> CLK 0;
        ASSERT PC[0] 0; ASSERT PC[1] 0; ASSERT PC[2] 1; ASSERT PC[3] 0; ASSERT PC[4] 0; ASSERT PC[5] 0; ASSERT PC[6] 0; ASSERT PC[7] 0; ASSERT PC[8] 0; ASSERT PC[9] 0; ASSERT PC[10] 0; ASSERT PC[11] 0; ASSERT PC[12] 0; ASSERT PC[13] 0; ASSERT PC[14] 0; ASSERT PC[15] 0;
        // 0x0004: 0x1211
        SET Instruction[0] 1, Instruction[1] 0, Instruction[2] 0, Instruction[3] 0, Instruction[4] 1, Instruction[5] 0, Instruction[6] 0, Instruction[7] 0, Instruction[8] 0, Instruction[9] 1, Instruction[10] 0, Instruction[11] 0, Instruction[12] 1, Instruction[13] 0, Instruction[14] 0, Instruction[15] 0;
        SET InstructionNext[0] 0, InstructionNext[1] 1, InstructionNext[2] 0, InstructionNext[3] 1, InstructionNext[4] 0, InstructionNext[5] 1, InstructionNext[6] 0, InstructionNext[7] 0, InstructionNext[8] 1, InstructionNext[9] 1, InstructionNext[10] 0, InstructionNext[11] 0, InstructionNext[12] 1, InstructionNext[13] 0, InstructionNext[14] 0, InstructionNext[15] 0;
        SET MemDataIn[0] 0, MemDataIn[1] 0, MemDataIn[2] 0, MemDataIn[3] 0, MemDataIn[4] 0, MemDataIn[5] 0, MemDataIn[6] 0, MemDataIn[7] 0, MemDataIn[8] 0, MemDataIn[9] 0, MemDataIn[10] 0, MemDataIn[11] 0, MemDataIn[12] 0, MemDataIn[13] 0, MemDataIn[14] 0, MemDataIn[15] 0;
        SET IWait 0, DWait 0;
        EVAL;
        ASSERT Halted 0; ASSERT MemWrite 0;
        SEQ CLK 0 -> CLK 1 -> CLK 0;
        ASSERT PC[0] 1; ASSERT PC[1] 0; ASSERT PC[2] 1; ASSERT PC[3] 0; ASSERT PC[4] 0; ASSERT PC[5] 0; ASSERT PC[6] 0; ASSERT PC[7] 0; ASSERT PC[8] 0; ASSERT PC[9] 0; ASSERT PC[10] 0; ASSERT PC[11] 0; ASSERT PC[12] 0; ASSERT PC[13] 0; ASSERT PC[14] 0; ASSERT PC[15] 0;
        ASSERT FlagZ 0; ASSERT FlagN 0; ASSERT FlagC 0; ASSERT FlagV 0;
        // 0x0005: 0x132A
        SET Instruction[0] 0, Instruction[1] 1, Instruction[2] 0, Instruction[3] 1, Instruction[4] 0, Instruction[5] 1, Instruction[6] 0, Instruction[7] 0, Instruction[8] 1, Instruction[9] 1, Instruction[10] 0, Instruction[11] 0, Instruction[12] 1, Instruction[13] 0, Instruction[14] 0, Instruction[15] 0;
        SET InstructionNext[0] 1, InstructionNext[1] 0, InstructionNext[2] 0, InstructionNext[3] 1, InstructionNext[4] 1, InstructionNext[5] 1, InstructionNext[6] 0, InstructionNext[7] 0, InstructionNext[8] 0, InstructionNext[9] 0, InstructionNext[10] 1, InstructionNext[11] 0, InstructionNext[12] 1, InstructionNext[13] 0, InstructionNext[14] 0, InstructionNext[15] 0;
        SET MemDataIn[0] 0, MemDataIn[1] 0, MemDataIn[2] 0, MemDataIn[3] 0, MemDataIn[4] 0, MemDataIn[5] 0, MemDataIn[6] 0, MemDataIn[7] 0, MemDataIn[8] 0, MemDataIn[9] 0, MemDataIn[10] 0, MemDataIn[11] 0, MemDataIn[12] 0, MemDataIn[13] 0, MemDataIn[14] 0, MemDataIn[15] 0;
        SET IWait 0, DWait 0;
