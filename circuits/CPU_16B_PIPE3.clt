    // Memory, stack, CALL and RET
    //   LI    R1, 0x1000
    //   MOVI  R2, 0x42
    //   SW    R2, R1, 3      ; mem[0x1003] = 0x42
    //   LI    R3, 0xBEEF
    //   SW    R3, R1, 15     ; mem[0x100F]
    //   LW    R4, R1, 3
    //   LW    R5, R1, 15
    //   PUSH  R4
    //   PUSH  R5
    //   POP   R6             ; 0xBEEF
    //   POP   R7             ; 0x42
    //   MOVI  R8, 3
    //   CALL  triple         ; R8 = 9
    //   LI    R9, triple
    //   CALLR R9             ; R8 = 27
    //   LI    R10, after
    //   JR    R10
    //   HALT
    //   after:
    //   ADD   R8, R7         ; 27 + 0x42 = 93
    //   OUT   R8
