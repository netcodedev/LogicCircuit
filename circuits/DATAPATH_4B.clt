// Test suite for the 4-Bit Datapath (Updated for 16-register file)

TESTS FOR DATAPATH_4B {
    // --- Part 1: Register-Register Operations (ALUSrc = 0) ---
    TEST "REG-REG ADD: 8 + 8 (Z=1, Cout=1)" {
        // --- Setup ---
        // Write 8 (1000) to R1 (R0 is hardwired 0)
        SET MemDataIn[0] 0, MemDataIn[1] 0, MemDataIn[2] 0, MemDataIn[3] 1;
        SET WriteAddr[0] 1, WriteAddr[1] 0, WriteAddr[2] 0, WriteAddr[3] 0; // R1
        SET WriteEnable 1;
        SET MemToReg 1; // Select external MemDataIn
        SEQ CLK 0 -> CLK 1 -> CLK 0;

        // Write 8 (1000) to R2
        SET MemDataIn[0] 0, MemDataIn[1] 0, MemDataIn[2] 0, MemDataIn[3] 1;
        SET WriteAddr[0] 0, WriteAddr[1] 1, WriteAddr[2] 0, WriteAddr[3] 0; // R2
        SET WriteEnable 1;
        SET MemToReg 1; 
        SEQ CLK 0 -> CLK 1 -> CLK 0;
        
        SET WriteEnable 0; // Disable writes
        SET MemToReg 0;    // Select ALU.Result for subsequent ops

        // --- Test ---
        // Perform ADD: R1 + R2.
        SET ReadAddrA[0] 1, ReadAddrA[1] 0, ReadAddrA[2] 0, ReadAddrA[3] 0; // Read R1
        SET ReadAddrB[0] 0, ReadAddrB[1] 1, ReadAddrB[2] 0, ReadAddrB[3] 0; // Read R2
        SET ALUSel[0] 0, ALUSel[1] 0; // 00 = ADD
        SET ALUCin 0;
        SET ALUSrc 0; // Select RegFile.DataOutB
        EVAL;

        // --- Assert ---
        // Result is 0 (0000) with a carry
        ASSERT ALU_Z 1;
        ASSERT ALU_Cout 1;
    }

    TEST "REG-REG AND: 5 & 10 (Z=1)" {
        // --- Setup ---
        // Write 5 (0101) to R3
        SET MemDataIn[0] 1, MemDataIn[1] 0, MemDataIn[2] 1, MemDataIn[3] 0;
        SET WriteAddr[0] 1, WriteAddr[1] 1, WriteAddr[2] 0, WriteAddr[3] 0; // R3
        SET WriteEnable 1;
        SET MemToReg 1;
        SEQ CLK 0 -> CLK 1 -> CLK 0;

        // Write 10 (1010) to R4
        SET MemDataIn[0] 0, MemDataIn[1] 1, MemDataIn[2] 0, MemDataIn[3] 1;
        SET WriteAddr[0] 0, WriteAddr[1] 0, WriteAddr[2] 1, WriteAddr[3] 0; // R4
        SET WriteEnable 1;
        SET MemToReg 1;
        SEQ CLK 0 -> CLK 1 -> CLK 0;
        
        SET WriteEnable 0;
        SET MemToReg 0;

        // --- Test ---
        // Perform AND: R3 & R4.
        SET ReadAddrA[0] 1, ReadAddrA[1] 1, ReadAddrA[2] 0, ReadAddrA[3] 0; // Read R3
        SET ReadAddrB[0] 0, ReadAddrB[1] 0, ReadAddrB[2] 1, ReadAddrB[3] 0; // Read R4
        SET ALUSel[0] 1, ALUSel[1] 0; // 01 = AND
        SET ALUSrc 0; // Select RegFile.DataOutB
        EVAL;

        // --- Assert ---
        // Result is 0 (0000)
        ASSERT ALU_Z 1;
        ASSERT ALU_Cout 0;
    }

    // --- Part 2: Register-Immediate Operations (ALUSrc = 1) ---

    TEST "REG-IMM ADDI: 5 + 3 (Z=0, Cout=0)" {
        // --- Setup ---
        // Write 5 (0101) to R1
        SET MemDataIn[0] 1, MemDataIn[1] 0, MemDataIn[2] 1, MemDataIn[3] 0;
        SET WriteAddr[0] 1, WriteAddr[1] 0, WriteAddr[2] 0, WriteAddr[3] 0; // R1
        SET WriteEnable 1;
        SET MemToReg 1;
        SEQ CLK 0 -> CLK 1 -> CLK 0;
        
        SET WriteEnable 0;
        SET MemToReg 0;

        // --- Test ---
        // Perform ADDI: R1 + 3
        SET ReadAddrA[0] 1, ReadAddrA[1] 0, ReadAddrA[2] 0, ReadAddrA[3] 0; // Read R1
        // ReadAddrB is ignored
        SET Immediate[0] 1, Immediate[1] 1, Immediate[2] 0, Immediate[3] 0; // Imm = 3
        SET ALUSel[0] 0, ALUSel[1] 0; // 00 = ADD
        SET ALUCin 0;
        SET ALUSrc 1; // Select Immediate
        EVAL;

        // --- Assert ---
        // Result is 8 (1000)
        ASSERT ALU_Z 0;
        ASSERT ALU_Cout 0;
    }

    TEST "REG-IMM ADDI: 15 + 1 (Z=1, Cout=1)" {
        // --- Setup ---
        // Write 15 (1111) to R2
        SET MemDataIn[0] 1, MemDataIn[1] 1, MemDataIn[2] 1, MemDataIn[3] 1;
        SET WriteAddr[0] 0, WriteAddr[1] 1, WriteAddr[2] 0, WriteAddr[3] 0; // R2
        SET WriteEnable 1;
        SET MemToReg 1;
        SEQ CLK 0 -> CLK 1 -> CLK 0;
        
        SET WriteEnable 0;
        SET MemToReg 0;

        // --- Test ---
        // Perform ADDI: R2 + 1
        SET ReadAddrA[0] 0, ReadAddrA[1] 1, ReadAddrA[2] 0, ReadAddrA[3] 0; // Read R2
        SET Immediate[0] 1, Immediate[1] 0, Immediate[2] 0, Immediate[3] 0; // Imm = 1
        SET ALUSel[0] 0, ALUSel[1] 0; // 00 = ADD
        SET ALUCin 0;
        SET ALUSrc 1; // Select Immediate
        EVAL;

        // --- Assert ---
        // Result is 0 (0000) with a carry
        ASSERT ALU_Z 1;
        ASSERT ALU_Cout 1;
    }

    TEST "REG-IMM XORI: 9 ^ 9 (Z=1)" {
        // --- Setup ---
        // Write 9 (1001) to R3
        SET MemDataIn[0] 1, MemDataIn[1] 0, MemDataIn[2] 0, MemDataIn[3] 1;
        SET WriteAddr[0] 1, WriteAddr[1] 1, WriteAddr[2] 0, WriteAddr[3] 0; // R3
        SET WriteEnable 1;
        SET MemToReg 1;
        SEQ CLK 0 -> CLK 1 -> CLK 0;
        
        SET WriteEnable 0;
        SET MemToReg 0;

        // --- Test ---
        // Perform XORI: R3 ^ 9
        SET ReadAddrA[0] 1, ReadAddrA[1] 1, ReadAddrA[2] 0, ReadAddrA[3] 0; // Read R3
        SET Immediate[0] 1, Immediate[1] 0, Immediate[2] 0, Immediate[3] 1; // Imm = 9
        SET ALUSel[0] 1, ALUSel[1] 1; // 11 = XOR
        SET ALUSrc 1; // Select Immediate
        EVAL;

        // --- Assert ---
        // Result is 0 (0000)
        ASSERT ALU_Z 1;
        ASSERT ALU_Cout 0;
    }

    // --- Part 3: Subtraction (ALUCin=1 -> BInvert path), Result + write-back ---
    TEST "REG-REG SUB: 10 - 3 = 7 (no borrow, Cout=1), write-back R7" {
        // Write 10 (1010) to R5
        SET MemDataIn[0] 0, MemDataIn[1] 1, MemDataIn[2] 0, MemDataIn[3] 1;
        SET WriteAddr[0] 1, WriteAddr[1] 0, WriteAddr[2] 1, WriteAddr[3] 0; // R5
        SET WriteEnable 1; SET MemToReg 1;
        SEQ CLK 0 -> CLK 1 -> CLK 0;
        // Write 3 (0011) to R6
        SET MemDataIn[0] 1, MemDataIn[1] 1, MemDataIn[2] 0, MemDataIn[3] 0;
        SET WriteAddr[0] 0, WriteAddr[1] 1, WriteAddr[2] 1, WriteAddr[3] 0; // R6
        SET WriteEnable 1; SET MemToReg 1;
        SEQ CLK 0 -> CLK 1 -> CLK 0;
        SET WriteEnable 0; SET MemToReg 0;

        // Compute R5 - R6 = 10 - 3
        SET ReadAddrA[0] 1, ReadAddrA[1] 0, ReadAddrA[2] 1, ReadAddrA[3] 0; // R5 (A operand)
        SET ReadAddrB[0] 0, ReadAddrB[1] 1, ReadAddrB[2] 1, ReadAddrB[3] 0; // R6 (B operand)
        SET ALUSel[0] 0, ALUSel[1] 0; // ADD base
        SET ALUCin 1;                 // subtract: invert B, +1
        SET ALUSrc 0;                 // B from register
        EVAL;
        ASSERT Alu.Result[0] 1; ASSERT Alu.Result[1] 1; ASSERT Alu.Result[2] 1; ASSERT Alu.Result[3] 0; // Result = 7 (0111)
        ASSERT ALU_Z 0;
        ASSERT ALU_Cout 1; // 10>=3 -> no borrow

        // Write the ALU result (7) back to R7, then read it
        SET WriteAddr[0] 1, WriteAddr[1] 1, WriteAddr[2] 1, WriteAddr[3] 0; // R7
        SET WriteEnable 1; // MemToReg still 0 -> DataIn = ALU result
        SEQ CLK 0 -> CLK 1 -> CLK 0;
        SET WriteEnable 0;
        ASSERT RegFile.R7.Q[0] 1; ASSERT RegFile.R7.Q[1] 1; ASSERT RegFile.R7.Q[2] 1; ASSERT RegFile.R7.Q[3] 0; // R7 latched 7
    }

    TEST "REG-REG SUB: 3 - 10 = 9 (borrow, Cout=0)" {
        // R5=10, R6=3 from previous test. Compute R6 - R5 = 3 - 10.
        SET ReadAddrA[0] 0, ReadAddrA[1] 1, ReadAddrA[2] 1, ReadAddrA[3] 0; // R6 = 3 (A)
        SET ReadAddrB[0] 1, ReadAddrB[1] 0, ReadAddrB[2] 1, ReadAddrB[3] 0; // R5 = 10 (B)
        SET ALUSel[0] 0, ALUSel[1] 0;
        SET ALUCin 1;
        SET ALUSrc 0;
        SET WriteEnable 0;
        EVAL;
        ASSERT Alu.Result[0] 1; ASSERT Alu.Result[1] 0; ASSERT Alu.Result[2] 0; ASSERT Alu.Result[3] 1; // 3 - 10 = -7 = 9 (1001)
        ASSERT ALU_Z 0;
        ASSERT ALU_Cout 0; // 3<10 -> borrow
    }
}
