CIRCUIT SOC_16B3S {
    // EXPERIMENT (timing only, see ROADMAP_SOC.md): SOC_16B with the 3-stage
    // CPU and the I/O select taken from a register, to check that this cut
    // alone does not speed up the 3-stage design. Does not run programs
    // correctly (the select is one clock late).
    // System on chip: CPU_16B_SOC, memory-mapped peripherals (IO_16B: GPIO,
    // display register, UART) and the 4-digit hex display. The memory bus
    // pins (Addr, DataIn, DataOut, Write, Fetch, Wait) go to the external
    // memory; accesses to the I/O page 0xF0xx are answered inside (they
    // never wait, and Write stays 0 outside for them).
    //
    // The display shows the DISPLAY register of IO_16B, which OUT writes as
    // well, so programs that report their result with OUT show it too.
    //
    // The stack grows down from 0xFFFF and must stay above 0xF0FF.
    //
    // Reset, GpioIn, In and Rx come from outside the clock domain (a button,
    // switches, a reset circuit, a serial line) and pass two-flip-flop
    // synchronizers (SYNC):
    // they act two clocks late, and Reset must be held for at least three
    // clocks. The memory bus (DataIn, Wait) is not synchronized: the external
    // memory (controller) must run on CLK.

    INPUT DataIn[16];   // external memory word at Addr
    INPUT Wait;         // external memory not done yet
    INPUT GpioIn[16];   // asynchronous
    INPUT In[16];       // input port of the IN instruction, asynchronous
    INPUT Rx;           // UART receive line (idles at 1), asynchronous
    INPUT CLK;
    INPUT Reset;        // asynchronous, active-high, hold >= 3 clocks

    OUTPUT Addr[16];
    OUTPUT DataOut[16];
    OUTPUT Write;       // write to the external memory
    OUTPUT ByteEn[2];   // bytes to write: 11 word, 01 low, 10 high (SB)
    OUTPUT Fetch;
    OUTPUT PC[16];
    OUTPUT Halted;
    OUTPUT Out[16];     // output register of the OUT instruction
    OUTPUT GpioOut[16];
    OUTPUT Tx;          // UART
    OUTPUT Seg3[7];     // DISPLAY[15..12], segments a..g
    OUTPUT Seg2[7];
    OUTPUT Seg1[7];
    OUTPUT Seg0[7];     // DISPLAY[3..0]

    // Synchronizers and Io before Cpu: the INIT clock pulses of parts built
    // after the CPU would run it (see CPU_8B); Io's registers only load on
    // CPU writes, which read 0 while the CPU is being built.
    PART ResetSync: SYNC<1>;
    PART GpioSync: SYNC<16>;
    PART InSync: SYNC<16>;
    PART RxSync: SYNC<1>;
    PART Io: IO_16B;
    PART Cpu: CPU_16B_SOC;
    PART Display: HEX_DISPLAY_16B;
    PART DataMux: MUX_2_1_BUS<16>; // external memory, I/O
    PART NotSel: NOT;
    PART WaitAnd: AND;             // Wait only for external accesses
    PART WriteAnd: AND;            // Write only for external accesses
    PART DataReadNor: NOR;         // neither fetch nor write: data read

    CONNECT Cpu.Addr -> Io.Addr;
    CONNECT Cpu.DataOut -> Io.WData;
    CONNECT Cpu.Write -> Io.Write;
    CONNECT GpioIn -> GpioSync.D;
    CONNECT CLK -> GpioSync.CLK;
    CONNECT GpioSync.Q -> Io.GpioIn;
    CONNECT Rx -> RxSync.D[0];
    CONNECT CLK -> RxSync.CLK;
    CONNECT RxSync.Q[0] -> Io.Rx;
    CONNECT Cpu.Fetch -> DataReadNor.in1;
    CONNECT Cpu.Write -> DataReadNor.in2;
    CONNECT DataReadNor.out -> Io.DataRead;
    CONNECT Cpu.OutWrite -> Io.OutWrite;
    CONNECT Cpu.OutData -> Io.OutData;
    CONNECT CLK -> Io.CLK;
    CONNECT Reset -> ResetSync.D[0];
    CONNECT CLK -> ResetSync.CLK;
    CONNECT ResetSync.Q[0] -> Io.Reset;

    CONNECT DataIn -> DataMux.A;
    CONNECT Io.RData -> DataMux.B;
    CONNECT Io.Sel -> DataMux.S;
    CONNECT DataMux.Out -> Cpu.DataIn;
    CONNECT SelR.Q[0] -> NotSel.in;
    CONNECT Wait -> WaitAnd.in1;
    CONNECT NotSel.out -> WaitAnd.in2;
    CONNECT WaitAnd.out -> Cpu.Wait;
    CONNECT Io.Irq -> Cpu.Irq;
    CONNECT In -> InSync.D;
    CONNECT CLK -> InSync.CLK;
    CONNECT InSync.Q -> Cpu.In;
    CONNECT CLK -> Cpu.CLK;
    CONNECT ResetSync.Q[0] -> Cpu.Reset;

    CONNECT Cpu.Addr -> Addr;
    CONNECT Cpu.DataOut -> DataOut;
    CONNECT Cpu.Write -> WriteAnd.in1;
    CONNECT NotSel.out -> WriteAnd.in2;
    CONNECT WriteAnd.out -> Write;
    CONNECT Cpu.ByteEn -> ByteEn;
    CONNECT Cpu.Fetch -> Fetch;
    CONNECT Cpu.PC -> PC;
    CONNECT Cpu.Halted -> Halted;
    CONNECT Cpu.Out -> Out;
    CONNECT Io.GpioOut -> GpioOut;
    CONNECT Io.Tx -> Tx;

    CONNECT Io.Display -> Display.Value;
    CONNECT Display.Seg3 -> Seg3;
    CONNECT Display.Seg2 -> Seg2;
    CONNECT Display.Seg1 -> Seg1;
    CONNECT Display.Seg0 -> Seg0;

    // EXPERIMENT round 3: I/O select known from a register (a real design
    // decodes the memory-stage address in execute and the PC separately).
    PART SelR: REGISTER_R<1>;
    PART C_TRUE5: NOR;
    CONNECT Io.Sel -> SelR.Data[0];
    CONNECT C_TRUE5.out -> SelR.Load;
    CONNECT CLK -> SelR.CLK;
}
