// Tests for the multiply/divide unit (each test continues from the previous one)

TESTS FOR MULDIV_16B {
    TEST "Idle after reset" {
        SET Start 0, Consume 0, Div 0, Reset 1;
        SEQ CLK 0 -> CLK 1 -> CLK 0;
        SET Reset 0;
        EVAL;
        ASSERT Busy 0; ASSERT Done 0;
    }

    TEST "Multiply 1234 * 37" {
        SET A[0] 0, A[1] 1, A[2] 0, A[3] 0, A[4] 1, A[5] 0, A[6] 1, A[7] 1, A[8] 0, A[9] 0, A[10] 1, A[11] 0, A[12] 0, A[13] 0, A[14] 0, A[15] 0;
