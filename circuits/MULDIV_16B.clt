        SEQ CLK 0 -> CLK 1 -> CLK 0;
        ASSERT Busy 1; ASSERT Done 0;
        SEQ CLK 0 -> CLK 1 -> CLK 0;
        ASSERT Busy 0; ASSERT Done 1;
        ASSERT Hi[0] 0; ASSERT Hi[1] 0; ASSERT Hi[2] 0; ASSERT Hi[3] 0; ASSERT Hi[4] 0; ASSERT Hi[5] 0; ASSERT Hi[6] 0; ASSERT Hi[7] 0; ASSERT Hi[8] 0; ASSERT Hi[9] 0; ASSERT Hi[10] 0; ASSERT Hi[11] 0; ASSERT Hi[12] 0; ASSERT Hi[13] 0; ASSERT Hi[14] 0; ASSERT Hi[15] 0;
        ASSERT Lo[0] 0; ASSERT Lo[1] 1; ASSERT Lo[2] 0; ASSERT Lo[3] 1; ASSERT Lo[4] 1; ASSERT Lo[5] 0; ASSERT Lo[6] 1; ASSERT Lo[7] 0; ASSERT Lo[8] 0; ASSERT Lo[9] 1; ASSERT Lo[10] 0; ASSERT Lo[11] 0; ASSERT Lo[12] 1; ASSERT Lo[13] 1; ASSERT Lo[14] 0; ASSERT Lo[15] 1;
