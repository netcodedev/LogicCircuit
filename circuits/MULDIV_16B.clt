        ASSERT Busy 1; ASSERT Done 0;
        SEQ CLK 0 -> CLK 1 -> CLK 0;
        SEQ CLK 0 -> CLK 1 -> CLK 0;
        SEQ CLK 0 -> CLK 1 -> CLK 0;
        SEQ CLK 0 -> CLK 1 -> CLK 0;
        SEQ CLK 0 -> CLK 1 -> CLK 0;
