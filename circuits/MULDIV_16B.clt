        ASSERT Lo[0] 1; ASSERT Lo[1] 1; ASSERT Lo[2] 1; ASSERT Lo[3] 1; ASSERT Lo[4] 1; ASSERT Lo[5] 1; ASSERT Lo[6] 1; ASSERT Lo[7] 1; ASSERT Lo[8] 1; ASSERT Lo[9] 1; ASSERT Lo[10] 1; ASSERT Lo[11] 1; ASSERT Lo[12] 1; ASSERT Lo[13] 1; ASSERT Lo[14] 1; ASSERT Lo[15] 1;
        SET Consume 1;
        SEQ CLK 0 -> CLK 1 -> CLK 0;
        SET Consume 0;
        ASSERT Done 0; ASSERT Busy 0;
    }
}
