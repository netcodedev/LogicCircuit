// Tests for COND_16B: every condition against every combination of Z, N, C, V.

TESTS FOR COND_16B {
    TEST "EQ (cond 0)" {
        SET Cond[0] 0, Cond[1] 0, Cond[2] 0, Cond[3] 0;
        SET Z 0, N 0, C 0, V 0; EVAL; ASSERT Take 0;
        SET Z 1, N 0, C 0, V 0; EVAL; ASSERT Take 1;
        SET Z 0, N 1, C 0, V 0; EVAL; ASSERT Take 0;
        SET Z 1, N 1, C 0, V 0; EVAL; ASSERT Take 1;
        SET Z 0, N 0, C 1, V 0; EVAL; ASSERT Take 0;
