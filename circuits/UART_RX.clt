// Tests for the UART receiver: frames bit by bit at three bit times (each test continues from the previous one)

TESTS FOR UART_RX {
    TEST "Idle after reset" {
        SET Rx 1, Read 0, Reset 1;
        SEQ CLK 0 -> CLK 1 -> CLK 0;
        SET Reset 0;
        SEQ CLK 0 -> CLK 1 -> CLK 0;
        ASSERT Ready 0; ASSERT Busy 0;
    }

    TEST "Div = 1: receive 0x41" {
        SET Div[0] 1, Div[1] 0, Div[2] 0, Div[3] 0, Div[4] 0, Div[5] 0, Div[6] 0, Div[7] 0, Div[8] 0, Div[9] 0, Div[10] 0, Div[11] 0, Div[12] 0, Div[13] 0, Div[14] 0, Div[15] 0;
        SET Rx 1, Read 0;
        SEQ CLK 0 -> CLK 1 -> CLK 0;
        SEQ CLK 0 -> CLK 1 -> CLK 0;
        SET Rx 0;
        SEQ CLK 0 -> CLK 1 -> CLK 0;
        SEQ CLK 0 -> CLK 1 -> CLK 0;
        SET Rx 1;
        SEQ CLK 0 -> CLK 1 -> CLK 0;
        SEQ CLK 0 -> CLK 1 -> CLK 0;
        SET Rx 0;
        SEQ CLK 0 -> CLK 1 -> CLK 0;
        SEQ CLK 0 -> CLK 1 -> CLK 0;
        SET Rx 0;
        SEQ CLK 0 -> CLK 1 -> CLK 0;
        SEQ CLK 0 -> CLK 1 -> CLK 0;
        SET Rx 0;
        SEQ CLK 0 -> CLK 1 -> CLK 0;
        SEQ CLK 0 -> CLK 1 -> CLK 0;
        SET Rx 0;
        SEQ CLK 0 -> CLK 1 -> CLK 0;
        SEQ CLK 0 -> CLK 1 -> CLK 0;
        SET Rx 0;
        SEQ CLK 0 -> CLK 1 -> CLK 0;
        SEQ CLK 0 -> CLK 1 -> CLK 0;
        SET Rx 1;
        SEQ CLK 0 -> CLK 1 -> CLK 0;
        SEQ CLK 0 -> CLK 1 -> CLK 0;
        SET Rx 0;
        SEQ CLK 0 -> CLK 1 -> CLK 0;
        SEQ CLK 0 -> CLK 1 -> CLK 0;
        SET Rx 1;
        SEQ CLK 0 -> CLK 1 -> CLK 0;
        SEQ CLK 0 -> CLK 1 -> CLK 0;
        SET Rx 1;
        SEQ CLK 0 -> CLK 1 -> CLK 0;
        SEQ CLK 0 -> CLK 1 -> CLK 0;
        SEQ CLK 0 -> CLK 1 -> CLK 0;
        ASSERT Ready 1; ASSERT Busy 0;
        ASSERT Data[0] 1; ASSERT Data[1] 0; ASSERT Data[2] 0; ASSERT Data[3] 0; ASSERT Data[4] 0; ASSERT Data[5] 0; ASSERT Data[6] 1; ASSERT Data[7] 0;
        SET Read 1;
        SEQ CLK 0 -> CLK 1 -> CLK 0;
        SET Read 0;
        ASSERT Ready 0;
    }

    TEST "Div = 1: receive 0xC8" {
        SET Div[0] 1, Div[1] 0, Div[2] 0, Div[3] 0, Div[4] 0, Div[5] 0, Div[6] 0, Div[7] 0, Div[8] 0, Div[9] 0, Div[10] 0, Div[11] 0, Div[12] 0, Div[13] 0, Div[14] 0, Div[15] 0;
        SET Rx 1, Read 0;
        SEQ CLK 0 -> CLK 1 -> CLK 0;
        SEQ CLK 0 -> CLK 1 -> CLK 0;
        SET Rx 0;
        SEQ CLK 0 -> CLK 1 -> CLK 0;
        SEQ CLK 0 -> CLK 1 -> CLK 0;
        SET Rx 0;
        SEQ CLK 0 -> CLK 1 -> CLK 0;
        SEQ CLK 0 -> CLK 1 -> CLK 0;
        SET Rx 0;
        SEQ CLK 0 -> CLK 1 -> CLK 0;
        SEQ CLK 0 -> CLK 1 -> CLK 0;
        SET Rx 0;
        SEQ CLK 0 -> CLK 1 -> CLK 0;
        SEQ CLK 0 -> CLK 1 -> CLK 0;
        SET Rx 1;
        SEQ CLK 0 -> CLK 1 -> CLK 0;
        SEQ CLK 0 -> CLK 1 -> CLK 0;
        SET Rx 0;
        SEQ CLK 0 -> CLK 1 -> CLK 0;
        SEQ CLK 0 -> CLK 1 -> CLK 0;
        SET Rx 0;
        SEQ CLK 0 -> CLK 1 -> CLK 0;
        SEQ CLK 0 -> CLK 1 -> CLK 0;
        SET Rx 1;
        SEQ CLK 0 -> CLK 1 -> CLK 0;
        SEQ CLK 0 -> CLK 1 -> CLK 0;
        SET Rx 1;
        SEQ CLK 0 -> CLK 1 -> CLK 0;
        SEQ CLK 0 -> CLK 1 -> CLK 0;
        SET Rx 1;
        SEQ CLK 0 -> CLK 1 -> CLK 0;
        SEQ CLK 0 -> CLK 1 -> CLK 0;
        SET Rx 1;
        SEQ CLK 0 -> CLK 1 -> CLK 0;
        SEQ CLK 0 -> CLK 1 -> CLK 0;
        SEQ CLK 0 -> CLK 1 -> CLK 0;
        ASSERT Ready 1; ASSERT Busy 0;
        ASSERT Data[0] 0; ASSERT Data[1] 0; ASSERT Data[2] 0; ASSERT Data[3] 1; ASSERT Data[4] 0; ASSERT Data[5] 0; ASSERT Data[6] 1; ASSERT Data[7] 1;
        SET Read 1;
        SEQ CLK 0 -> CLK 1 -> CLK 0;
        SET Read 0;
        ASSERT Ready 0;
    }

    TEST "Div = 0: receive 0x55" {
        SET Div[0] 0, Div[1] 0, Div[2] 0, Div[3] 0, Div[4] 0, Div[5] 0, Div[6] 0, Div[7] 0, Div[8] 0, Div[9] 0, Div[10] 0, Div[11] 0, Div[12] 0, Div[13] 0, Div[14] 0, Div[15] 0;
        SET Rx 1, Read 0;
        SEQ CLK 0 -> CLK 1 -> CLK 0;
        SEQ CLK 0 -> CLK 1 -> CLK 0;
        SET Rx 0;
        SEQ CLK 0 -> CLK 1 -> CLK 0;
        SET Rx 1;
        SEQ CLK 0 -> CLK 1 -> CLK 0;
        SET Rx 0;
        SEQ CLK 0 -> CLK 1 -> CLK 0;
        SET Rx 1;
        SEQ CLK 0 -> CLK 1 -> CLK 0;
        SET Rx 0;
        SEQ CLK 0 -> CLK 1 -> CLK 0;
        SET Rx 1;
        SEQ CLK 0 -> CLK 1 -> CLK 0;
        SET Rx 0;
        SEQ CLK 0 -> CLK 1 -> CLK 0;
        SET Rx 1;
        SEQ CLK 0 -> CLK 1 -> CLK 0;
        SET Rx 0;
        SEQ CLK 0 -> CLK 1 -> CLK 0;
        SET Rx 1;
        SEQ CLK 0 -> CLK 1 -> CLK 0;
        SET Rx 1;
        SEQ CLK 0 -> CLK 1 -> CLK 0;
        SEQ CLK 0 -> CLK 1 -> CLK 0;
        ASSERT Ready 1; ASSERT Busy 0;
        ASSERT Data[0] 1; ASSERT Data[1] 0; ASSERT Data[2] 1; ASSERT Data[3] 0; ASSERT Data[4] 1; ASSERT Data[5] 0; ASSERT Data[6] 1; ASSERT Data[7] 0;
        SET Read 1;
        SEQ CLK 0 -> CLK 1 -> CLK 0;
        SET Read 0;
        ASSERT Ready 0;
    }

    TEST "Div = 3: receive 0x4B" {
        SET Div[0] 1, Div[1] 1, Div[2] 0, Div[3] 0, Div[4] 0, Div[5] 0, Div[6] 0, Div[7] 0, Div[8] 0, Div[9] 0, Div[10] 0, Div[11] 0, Div[12] 0, Div[13] 0, Div[14] 0, Div[15] 0;
        SET Rx 1, Read 0;
        SEQ CLK 0 -> CLK 1 -> CLK 0;
        SEQ CLK 0 -> CLK 1 -> CLK 0;
        SET Rx 0;
        SEQ CLK 0 -> CLK 1 -> CLK 0;
        SEQ CLK 0 -> CLK 1 -> CLK 0;
        SEQ CLK 0 -> CLK 1 -> CLK 0;
        SEQ CLK 0 -> CLK 1 -> CLK 0;
        SET Rx 1;
        SEQ CLK 0 -> CLK 1 -> CLK 0;
        SEQ CLK 0 -> CLK 1 -> CLK 0;
        SEQ CLK 0 -> CLK 1 -> CLK 0;
        SEQ CLK 0 -> CLK 1 -> CLK 0;
        SET Rx 1;
        SEQ CLK 0 -> CLK 1 -> CLK 0;
        SEQ CLK 0 -> CLK 1 -> CLK 0;
        SEQ CLK 0 -> CLK 1 -> CLK 0;
        SEQ CLK 0 -> CLK 1 -> CLK 0;
        SET Rx 0;
        SEQ CLK 0 -> CLK 1 -> CLK 0;
        SEQ CLK 0 -> CLK 1 -> CLK 0;
        SEQ CLK 0 -> CLK 1 -> CLK 0;
        SEQ CLK 0 -> CLK 1 -> CLK 0;
        SET Rx 1;
        SEQ CLK 0 -> CLK 1 -> CLK 0;
        SEQ CLK 0 -> CLK 1 -> CLK 0;
        SEQ CLK 0 -> CLK 1 -> CLK 0;
        SEQ CLK 0 -> CLK 1 -> CLK 0;
        SET Rx 0;
        SEQ CLK 0 -> CLK 1 -> CLK 0;
        SEQ CLK 0 -> CLK 1 -> CLK 0;
        SEQ CLK 0 -> CLK 1 -> CLK 0;
        SEQ CLK 0 -> CLK 1 -> CLK 0;
        SET Rx 0;
        SEQ CLK 0 -> CLK 1 -> CLK 0;
        SEQ CLK 0 -> CLK 1 -> CLK 0;
        SEQ CLK 0 -> CLK 1 -> CLK 0;
        SEQ CLK 0 -> CLK 1 -> CLK 0;
        SET Rx 1;
        SEQ CLK 0 -> CLK 1 -> CLK 0;
        SEQ CLK 0 -> CLK 1 -> CLK 0;
        SEQ CLK 0 -> CLK 1 -> CLK 0;
        SEQ CLK 0 -> CLK 1 -> CLK 0;
        SET Rx 0;
        SEQ CLK 0 -> CLK 1 -> CLK 0;
        SEQ CLK 0 -> CLK 1 -> CLK 0;
        SEQ CLK 0 -> CLK 1 -> CLK 0;
        SEQ CLK 0 -> CLK 1 -> CLK 0;
        SET Rx 1;
        SEQ CLK 0 -> CLK 1 -> CLK 0;
        SEQ CLK 0 -> CLK 1 -> CLK 0;
        SEQ CLK 0 -> CLK 1 -> CLK 0;
        SEQ CLK 0 -> CLK 1 -> CLK 0;
        SET Rx 1;
        SEQ CLK 0 -> CLK 1 -> CLK 0;
        SEQ CLK 0 -> CLK 1 -> CLK 0;
        SEQ CLK 0 -> CLK 1 -> CLK 0;
        SEQ CLK 0 -> CLK 1 -> CLK 0;
        SEQ CLK 0 -> CLK 1 -> CLK 0;
        ASSERT Ready 1; ASSERT Busy 0;
        ASSERT Data[0] 1; ASSERT Data[1] 1; ASSERT Data[2] 0; ASSERT Data[3] 1; ASSERT Data[4] 0; ASSERT Data[5] 0; ASSERT Data[6] 1; ASSERT Data[7] 0;
        SET Read 1;
        SEQ CLK 0 -> CLK 1 -> CLK 0;
        SET Read 0;
        ASSERT Ready 0;
    }

    TEST "Div = 3: receive 0xFF" {
        SET Div[0] 1, Div[1] 1, Div[2] 0, Div[3] 0, Div[4] 0, Div[5] 0, Div[6] 0, Div[7] 0, Div[8] 0, Div[9] 0, Div[10] 0, Div[11] 0, Div[12] 0, Div[13] 0, Div[14] 0, Div[15] 0;
        SET Rx 1, Read 0;
        SEQ CLK 0 -> CLK 1 -> CLK 0;
        SEQ CLK 0 -> CLK 1 -> CLK 0;
        SET Rx 0;
        SEQ CLK 0 -> CLK 1 -> CLK 0;
        SEQ CLK 0 -> CLK 1 -> CLK 0;
        SEQ CLK 0 -> CLK 1 -> CLK 0;
        SEQ CLK 0 -> CLK 1 -> CLK 0;
        SET Rx 1;
        SEQ CLK 0 -> CLK 1 -> CLK 0;
        SEQ CLK 0 -> CLK 1 -> CLK 0;
        SEQ CLK 0 -> CLK 1 -> CLK 0;
        SEQ CLK 0 -> CLK 1 -> CLK 0;
        SET Rx 1;
        SEQ CLK 0 -> CLK 1 -> CLK 0;
        SEQ CLK 0 -> CLK 1 -> CLK 0;
        SEQ CLK 0 -> CLK 1 -> CLK 0;
        SEQ CLK 0 -> CLK 1 -> CLK 0;
        SET Rx 1;
        SEQ CLK 0 -> CLK 1 -> CLK 0;
        SEQ CLK 0 -> CLK 1 -> CLK 0;
        SEQ CLK 0 -> CLK 1 -> CLK 0;
        SEQ CLK 0 -> CLK 1 -> CLK 0;
        SET Rx 1;
        SEQ CLK 0 -> CLK 1 -> CLK 0;
        SEQ CLK 0 -> CLK 1 -> CLK 0;
        SEQ CLK 0 -> CLK 1 -> CLK 0;
        SEQ CLK 0 -> CLK 1 -> CLK 0;
        SET Rx 1;
        SEQ CLK 0 -> CLK 1 -> CLK 0;
        SEQ CLK 0 -> CLK 1 -> CLK 0;
        SEQ CLK 0 -> CLK 1 -> CLK 0;
        SEQ CLK 0 -> CLK 1 -> CLK 0;
        SET Rx 1;
        SEQ CLK 0 -> CLK 1 -> CLK 0;
        SEQ CLK 0 -> CLK 1 -> CLK 0;
        SEQ CLK 0 -> CLK 1 -> CLK 0;
        SEQ CLK 0 -> CLK 1 -> CLK 0;
        SET Rx 1;
        SEQ CLK 0 -> CLK 1 -> CLK 0;
        SEQ CLK 0 -> CLK 1 -> CLK 0;
        SEQ CLK 0 -> CLK 1 -> CLK 0;
        SEQ CLK 0 -> CLK 1 -> CLK 0;
        SET Rx 1;
        SEQ CLK 0 -> CLK 1 -> CLK 0;
        SEQ CLK 0 -> CLK 1 -> CLK 0;
        SEQ CLK 0 -> CLK 1 -> CLK 0;
        SEQ CLK 0 -> CLK 1 -> CLK 0;
        SET Rx 1;
        SEQ CLK 0 -> CLK 1 -> CLK 0;
        SEQ CLK 0 -> CLK 1 -> CLK 0;
        SEQ CLK 0 -> CLK 1 -> CLK 0;
        SEQ CLK 0 -> CLK 1 -> CLK 0;
        SET Rx 1;
        SEQ CLK 0 -> CLK 1 -> CLK 0;
        SEQ CLK 0 -> CLK 1 -> CLK 0;
        SEQ CLK 0 -> CLK 1 -> CLK 0;
        SEQ CLK 0 -> CLK 1 -> CLK 0;
        SEQ CLK 0 -> CLK 1 -> CLK 0;
        ASSERT Ready 1; ASSERT Busy 0;
        ASSERT Data[0] 1; ASSERT Data[1] 1; ASSERT Data[2] 1; ASSERT Data[3] 1; ASSERT Data[4] 1; ASSERT Data[5] 1; ASSERT Data[6] 1; ASSERT Data[7] 1;
        SET Read 1;
        SEQ CLK 0 -> CLK 1 -> CLK 0;
        SET Read 0;
        ASSERT Ready 0;
    }
}
