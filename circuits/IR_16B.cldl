CIRCUIT IR_16B {
    // Instruction register of CPU_16B_PIPE(3): holds the instruction word and
    // the word after it (second word of LI/JMP/CALL) between the fetch and
    // the execute stage. On the rising CLK edge:
    //   Reset = 1 or Flush = 1 -> Q <- NOP (0x0001), QNext <- unchanged
    //   Load = 1               -> Q <- Data, QNext <- DataNext
    //   otherwise              -> hold
    // The word itself is an IR_WORD_16B. QNext needs no clear: it only
    // matters for two-word instructions. It is still a REGISTER_R: a plain
    // REGISTER drives its Load input in its own INIT, and Load is shared
    // with the PC enable in CPU_16B_PIPE, so the PC would count while the
    // CPU is being built.
    INPUT Data[16];
    INPUT DataNext[16];
    INPUT Flush;        // 1 = replace the instruction by a NOP (taken jump)
    INPUT Load;
    INPUT Reset;
    INPUT CLK;

    OUTPUT Q[16];
    OUTPUT QNext[16];

    // Registers first: their INITs run before the gates driving them exist.
    PART Word: IR_WORD_16B;
    PART RegNext: REGISTER_R<16>; // Reset unconnected (0)

    CONNECT Data -> Word.Data;
    CONNECT Flush -> Word.Flush;
    CONNECT Load -> Word.Load;
    CONNECT Reset -> Word.Reset;
    CONNECT CLK -> Word.CLK;
    CONNECT Word.Q -> Q;

    CONNECT DataNext -> RegNext.Data;
    CONNECT RegNext.Q -> QNext;
    CONNECT Load -> RegNext.Load;
    CONNECT CLK -> RegNext.CLK;
}
