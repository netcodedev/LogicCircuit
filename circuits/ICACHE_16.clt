    TEST "Store elsewhere at the same index keeps the entry" {
        SET BusAddr[0] 1, BusAddr[1] 1, BusAddr[2] 0, BusAddr[3] 0, BusAddr[4] 0, BusAddr[5] 0, BusAddr[6] 0, BusAddr[7] 0, BusAddr[8] 1, BusAddr[9] 1, BusAddr[10] 1, BusAddr[11] 1, BusAddr[12] 0, BusAddr[13] 0, BusAddr[14] 0, BusAddr[15] 0;
