// Tests for the 16-bit zero detector

TESTS FOR ZERO_16B {
    TEST "0x0000 -> Z=1" {
        SET A[0] 0, A[1] 0, A[2] 0, A[3] 0, A[4] 0, A[5] 0, A[6] 0, A[7] 0, A[8] 0, A[9] 0, A[10] 0, A[11] 0, A[12] 0, A[13] 0, A[14] 0, A[15] 0;
        EVAL;
        ASSERT Z 1;
    }

    TEST "0x0001 -> Z=0" {
        SET A[0] 1, A[1] 0, A[2] 0, A[3] 0, A[4] 0, A[5] 0, A[6] 0, A[7] 0, A[8] 0, A[9] 0, A[10] 0, A[11] 0, A[12] 0, A[13] 0, A[14] 0, A[15] 0;
        EVAL;
        ASSERT Z 0;
    }

    TEST "0x8000 -> Z=0" {
        SET A[0] 0, A[1] 0, A[2] 0, A[3] 0, A[4] 0, A[5] 0, A[6] 0, A[7] 0, A[8] 0, A[9] 0, A[10] 0, A[11] 0, A[12] 0, A[13] 0, A[14] 0, A[15] 1;
        EVAL;
        ASSERT Z 0;
    }

    TEST "0x0100 -> Z=0" {
        SET A[0] 0, A[1] 0, A[2] 0, A[3] 0, A[4] 0, A[5] 0, A[6] 0, A[7] 0, A[8] 1, A[9] 0, A[10] 0, A[11] 0, A[12] 0, A[13] 0, A[14] 0, A[15] 0;
        EVAL;
        ASSERT Z 0;
    }

    TEST "0x0010 -> Z=0" {
        SET A[0] 0, A[1] 0, A[2] 0, A[3] 0, A[4] 1, A[5] 0, A[6] 0, A[7] 0, A[8] 0, A[9] 0, A[10] 0, A[11] 0, A[12] 0, A[13] 0, A[14] 0, A[15] 0;
        EVAL;
        ASSERT Z 0;
    }

    TEST "0xFFFF -> Z=0" {
        SET A[0] 1, A[1] 1, A[2] 1, A[3] 1, A[4] 1, A[5] 1, A[6] 1, A[7] 1, A[8] 1, A[9] 1, A[10] 1, A[11] 1, A[12] 1, A[13] 1, A[14] 1, A[15] 1;
        EVAL;
        ASSERT Z 0;
    }
}
