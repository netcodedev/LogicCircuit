CIRCUIT XOR_BUS<W> {
    // Bitwise XOR of two W-bit buses (one XOR gate per bit, like XOR_8B).
    INPUT A[W];
    INPUT B[W];

    OUTPUT Out[W];

    FOR i IN 0..W {
        PART G[i]: XOR;
        CONNECT A[i] -> G[i].in1;
        CONNECT B[i] -> G[i].in2;
        CONNECT G[i].out -> Out[i];
    }
}
