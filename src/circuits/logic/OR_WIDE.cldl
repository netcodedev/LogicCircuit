CIRCUIT OR_WIDE<G> {
    // OR over 4*G inputs: one NOR4 per group of four (true if the group is
    // all 0), an AND chain over the groups (true if all inputs are 0), and a
    // final NOT. Unused inputs read 0, so any number of terms up to 4*G
    // can be connected. Used for the OR trees of control units.
    INPUT In[4*G];

    OUTPUT Out;

    PART C_TRUE: NOR; // Constant 1 (VCC), NOR(0,0) = 1: start of the chain
    FOR g IN 0..G {
        PART Nib[g]: NOR4;
        CONNECT In[4*g] -> Nib[g].A;
        CONNECT In[4*g+1] -> Nib[g].B;
        CONNECT In[4*g+2] -> Nib[g].C;
        CONNECT In[4*g+3] -> Nib[g].D;
        PART Chain[g]: AND;
        CONNECT Nib[g].Out -> Chain[g].in1;
    }
    CONNECT C_TRUE.out -> Chain[0].in2;
    FOR g IN 1..G {
        CONNECT Chain[g-1].out -> Chain[g].in2;
    }
    PART Invert: NOT;
    CONNECT Chain[G-1].out -> Invert.in;
    CONNECT Invert.out -> Out;
}
