// Tests for XOR_BUS<W>

TESTS FOR XOR_BUS<4> {
    TEST "0x000C XOR 0x000A" {
        SET A[0] 0, A[1] 0, A[2] 1, A[3] 1;
        SET B[0] 0, B[1] 1, B[2] 0, B[3] 1;
        EVAL;
        ASSERT Out[0] 0; ASSERT Out[1] 1; ASSERT Out[2] 1; ASSERT Out[3] 0;
    }

    TEST "0x000F XOR 0x0005" {
        SET A[0] 1, A[1] 1, A[2] 1, A[3] 1;
        SET B[0] 1, B[1] 0, B[2] 1, B[3] 0;
        EVAL;
        ASSERT Out[0] 0; ASSERT Out[1] 1; ASSERT Out[2] 0; ASSERT Out[3] 1;
    }
}

TESTS FOR XOR_BUS<16> {
    TEST "0xF0F0 XOR 0xFF00" {
        SET A[0] 0, A[1] 0, A[2] 0, A[3] 0, A[4] 1, A[5] 1, A[6] 1, A[7] 1, A[8] 0, A[9] 0, A[10] 0, A[11] 0, A[12] 1, A[13] 1, A[14] 1, A[15] 1;
        SET B[0] 0, B[1] 0, B[2] 0, B[3] 0, B[4] 0, B[5] 0, B[6] 0, B[7] 0, B[8] 1, B[9] 1, B[10] 1, B[11] 1, B[12] 1, B[13] 1, B[14] 1, B[15] 1;
        EVAL;
        ASSERT Out[0] 0; ASSERT Out[1] 0; ASSERT Out[2] 0; ASSERT Out[3] 0; ASSERT Out[4] 1; ASSERT Out[5] 1; ASSERT Out[6] 1; ASSERT Out[7] 1; ASSERT Out[8] 1; ASSERT Out[9] 1; ASSERT Out[10] 1; ASSERT Out[11] 1; ASSERT Out[12] 0; ASSERT Out[13] 0; ASSERT Out[14] 0; ASSERT Out[15] 0;
    }

    TEST "0x1234 XOR 0xFFFF" {
        SET A[0] 0, A[1] 0, A[2] 1, A[3] 0, A[4] 1, A[5] 1, A[6] 0, A[7] 0, A[8] 0, A[9] 1, A[10] 0, A[11] 0, A[12] 1, A[13] 0, A[14] 0, A[15] 0;
        SET B[0] 1, B[1] 1, B[2] 1, B[3] 1, B[4] 1, B[5] 1, B[6] 1, B[7] 1, B[8] 1, B[9] 1, B[10] 1, B[11] 1, B[12] 1, B[13] 1, B[14] 1, B[15] 1;
        EVAL;
        ASSERT Out[0] 1; ASSERT Out[1] 1; ASSERT Out[2] 0; ASSERT Out[3] 1; ASSERT Out[4] 0; ASSERT Out[5] 0; ASSERT Out[6] 1; ASSERT Out[7] 1; ASSERT Out[8] 1; ASSERT Out[9] 0; ASSERT Out[10] 1; ASSERT Out[11] 1; ASSERT Out[12] 0; ASSERT Out[13] 1; ASSERT Out[14] 1; ASSERT Out[15] 1;
    }

    TEST "0x0000 XOR 0xA5A5" {
        SET A[0] 0, A[1] 0, A[2] 0, A[3] 0, A[4] 0, A[5] 0, A[6] 0, A[7] 0, A[8] 0, A[9] 0, A[10] 0, A[11] 0, A[12] 0, A[13] 0, A[14] 0, A[15] 0;
        SET B[0] 1, B[1] 0, B[2] 1, B[3] 0, B[4] 0, B[5] 1, B[6] 0, B[7] 1, B[8] 1, B[9] 0, B[10] 1, B[11] 0, B[12] 0, B[13] 1, B[14] 0, B[15] 1;
        EVAL;
        ASSERT Out[0] 1; ASSERT Out[1] 0; ASSERT Out[2] 1; ASSERT Out[3] 0; ASSERT Out[4] 0; ASSERT Out[5] 1; ASSERT Out[6] 0; ASSERT Out[7] 1; ASSERT Out[8] 1; ASSERT Out[9] 0; ASSERT Out[10] 1; ASSERT Out[11] 0; ASSERT Out[12] 0; ASSERT Out[13] 1; ASSERT Out[14] 0; ASSERT Out[15] 1;
    }
}
