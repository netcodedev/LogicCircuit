CIRCUIT OR_4B {
    // Inputs: Two 4-bit data buses (A0-A3, B0-B3)
    INPUT A0, A1, A2, A3;
    INPUT B0, B1, B2, B3;

    // Output: 4-bit result of bitwise OR (Out0-Out3)
    OUTPUT Out0, Out1, Out2, Out3;

    PART OR0: OR; // For bit 0
    PART OR1: OR; // For bit 1
    PART OR2: OR; // For bit 2
    PART OR3: OR; // For bit 3

    CONNECT A0 -> OR0.in1;
    CONNECT B0 -> OR0.in2;
    CONNECT OR0.out -> Out0;

    CONNECT A1 -> OR1.in1;
    CONNECT B1 -> OR1.in2;
    CONNECT OR1.out -> Out1;

    CONNECT A2 -> OR2.in1;
    CONNECT B2 -> OR2.in2;
    CONNECT OR2.out -> Out2;

    CONNECT A3 -> OR3.in1;
    CONNECT B3 -> OR3.in2;
    CONNECT OR3.out -> Out3;
}
