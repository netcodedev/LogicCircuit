CIRCUIT AND_4B {
    // Inputs: Two 4-bit data buses
    INPUT A[4];
    INPUT B[4];

    // Output: 4-bit result of bitwise AND
    OUTPUT Out[4];

    PART AND0: AND; // For bit 0
    PART AND1: AND; // For bit 1
    PART AND2: AND; // For bit 2
    PART AND3: AND; // For bit 3

    CONNECT A[0] -> AND0.in1;
    CONNECT B[0] -> AND0.in2;
    CONNECT AND0.out -> Out[0];

    CONNECT A[1] -> AND1.in1;
    CONNECT B[1] -> AND1.in2;
    CONNECT AND1.out -> Out[1];

    CONNECT A[2] -> AND2.in1;
    CONNECT B[2] -> AND2.in2;
    CONNECT AND2.out -> Out[2];

    CONNECT A[3] -> AND3.in1;
    CONNECT B[3] -> AND3.in2;
    CONNECT AND3.out -> Out[3];
}
