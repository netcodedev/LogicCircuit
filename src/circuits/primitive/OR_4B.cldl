CIRCUIT OR_4B {
    // Inputs: Two 4-bit data buses
    INPUT A[4];
    INPUT B[4];

    // Output: 4-bit result of bitwise OR
    OUTPUT Out[4];

    PART OR0: OR; // For bit 0
    PART OR1: OR; // For bit 1
    PART OR2: OR; // For bit 2
    PART OR3: OR; // For bit 3

    CONNECT A[0] -> OR0.in1;
    CONNECT B[0] -> OR0.in2;
    CONNECT OR0.out -> Out[0];

    CONNECT A[1] -> OR1.in1;
    CONNECT B[1] -> OR1.in2;
    CONNECT OR1.out -> Out[1];

    CONNECT A[2] -> OR2.in1;
    CONNECT B[2] -> OR2.in2;
    CONNECT OR2.out -> Out[2];

    CONNECT A[3] -> OR3.in1;
    CONNECT B[3] -> OR3.in2;
    CONNECT OR3.out -> Out[3];
}
