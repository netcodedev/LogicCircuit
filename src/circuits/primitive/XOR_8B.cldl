CIRCUIT XOR_8B {
    // Inputs: Two 8-bit data buses
    INPUT A[8];
    INPUT B[8];

    // Output: 8-bit result of bitwise XOR
    OUTPUT Out[8];

    PART XOR0: XOR; // For bit 0
    PART XOR1: XOR; // For bit 1
    PART XOR2: XOR; // For bit 2
    PART XOR3: XOR; // For bit 3
    PART XOR4: XOR; // For bit 4
    PART XOR5: XOR; // For bit 5
    PART XOR6: XOR; // For bit 6
    PART XOR7: XOR; // For bit 7

    CONNECT A[0] -> XOR0.in1;
    CONNECT B[0] -> XOR0.in2;
    CONNECT XOR0.out -> Out[0];

    CONNECT A[1] -> XOR1.in1;
    CONNECT B[1] -> XOR1.in2;
    CONNECT XOR1.out -> Out[1];

    CONNECT A[2] -> XOR2.in1;
    CONNECT B[2] -> XOR2.in2;
    CONNECT XOR2.out -> Out[2];

    CONNECT A[3] -> XOR3.in1;
    CONNECT B[3] -> XOR3.in2;
    CONNECT XOR3.out -> Out[3];

    CONNECT A[4] -> XOR4.in1;
    CONNECT B[4] -> XOR4.in2;
    CONNECT XOR4.out -> Out[4];

    CONNECT A[5] -> XOR5.in1;
    CONNECT B[5] -> XOR5.in2;
    CONNECT XOR5.out -> Out[5];

    CONNECT A[6] -> XOR6.in1;
    CONNECT B[6] -> XOR6.in2;
    CONNECT XOR6.out -> Out[6];

    CONNECT A[7] -> XOR7.in1;
    CONNECT B[7] -> XOR7.in2;
    CONNECT XOR7.out -> Out[7];

}
