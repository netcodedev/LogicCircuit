// Test suite for the 4-Bit Bitwise AND unit

TESTS FOR AND_4B {
    TEST "Test Case 0 AND 0" {
        SET A[0] 0, A[1] 0, A[2] 0, A[3] 0;
        SET B[0] 0, B[1] 0, B[2] 0, B[3] 0;
        EVAL;
        ASSERT Out[0] 0;
        ASSERT Out[1] 0;
        ASSERT Out[2] 0;
        ASSERT Out[3] 0;
    }

    TEST "Test Case 15 AND 0" {
        SET A[0] 1, A[1] 1, A[2] 1, A[3] 1; // A = 15
        SET B[0] 0, B[1] 0, B[2] 0, B[3] 0; // B = 0
        EVAL;
        ASSERT Out[0] 0;
        ASSERT Out[1] 0;
        ASSERT Out[2] 0;
        ASSERT Out[3] 0;
    }

    TEST "Test Case 15 AND 15" {
        SET A[0] 1, A[1] 1, A[2] 1, A[3] 1; // A = 15
        SET B[0] 1, B[1] 1, B[2] 1, B[3] 1; // B = 15
        EVAL;
        ASSERT Out[0] 1;
        ASSERT Out[1] 1;
        ASSERT Out[2] 1;
        ASSERT Out[3] 1;
    }

     TEST "Test Case 5 AND 10" {
        SET A[0] 1, A[1] 0, A[2] 1, A[3] 0; // A = 5 (0101)
        SET B[0] 0, B[1] 1, B[2] 0, B[3] 1; // B = 10 (1010)
        EVAL;
        ASSERT Out[0] 0; // 1&0=0
        ASSERT Out[1] 0; // 0&1=0
        ASSERT Out[2] 0; // 1&0=0
        ASSERT Out[3] 0; // 0&1=0 -> Result 0 (0000)
    }

    TEST "Test Case 12 AND 10" {
        SET A[0] 0, A[1] 0, A[2] 1, A[3] 1; // A = 12 (1100)
        SET B[0] 0, B[1] 1, B[2] 0, B[3] 1; // B = 10 (1010)
        EVAL;
        ASSERT Out[0] 0; // 0&0=0
        ASSERT Out[1] 0; // 0&1=0
        ASSERT Out[2] 0; // 1&0=0
        ASSERT Out[3] 1; // 1&1=1 -> Result 8 (1000)
    }
}
