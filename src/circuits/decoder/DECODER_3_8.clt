// Tests for DECODER_3_8: every address, enabled and disabled
//
// Generated by `cargo test --release --lib riscv::clt_gen -- --ignored`
// from the simulator; the circuit is checked against Rust references and the
// instruction-level simulator in src/riscv/tests.rs and cpu_tests.rs.

TESTS FOR DECODER_3_8 {
    TEST "vectors 0..9" {
        SET A[2:0] 0x0, Enable 1;
        EVAL;
        ASSERT O[7:0] 0x01;
        SET A[2:0] 0x1, Enable 1;
        EVAL;
        ASSERT O[7:0] 0x02;
        SET A[2:0] 0x2, Enable 1;
        EVAL;
        ASSERT O[7:0] 0x04;
        SET A[2:0] 0x3, Enable 1;
        EVAL;
        ASSERT O[7:0] 0x08;
        SET A[2:0] 0x4, Enable 1;
        EVAL;
        ASSERT O[7:0] 0x10;
        SET A[2:0] 0x5, Enable 1;
        EVAL;
        ASSERT O[7:0] 0x20;
        SET A[2:0] 0x6, Enable 1;
        EVAL;
        ASSERT O[7:0] 0x40;
        SET A[2:0] 0x7, Enable 1;
        EVAL;
        ASSERT O[7:0] 0x80;
        SET A[2:0] 0x0, Enable 0;
        EVAL;
        ASSERT O[7:0] 0x00;
        SET A[2:0] 0x1, Enable 0;
        EVAL;
        ASSERT O[7:0] 0x00;
    }

    TEST "vectors 10..15" {
        SET A[2:0] 0x2, Enable 0;
        EVAL;
        ASSERT O[7:0] 0x00;
        SET A[2:0] 0x3, Enable 0;
        EVAL;
        ASSERT O[7:0] 0x00;
        SET A[2:0] 0x4, Enable 0;
        EVAL;
        ASSERT O[7:0] 0x00;
        SET A[2:0] 0x5, Enable 0;
        EVAL;
        ASSERT O[7:0] 0x00;
        SET A[2:0] 0x6, Enable 0;
        EVAL;
        ASSERT O[7:0] 0x00;
        SET A[2:0] 0x7, Enable 0;
        EVAL;
        ASSERT O[7:0] 0x00;
    }
}
