// Tests for DECODER_5_32: every address, plus some disabled
//
// Generated by `cargo test --release --lib riscv::clt_gen -- --ignored`
// from the simulator; the circuit is checked against Rust references and the
// instruction-level simulator in src/riscv/tests.rs and cpu_tests.rs.

TESTS FOR DECODER_5_32 {
    TEST "vectors 0..9" {
        SET A[4:0] 0x00, Enable 1;
        EVAL;
        ASSERT O[31:0] 0x00000001;
        SET A[4:0] 0x07, Enable 1;
        EVAL;
        ASSERT O[31:0] 0x00000080;
        SET A[4:0] 0x0E, Enable 1;
        EVAL;
        ASSERT O[31:0] 0x00004000;
        SET A[4:0] 0x15, Enable 1;
        EVAL;
        ASSERT O[31:0] 0x00200000;
        SET A[4:0] 0x1C, Enable 1;
        EVAL;
        ASSERT O[31:0] 0x10000000;
        SET A[4:0] 0x03, Enable 1;
        EVAL;
        ASSERT O[31:0] 0x00000008;
        SET A[4:0] 0x0A, Enable 1;
        EVAL;
        ASSERT O[31:0] 0x00000400;
        SET A[4:0] 0x11, Enable 1;
        EVAL;
        ASSERT O[31:0] 0x00020000;
        SET A[4:0] 0x18, Enable 1;
        EVAL;
        ASSERT O[31:0] 0x01000000;
        SET A[4:0] 0x1F, Enable 1;
        EVAL;
        ASSERT O[31:0] 0x80000000;
    }

    TEST "vectors 10..19" {
        SET A[4:0] 0x06, Enable 1;
        EVAL;
        ASSERT O[31:0] 0x00000040;
        SET A[4:0] 0x0D, Enable 1;
        EVAL;
        ASSERT O[31:0] 0x00002000;
        SET A[4:0] 0x14, Enable 1;
        EVAL;
        ASSERT O[31:0] 0x00100000;
        SET A[4:0] 0x1B, Enable 1;
        EVAL;
        ASSERT O[31:0] 0x08000000;
        SET A[4:0] 0x02, Enable 1;
        EVAL;
        ASSERT O[31:0] 0x00000004;
        SET A[4:0] 0x09, Enable 1;
        EVAL;
        ASSERT O[31:0] 0x00000200;
        SET A[4:0] 0x10, Enable 1;
        EVAL;
        ASSERT O[31:0] 0x00010000;
        SET A[4:0] 0x17, Enable 1;
        EVAL;
        ASSERT O[31:0] 0x00800000;
        SET A[4:0] 0x1E, Enable 1;
        EVAL;
        ASSERT O[31:0] 0x40000000;
        SET A[4:0] 0x05, Enable 1;
        EVAL;
        ASSERT O[31:0] 0x00000020;
    }

    TEST "vectors 20..29" {
        SET A[4:0] 0x0C, Enable 1;
        EVAL;
        ASSERT O[31:0] 0x00001000;
        SET A[4:0] 0x13, Enable 1;
        EVAL;
        ASSERT O[31:0] 0x00080000;
        SET A[4:0] 0x1A, Enable 1;
        EVAL;
        ASSERT O[31:0] 0x04000000;
        SET A[4:0] 0x01, Enable 1;
        EVAL;
        ASSERT O[31:0] 0x00000002;
        SET A[4:0] 0x08, Enable 1;
        EVAL;
        ASSERT O[31:0] 0x00000100;
        SET A[4:0] 0x0F, Enable 1;
        EVAL;
        ASSERT O[31:0] 0x00008000;
        SET A[4:0] 0x16, Enable 1;
        EVAL;
        ASSERT O[31:0] 0x00400000;
        SET A[4:0] 0x1D, Enable 1;
        EVAL;
        ASSERT O[31:0] 0x20000000;
        SET A[4:0] 0x04, Enable 1;
        EVAL;
        ASSERT O[31:0] 0x00000010;
        SET A[4:0] 0x0B, Enable 1;
        EVAL;
        ASSERT O[31:0] 0x00000800;
    }

    TEST "vectors 30..39" {
        SET A[4:0] 0x12, Enable 1;
        EVAL;
        ASSERT O[31:0] 0x00040000;
        SET A[4:0] 0x19, Enable 1;
        EVAL;
        ASSERT O[31:0] 0x02000000;
        SET A[4:0] 0x00, Enable 0;
        EVAL;
        ASSERT O[31:0] 0x00000000;
        SET A[4:0] 0x07, Enable 0;
        EVAL;
        ASSERT O[31:0] 0x00000000;
        SET A[4:0] 0x0E, Enable 0;
        EVAL;
        ASSERT O[31:0] 0x00000000;
        SET A[4:0] 0x15, Enable 0;
        EVAL;
        ASSERT O[31:0] 0x00000000;
        SET A[4:0] 0x1C, Enable 0;
        EVAL;
        ASSERT O[31:0] 0x00000000;
        SET A[4:0] 0x03, Enable 0;
        EVAL;
        ASSERT O[31:0] 0x00000000;
        SET A[4:0] 0x0A, Enable 0;
        EVAL;
        ASSERT O[31:0] 0x00000000;
        SET A[4:0] 0x11, Enable 0;
        EVAL;
        ASSERT O[31:0] 0x00000000;
    }
}
