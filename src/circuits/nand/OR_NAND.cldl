CIRCUIT OR_NAND {
    // OR built from NAND gates only. The simulator uses the built-in gate
    // OR (src/circuit/gates.rs); this definition stands in for it in the
    // NAND view, the NAND count and the NAND netlist export.
    INPUT in1, in2;
    OUTPUT out;
    PART N1: NOT_NAND;
    PART N2: NOT_NAND;
    PART G1: NAND;
    CONNECT in1 -> N1.in;
    CONNECT in2 -> N2.in;
    CONNECT N1.out -> G1.in1;
    CONNECT N2.out -> G1.in2;
    CONNECT G1.out -> out;
}