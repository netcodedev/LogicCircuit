// Test suite for the OR primitive circuit

TESTS FOR OR_NAND {
    TEST "Truth Table 0 OR 0" {
        SET in1 0, in2 0;
        EVAL;
        ASSERT out 0;
    }

    TEST "Truth Table 0 OR 1" {
        SET in1 0, in2 1;
        EVAL;
        ASSERT out 1;
    }

    TEST "Truth Table 1 OR 0" {
        SET in1 1, in2 0;
        EVAL;
        ASSERT out 1;
    }

    TEST "Truth Table 1 OR 1" {
        SET in1 1, in2 1;
        EVAL;
        ASSERT out 1;
    }
}
