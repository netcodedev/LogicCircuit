CIRCUIT XNOR_NAND {
    // XNOR built from NAND gates only. The simulator uses the built-in gate
    // XNOR (src/circuit/gates.rs); this definition stands in for it in the
    // NAND view, the NAND count and the NAND netlist export.
    INPUT in1, in2;
    OUTPUT out;

    PART G_XOR: XOR_NAND;
    PART G_NOT: NOT_NAND;

    CONNECT in1 -> G_XOR.in1;
    CONNECT in2 -> G_XOR.in2;

    CONNECT G_XOR.out -> G_NOT.in;

    CONNECT G_NOT.out -> out;
}
