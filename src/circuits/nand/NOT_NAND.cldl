CIRCUIT NOT_NAND {
    // NOT built from NAND gates only. The simulator uses the built-in gate
    // NOT (src/circuit/gates.rs); this definition stands in for it in the
    // NAND view, the NAND count and the NAND netlist export.
    INPUT in;
    OUTPUT out;
    PART G1: NAND;
    CONNECT in -> G1.in1;
    CONNECT in -> G1.in2;
    CONNECT G1.out -> out;
}