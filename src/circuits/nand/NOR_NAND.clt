// Test suite for the NOR primitive circuit

TESTS FOR NOR_NAND {
    TEST "Truth Table 0 NOR 0" {
        SET in1 0, in2 0;
        EVAL;
        ASSERT out 1;
    }

    TEST "Truth Table 0 NOR 1" {
        SET in1 0, in2 1;
        EVAL;
        ASSERT out 0;
    }

    TEST "Truth Table 1 NOR 0" {
        SET in1 1, in2 0;
        EVAL;
        ASSERT out 0;
    }

    TEST "Truth Table 1 NOR 1" {
        SET in1 1, in2 1;
        EVAL;
        ASSERT out 0;
    }
}
