// Test suite for the Full Adder circuit

TESTS FOR FULL_ADDER {

    TEST "Truth Table 0+0+0" {
        SET a 0, b 0, cin 0;
        EVAL;
        ASSERT sum 0;
        ASSERT cout 0;
    }

    TEST "Truth Table 0+0+1" {
        SET a 0, b 0, cin 1;
        EVAL;
        ASSERT sum 1;
        ASSERT cout 0;
    }

    TEST "Truth Table 0+1+0" {
        SET a 0, b 1, cin 0;
        EVAL;
        ASSERT sum 1;
        ASSERT cout 0;
    }

    TEST "Truth Table 0+1+1" {
        SET a 0, b 1, cin 1;
        EVAL;
        ASSERT sum 0;
        ASSERT cout 1;
    }

    TEST "Truth Table 1+0+0" {
        SET a 1, b 0, cin 0;
        EVAL;
        ASSERT sum 1;
        ASSERT cout 0;
    }

    TEST "Truth Table 1+0+1" {
        SET a 1, b 0, cin 1;
        EVAL;
        ASSERT sum 0;
        ASSERT cout 1;
    }

    TEST "Truth Table 1+1+0" {
        SET a 1, b 1, cin 0;
        EVAL;
        ASSERT sum 0;
        ASSERT cout 1;
    }

    TEST "Truth Table 1+1+1" {
        SET a 1, b 1, cin 1;
        EVAL;
        ASSERT sum 1;
        ASSERT cout 1;
    }

}
