CIRCUIT ADDER_4B {
    // Inputs: Two 4-bit numbers (A, B) and an initial Carry In (Cin)
    INPUT A[4]; 
    INPUT B[4];
    INPUT Cin; 

    // Outputs: 4-bit Sum (S) and final Carry Out (Cout)
    OUTPUT S[4]; 
    OUTPUT Cout;

    PART FA0: FULL_ADDER;
    PART FA1: FULL_ADDER;
    PART FA2: FULL_ADDER;
    PART FA3: FULL_ADDER;

    CONNECT A[0] -> FA0.a;
    CONNECT B[0] -> FA0.b;
    CONNECT Cin -> FA0.cin;

    CONNECT A[1] -> FA1.a;
    CONNECT B[1] -> FA1.b;
    CONNECT FA0.cout -> FA1.cin;

    CONNECT A[2] -> FA2.a;
    CONNECT B[2] -> FA2.b;
    CONNECT FA1.cout -> FA2.cin;

    CONNECT A[3] -> FA3.a;
    CONNECT B[3] -> FA3.b;
    CONNECT FA2.cout -> FA3.cin;

    CONNECT FA0.sum -> S[0];
    CONNECT FA1.sum -> S[1];
    CONNECT FA2.sum -> S[2];
    CONNECT FA3.sum -> S[3];

    CONNECT FA3.cout -> Cout;
}
