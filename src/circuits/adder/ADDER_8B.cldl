CIRCUIT ADDER_8B {
    // Inputs: Two 8-bit numbers (A, B) and an initial Carry In (Cin)
    INPUT A[8];
    INPUT B[8];
    INPUT Cin;

    // Outputs: 8-bit Sum (S) and final Carry Out (Cout)
    OUTPUT S[8];
    OUTPUT Cout;

    PART FA0: FULL_ADDER;
    PART FA1: FULL_ADDER;
    PART FA2: FULL_ADDER;
    PART FA3: FULL_ADDER;
    PART FA4: FULL_ADDER;
    PART FA5: FULL_ADDER;
    PART FA6: FULL_ADDER;
    PART FA7: FULL_ADDER;

    CONNECT A[0] -> FA0.a;
    CONNECT B[0] -> FA0.b;
    CONNECT Cin -> FA0.cin;

    CONNECT A[1] -> FA1.a;
    CONNECT B[1] -> FA1.b;
    CONNECT FA0.cout -> FA1.cin;

    CONNECT A[2] -> FA2.a;
    CONNECT B[2] -> FA2.b;
    CONNECT FA1.cout -> FA2.cin;

    CONNECT A[3] -> FA3.a;
    CONNECT B[3] -> FA3.b;
    CONNECT FA2.cout -> FA3.cin;

    CONNECT A[4] -> FA4.a;
    CONNECT B[4] -> FA4.b;
    CONNECT FA3.cout -> FA4.cin;

    CONNECT A[5] -> FA5.a;
    CONNECT B[5] -> FA5.b;
    CONNECT FA4.cout -> FA5.cin;

    CONNECT A[6] -> FA6.a;
    CONNECT B[6] -> FA6.b;
    CONNECT FA5.cout -> FA6.cin;

    CONNECT A[7] -> FA7.a;
    CONNECT B[7] -> FA7.b;
    CONNECT FA6.cout -> FA7.cin;

    CONNECT FA0.sum -> S[0];
    CONNECT FA1.sum -> S[1];
    CONNECT FA2.sum -> S[2];
    CONNECT FA3.sum -> S[3];
    CONNECT FA4.sum -> S[4];
    CONNECT FA5.sum -> S[5];
    CONNECT FA6.sum -> S[6];
    CONNECT FA7.sum -> S[7];

    CONNECT FA7.cout -> Cout;
}
