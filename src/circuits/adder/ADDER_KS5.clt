// Tests for ADDER_KS5<W> (Kogge-Stone adder) at W = 32
//
// Generated by `cargo test --release --lib riscv::clt_gen -- --ignored`
// from the simulator; the circuit is checked against Rust references and the
// instruction-level simulator in src/riscv/tests.rs and cpu_tests.rs.

TESTS FOR ADDER_KS5<32> {
    TEST "vectors 0..9" {
        SET A[31:0] 0xFFFFFFB6, B[31:0] 0xAA6C78C1, Cin 0;
        EVAL;
        ASSERT S[31:0] 0xAA6C7877; ASSERT Cout 1;
        SET A[31:0] 0xFFFFFF84, B[31:0] 0xFFFFFF68, Cin 0;
        EVAL;
        ASSERT S[31:0] 0xFFFFFEEC; ASSERT Cout 1;
        SET A[31:0] 0xF61C0122, B[31:0] 0xFFFFFFF4, Cin 1;
        EVAL;
        ASSERT S[31:0] 0xF61C0117; ASSERT Cout 1;
        SET A[31:0] 0xB17BD536, B[31:0] 0x7688363F, Cin 1;
        EVAL;
        ASSERT S[31:0] 0x28040B76; ASSERT Cout 1;
        SET A[31:0] 0xC265CC0C, B[31:0] 0x000000EE, Cin 0;
        EVAL;
        ASSERT S[31:0] 0xC265CCFA; ASSERT Cout 0;
        SET A[31:0] 0xFFFFFF46, B[31:0] 0xF2B06259, Cin 1;
        EVAL;
        ASSERT S[31:0] 0xF2B061A0; ASSERT Cout 1;
        SET A[31:0] 0xFFFFFFFF, B[31:0] 0xFFFFFFB0, Cin 0;
        EVAL;
        ASSERT S[31:0] 0xFFFFFFAF; ASSERT Cout 1;
        SET A[31:0] 0xFBB42A2A, B[31:0] 0x7A87C7FD, Cin 0;
        EVAL;
        ASSERT S[31:0] 0x763BF227; ASSERT Cout 1;
        SET A[31:0] 0xD45C67E7, B[31:0] 0x01ED2A94, Cin 0;
        EVAL;
        ASSERT S[31:0] 0xD649927B; ASSERT Cout 0;
        SET A[31:0] 0x1ADE6E5B, B[31:0] 0x506E58B4, Cin 0;
        EVAL;
        ASSERT S[31:0] 0x6B4CC70F; ASSERT Cout 0;
    }

    TEST "vectors 10..19" {
        SET A[31:0] 0xFFFFFFFF, B[31:0] 0x00000037, Cin 1;
        EVAL;
        ASSERT S[31:0] 0x00000037; ASSERT Cout 1;
        SET A[31:0] 0x00000045, B[31:0] 0x6B4F88AE, Cin 0;
        EVAL;
        ASSERT S[31:0] 0x6B4F88F3; ASSERT Cout 0;
        SET A[31:0] 0xFFFFFF6D, B[31:0] 0x192BEDA9, Cin 1;
        EVAL;
        ASSERT S[31:0] 0x192BED17; ASSERT Cout 1;
        SET A[31:0] 0x0000001F, B[31:0] 0x5464CA82, Cin 1;
        EVAL;
        ASSERT S[31:0] 0x5464CAA2; ASSERT Cout 0;
        SET A[31:0] 0x020D064D, B[31:0] 0xFFFFFF47, Cin 0;
        EVAL;
        ASSERT S[31:0] 0x020D0594; ASSERT Cout 1;
        SET A[31:0] 0xCFF051D4, B[31:0] 0x0ED06F30, Cin 1;
        EVAL;
        ASSERT S[31:0] 0xDEC0C105; ASSERT Cout 0;
        SET A[31:0] 0x0000001F, B[31:0] 0xFFFFFF7C, Cin 1;
        EVAL;
        ASSERT S[31:0] 0xFFFFFF9C; ASSERT Cout 0;
        SET A[31:0] 0xCCEE0048, B[31:0] 0x374CD741, Cin 1;
        EVAL;
        ASSERT S[31:0] 0x043AD78A; ASSERT Cout 1;
        SET A[31:0] 0x9F3592AF, B[31:0] 0x000000BB, Cin 0;
        EVAL;
        ASSERT S[31:0] 0x9F35936A; ASSERT Cout 0;
        SET A[31:0] 0xB3B45971, B[31:0] 0x5E0F64E8, Cin 1;
        EVAL;
        ASSERT S[31:0] 0x11C3BE5A; ASSERT Cout 1;
    }

    TEST "vectors 20..29" {
        SET A[31:0] 0xF478D1C1, B[31:0] 0xFFFFFFFF, Cin 1;
        EVAL;
        ASSERT S[31:0] 0xF478D1C1; ASSERT Cout 1;
        SET A[31:0] 0x0000000F, B[31:0] 0x6A40E73C, Cin 1;
        EVAL;
        ASSERT S[31:0] 0x6A40E74C; ASSERT Cout 0;
        SET A[31:0] 0xC829B023, B[31:0] 0x1EFEFED9, Cin 1;
        EVAL;
        ASSERT S[31:0] 0xE728AEFD; ASSERT Cout 0;
        SET A[31:0] 0xFFFFFF83, B[31:0] 0x00000079, Cin 0;
        EVAL;
        ASSERT S[31:0] 0xFFFFFFFC; ASSERT Cout 0;
        SET A[31:0] 0x5C540371, B[31:0] 0x9DB5AAD3, Cin 0;
        EVAL;
        ASSERT S[31:0] 0xFA09AE44; ASSERT Cout 0;
        SET A[31:0] 0x00000024, B[31:0] 0x000000C4, Cin 1;
        EVAL;
        ASSERT S[31:0] 0x000000E9; ASSERT Cout 0;
        SET A[31:0] 0x673839CE, B[31:0] 0xBAC9949E, Cin 1;
        EVAL;
        ASSERT S[31:0] 0x2201CE6D; ASSERT Cout 1;
        SET A[31:0] 0x41E4A0DD, B[31:0] 0x4128A114, Cin 0;
        EVAL;
        ASSERT S[31:0] 0x830D41F1; ASSERT Cout 0;
        SET A[31:0] 0x8449C36A, B[31:0] 0x5AD565C8, Cin 1;
        EVAL;
        ASSERT S[31:0] 0xDF1F2933; ASSERT Cout 0;
        SET A[31:0] 0xBCEB0335, B[31:0] 0x59AA2083, Cin 0;
        EVAL;
        ASSERT S[31:0] 0x169523B8; ASSERT Cout 1;
    }

    TEST "vectors 30..39" {
        SET A[31:0] 0x80000000, B[31:0] 0x4E6B53B9, Cin 0;
        EVAL;
        ASSERT S[31:0] 0xCE6B53B9; ASSERT Cout 0;
        SET A[31:0] 0xEC7533EE, B[31:0] 0xAD3131AE, Cin 0;
        EVAL;
        ASSERT S[31:0] 0x99A6659C; ASSERT Cout 1;
        SET A[31:0] 0x0000000B, B[31:0] 0x22E53713, Cin 1;
        EVAL;
        ASSERT S[31:0] 0x22E5371F; ASSERT Cout 0;
        SET A[31:0] 0x58A8195A, B[31:0] 0x00000001, Cin 0;
        EVAL;
        ASSERT S[31:0] 0x58A8195B; ASSERT Cout 0;
        SET A[31:0] 0x7FFFFFFF, B[31:0] 0x3266BB70, Cin 0;
        EVAL;
        ASSERT S[31:0] 0xB266BB6F; ASSERT Cout 0;
        SET A[31:0] 0x8B80275B, B[31:0] 0x7FFFFFFF, Cin 0;
        EVAL;
        ASSERT S[31:0] 0x0B80275A; ASSERT Cout 1;
        SET A[31:0] 0x970FD7C8, B[31:0] 0x01D94922, Cin 1;
        EVAL;
        ASSERT S[31:0] 0x98E920EB; ASSERT Cout 0;
        SET A[31:0] 0xFFFFFF48, B[31:0] 0xFFFFFFF3, Cin 1;
        EVAL;
        ASSERT S[31:0] 0xFFFFFF3C; ASSERT Cout 1;
        SET A[31:0] 0xFC588629, B[31:0] 0xEBF01224, Cin 1;
        EVAL;
        ASSERT S[31:0] 0xE848984E; ASSERT Cout 1;
        SET A[31:0] 0x00000043, B[31:0] 0x4A163F0C, Cin 0;
        EVAL;
        ASSERT S[31:0] 0x4A163F4F; ASSERT Cout 0;
    }
}
