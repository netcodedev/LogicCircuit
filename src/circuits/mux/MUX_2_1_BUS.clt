// Tests for the parametric bus multiplexer MUX_2_1_BUS<W>.
// MUX_2_1_BUS<4> and <8> reuse the test vectors of MUX_4B_2_1 and MUX_8B_2_1.

// Test suite for the 4-Bit 2-to-1 Multiplexer circuit

TESTS FOR MUX_2_1_BUS<4> {
    TEST "Select A (S=0)" {
        SET S 0; // Select line is low, should output A

        // Test Case 1: A=0, B=15
        SET A[0] 0, A[1] 0, A[2] 0, A[3] 0;
        SET B[0] 1, B[1] 1, B[2] 1, B[3] 1;
        EVAL;
        ASSERT Out[0] 0;
        ASSERT Out[1] 0;
        ASSERT Out[2] 0;
        ASSERT Out[3] 0;

        // Test Case 2: A=5, B=10
        SET A[0] 1, A[1] 0, A[2] 1, A[3] 0; // A = 5 (0101)
        SET B[0] 0, B[1] 1, B[2] 0, B[3] 1; // B = 10 (1010)
        EVAL;
        ASSERT Out[0] 1;
        ASSERT Out[1] 0;
        ASSERT Out[2] 1;
        ASSERT Out[3] 0;

        // Test Case 3: A=15, B=0
        SET A[0] 1, A[1] 1, A[2] 1, A[3] 1;
        SET B[0] 0, B[1] 0, B[2] 0, B[3] 0;
        EVAL;
        ASSERT Out[0] 1;
        ASSERT Out[1] 1;
        ASSERT Out[2] 1;
        ASSERT Out[3] 1;
    }

    TEST "Select B (S=1)" {
        SET S 1; // Select line is high, should output B

        // Test Case 1: A=15, B=0
        SET A[0] 1, A[1] 1, A[2] 1, A[3] 1;
        SET B[0] 0, B[1] 0, B[2] 0, B[3] 0;
        EVAL;
        ASSERT Out[0] 0;
        ASSERT Out[1] 0;
        ASSERT Out[2] 0;
        ASSERT Out[3] 0;

        // Test Case 2: A=10, B=5
        SET A[0] 0, A[1] 1, A[2] 0, A[3] 1; // A = 10 (1010)
        SET B[0] 1, B[1] 0, B[2] 1, B[3] 0; // B = 5 (0101)
        EVAL;
        ASSERT Out[0] 1;
        ASSERT Out[1] 0;
        ASSERT Out[2] 1;
        ASSERT Out[3] 0;

        // Test Case 3: A=0, B=15
        SET A[0] 0, A[1] 0, A[2] 0, A[3] 0;
        SET B[0] 1, B[1] 1, B[2] 1, B[3] 1;
        EVAL;
        ASSERT Out[0] 1;
        ASSERT Out[1] 1;
        ASSERT Out[2] 1;
        ASSERT Out[3] 1;
    }

}

// Test suite for the 8-bit 2:1 multiplexer

TESTS FOR MUX_2_1_BUS<8> {
    TEST "S=0 selects A (153)" {
        SET S 0;
        SET A[0] 1, A[1] 0, A[2] 0, A[3] 1, A[4] 1, A[5] 0, A[6] 0, A[7] 1; // A = 153
        SET B[0] 0, B[1] 1, B[2] 1, B[3] 0, B[4] 0, B[5] 1, B[6] 1, B[7] 0; // B = 102
        EVAL;
        ASSERT Out[0] 1; ASSERT Out[1] 0; ASSERT Out[2] 0; ASSERT Out[3] 1; ASSERT Out[4] 1; ASSERT Out[5] 0; ASSERT Out[6] 0; ASSERT Out[7] 1; // Out = A = 153
    }

    TEST "S=1 selects B (102)" {
        SET S 1;
        SET A[0] 1, A[1] 0, A[2] 0, A[3] 1, A[4] 1, A[5] 0, A[6] 0, A[7] 1; // A = 153
        SET B[0] 0, B[1] 1, B[2] 1, B[3] 0, B[4] 0, B[5] 1, B[6] 1, B[7] 0; // B = 102
        EVAL;
        ASSERT Out[0] 0; ASSERT Out[1] 1; ASSERT Out[2] 1; ASSERT Out[3] 0; ASSERT Out[4] 0; ASSERT Out[5] 1; ASSERT Out[6] 1; ASSERT Out[7] 0; // Out = B = 102
    }

    TEST "S=0 selects A (165)" {
        SET S 0;
        SET A[0] 1, A[1] 0, A[2] 1, A[3] 0, A[4] 0, A[5] 1, A[6] 0, A[7] 1; // A = 165
        SET B[0] 0, B[1] 1, B[2] 0, B[3] 1, B[4] 1, B[5] 0, B[6] 1, B[7] 0; // B = 90
        EVAL;
        ASSERT Out[0] 1; ASSERT Out[1] 0; ASSERT Out[2] 1; ASSERT Out[3] 0; ASSERT Out[4] 0; ASSERT Out[5] 1; ASSERT Out[6] 0; ASSERT Out[7] 1; // Out = A = 165
    }

    TEST "S=1 selects B (90)" {
        SET S 1;
        SET A[0] 1, A[1] 0, A[2] 1, A[3] 0, A[4] 0, A[5] 1, A[6] 0, A[7] 1; // A = 165
        SET B[0] 0, B[1] 1, B[2] 0, B[3] 1, B[4] 1, B[5] 0, B[6] 1, B[7] 0; // B = 90
        EVAL;
        ASSERT Out[0] 0; ASSERT Out[1] 1; ASSERT Out[2] 0; ASSERT Out[3] 1; ASSERT Out[4] 1; ASSERT Out[5] 0; ASSERT Out[6] 1; ASSERT Out[7] 0; // Out = B = 90
    }

}

TESTS FOR MUX_2_1_BUS<16> {
    TEST "S=0: A=0x1234, B=0xABCD -> 0x1234" {
        SET A[0] 0, A[1] 0, A[2] 1, A[3] 0, A[4] 1, A[5] 1, A[6] 0, A[7] 0, A[8] 0, A[9] 1, A[10] 0, A[11] 0, A[12] 1, A[13] 0, A[14] 0, A[15] 0;
        SET B[0] 1, B[1] 0, B[2] 1, B[3] 1, B[4] 0, B[5] 0, B[6] 1, B[7] 1, B[8] 1, B[9] 1, B[10] 0, B[11] 1, B[12] 0, B[13] 1, B[14] 0, B[15] 1;
        SET S 0;
        EVAL;
        ASSERT Out[0] 0; ASSERT Out[1] 0; ASSERT Out[2] 1; ASSERT Out[3] 0; ASSERT Out[4] 1; ASSERT Out[5] 1; ASSERT Out[6] 0; ASSERT Out[7] 0; ASSERT Out[8] 0; ASSERT Out[9] 1; ASSERT Out[10] 0; ASSERT Out[11] 0; ASSERT Out[12] 1; ASSERT Out[13] 0; ASSERT Out[14] 0; ASSERT Out[15] 0;
    }

    TEST "S=1: A=0x1234, B=0xABCD -> 0xABCD" {
        SET A[0] 0, A[1] 0, A[2] 1, A[3] 0, A[4] 1, A[5] 1, A[6] 0, A[7] 0, A[8] 0, A[9] 1, A[10] 0, A[11] 0, A[12] 1, A[13] 0, A[14] 0, A[15] 0;
        SET B[0] 1, B[1] 0, B[2] 1, B[3] 1, B[4] 0, B[5] 0, B[6] 1, B[7] 1, B[8] 1, B[9] 1, B[10] 0, B[11] 1, B[12] 0, B[13] 1, B[14] 0, B[15] 1;
        SET S 1;
        EVAL;
        ASSERT Out[0] 1; ASSERT Out[1] 0; ASSERT Out[2] 1; ASSERT Out[3] 1; ASSERT Out[4] 0; ASSERT Out[5] 0; ASSERT Out[6] 1; ASSERT Out[7] 1; ASSERT Out[8] 1; ASSERT Out[9] 1; ASSERT Out[10] 0; ASSERT Out[11] 1; ASSERT Out[12] 0; ASSERT Out[13] 1; ASSERT Out[14] 0; ASSERT Out[15] 1;
    }

    TEST "S=0: A=0xFFFF, B=0x0 -> 0xFFFF" {
        SET A[0] 1, A[1] 1, A[2] 1, A[3] 1, A[4] 1, A[5] 1, A[6] 1, A[7] 1, A[8] 1, A[9] 1, A[10] 1, A[11] 1, A[12] 1, A[13] 1, A[14] 1, A[15] 1;
        SET B[0] 0, B[1] 0, B[2] 0, B[3] 0, B[4] 0, B[5] 0, B[6] 0, B[7] 0, B[8] 0, B[9] 0, B[10] 0, B[11] 0, B[12] 0, B[13] 0, B[14] 0, B[15] 0;
        SET S 0;
        EVAL;
        ASSERT Out[0] 1; ASSERT Out[1] 1; ASSERT Out[2] 1; ASSERT Out[3] 1; ASSERT Out[4] 1; ASSERT Out[5] 1; ASSERT Out[6] 1; ASSERT Out[7] 1; ASSERT Out[8] 1; ASSERT Out[9] 1; ASSERT Out[10] 1; ASSERT Out[11] 1; ASSERT Out[12] 1; ASSERT Out[13] 1; ASSERT Out[14] 1; ASSERT Out[15] 1;
    }

    TEST "S=1: A=0xFFFF, B=0x0 -> 0x0" {
        SET A[0] 1, A[1] 1, A[2] 1, A[3] 1, A[4] 1, A[5] 1, A[6] 1, A[7] 1, A[8] 1, A[9] 1, A[10] 1, A[11] 1, A[12] 1, A[13] 1, A[14] 1, A[15] 1;
        SET B[0] 0, B[1] 0, B[2] 0, B[3] 0, B[4] 0, B[5] 0, B[6] 0, B[7] 0, B[8] 0, B[9] 0, B[10] 0, B[11] 0, B[12] 0, B[13] 0, B[14] 0, B[15] 0;
        SET S 1;
        EVAL;
        ASSERT Out[0] 0; ASSERT Out[1] 0; ASSERT Out[2] 0; ASSERT Out[3] 0; ASSERT Out[4] 0; ASSERT Out[5] 0; ASSERT Out[6] 0; ASSERT Out[7] 0; ASSERT Out[8] 0; ASSERT Out[9] 0; ASSERT Out[10] 0; ASSERT Out[11] 0; ASSERT Out[12] 0; ASSERT Out[13] 0; ASSERT Out[14] 0; ASSERT Out[15] 0;
    }
}
