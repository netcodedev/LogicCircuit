// Test suite for the 2-to-1 Multiplexer circuit

TESTS FOR MUX_2_1 {
    TEST "Select A (S=0)" {
        SET S 0; // Select line is low

        SET A 0, B 0;
        EVAL;
        ASSERT Out 0; // Should output A=0

        SET A 1, B 0;
        EVAL;
        ASSERT Out 1; // Should output A=1

        SET A 0, B 1;
        EVAL;
        ASSERT Out 0; // Should output A=0 (B is ignored)

        SET A 1, B 1;
        EVAL;
        ASSERT Out 1; // Should output A=1 (B is ignored)
    }

    TEST "Select B (S=1)" {
        SET S 1; // Select line is high

        SET A 0, B 0;
        EVAL;
        ASSERT Out 0; // Should output B=0

        SET A 1, B 0;
        EVAL;
        ASSERT Out 0; // Should output B=0 (A is ignored)

        SET A 0, B 1;
        EVAL;
        ASSERT Out 1; // Should output B=1

        SET A 1, B 1;
        EVAL;
        ASSERT Out 1; // Should output B=1 (A is ignored)
    }

}
