// Tests for MUX_4_1_BUS<W> (input k = In[k*W .. k*W+W-1])

TESTS FOR MUX_4_1_BUS<4> {
    TEST "S=0 selects input 0" {
        SET In[0] 1, In[1] 1, In[2] 0, In[3] 0, In[4] 1, In[5] 0, In[6] 1, In[7] 0, In[8] 0, In[9] 1, In[10] 0, In[11] 1, In[12] 0, In[13] 0, In[14] 1, In[15] 1;
        SET S[0] 0, S[1] 0;
        EVAL;
        ASSERT Out[0] 1; ASSERT Out[1] 1; ASSERT Out[2] 0; ASSERT Out[3] 0;
    }

    TEST "S=1 selects input 1" {
        SET In[0] 1, In[1] 1, In[2] 0, In[3] 0, In[4] 1, In[5] 0, In[6] 1, In[7] 0, In[8] 0, In[9] 1, In[10] 0, In[11] 1, In[12] 0, In[13] 0, In[14] 1, In[15] 1;
        SET S[0] 1, S[1] 0;
        EVAL;
        ASSERT Out[0] 1; ASSERT Out[1] 0; ASSERT Out[2] 1; ASSERT Out[3] 0;
    }

    TEST "S=2 selects input 2" {
        SET In[0] 1, In[1] 1, In[2] 0, In[3] 0, In[4] 1, In[5] 0, In[6] 1, In[7] 0, In[8] 0, In[9] 1, In[10] 0, In[11] 1, In[12] 0, In[13] 0, In[14] 1, In[15] 1;
        SET S[0] 0, S[1] 1;
        EVAL;
        ASSERT Out[0] 0; ASSERT Out[1] 1; ASSERT Out[2] 0; ASSERT Out[3] 1;
    }

    TEST "S=3 selects input 3" {
        SET In[0] 1, In[1] 1, In[2] 0, In[3] 0, In[4] 1, In[5] 0, In[6] 1, In[7] 0, In[8] 0, In[9] 1, In[10] 0, In[11] 1, In[12] 0, In[13] 0, In[14] 1, In[15] 1;
        SET S[0] 1, S[1] 1;
        EVAL;
        ASSERT Out[0] 0; ASSERT Out[1] 0; ASSERT Out[2] 1; ASSERT Out[3] 1;
    }
}

