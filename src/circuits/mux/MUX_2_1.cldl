CIRCUIT MUX_2_1 {
    // Out = S ? B : A, as NAND-NAND: Out = NAND(NAND(A, NOT S), NAND(B, S)).
    // Two NAND levels from A/B to Out (an AND-OR from basic gates has four).
    INPUT A, B;
    INPUT S;

    OUTPUT Out;

    PART G_NOT_S: NOT;
    PART G_NAND_A: NAND;
    PART G_NAND_B: NAND;
    PART G_NAND_Out: NAND;

    CONNECT S -> G_NOT_S.in;

    CONNECT A -> G_NAND_A.in1;
    CONNECT G_NOT_S.out -> G_NAND_A.in2;

    CONNECT B -> G_NAND_B.in1;
    CONNECT S -> G_NAND_B.in2;

    CONNECT G_NAND_A.out -> G_NAND_Out.in1;
    CONNECT G_NAND_B.out -> G_NAND_Out.in2;

    CONNECT G_NAND_Out.out -> Out;
}
