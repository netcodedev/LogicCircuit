// Test suite for the 4-Bit 2-to-1 Multiplexer circuit

TESTS FOR MUX_4B_2_1 {
    TEST "Select A (S=0)" {
        SET S 0; // Select line is low, should output A

        // Test Case 1: A=0, B=15
        SET A[0] 0, A[1] 0, A[2] 0, A[3] 0;
        SET B[0] 1, B[1] 1, B[2] 1, B[3] 1;
        EVAL;
        ASSERT Out[0] 0;
        ASSERT Out[1] 0;
        ASSERT Out[2] 0;
        ASSERT Out[3] 0;

        // Test Case 2: A=5, B=10
        SET A[0] 1, A[1] 0, A[2] 1, A[3] 0; // A = 5 (0101)
        SET B[0] 0, B[1] 1, B[2] 0, B[3] 1; // B = 10 (1010)
        EVAL;
        ASSERT Out[0] 1;
        ASSERT Out[1] 0;
        ASSERT Out[2] 1;
        ASSERT Out[3] 0;

        // Test Case 3: A=15, B=0
        SET A[0] 1, A[1] 1, A[2] 1, A[3] 1;
        SET B[0] 0, B[1] 0, B[2] 0, B[3] 0;
        EVAL;
        ASSERT Out[0] 1;
        ASSERT Out[1] 1;
        ASSERT Out[2] 1;
        ASSERT Out[3] 1;
    }

    TEST "Select B (S=1)" {
        SET S 1; // Select line is high, should output B

        // Test Case 1: A=15, B=0
        SET A[0] 1, A[1] 1, A[2] 1, A[3] 1;
        SET B[0] 0, B[1] 0, B[2] 0, B[3] 0;
        EVAL;
        ASSERT Out[0] 0;
        ASSERT Out[1] 0;
        ASSERT Out[2] 0;
        ASSERT Out[3] 0;

        // Test Case 2: A=10, B=5
        SET A[0] 0, A[1] 1, A[2] 0, A[3] 1; // A = 10 (1010)
        SET B[0] 1, B[1] 0, B[2] 1, B[3] 0; // B = 5 (0101)
        EVAL;
        ASSERT Out[0] 1;
        ASSERT Out[1] 0;
        ASSERT Out[2] 1;
        ASSERT Out[3] 0;

        // Test Case 3: A=0, B=15
        SET A[0] 0, A[1] 0, A[2] 0, A[3] 0;
        SET B[0] 1, B[1] 1, B[2] 1, B[3] 1;
        EVAL;
        ASSERT Out[0] 1;
        ASSERT Out[1] 1;
        ASSERT Out[2] 1;
        ASSERT Out[3] 1;
    }

}
