CIRCUIT MUX_4B_2_1 {
    // Inputs: Two 4-bit data buses (A, B) and one Select input (S)
    INPUT A[4];
    INPUT B[4];
    INPUT S;

    // Output: Selected 4-bit data bus (Out)
    OUTPUT Out[4];

    PART MUX0: MUX_2_1; // For bit 0
    PART MUX1: MUX_2_1; // For bit 1
    PART MUX2: MUX_2_1; // For bit 2
    PART MUX3: MUX_2_1; // For bit 3

    CONNECT A[0] -> MUX0.A;
    CONNECT B[0] -> MUX0.B;
    CONNECT S  -> MUX0.S; // Share the Select line
    CONNECT MUX0.Out -> Out[0];

    CONNECT A[1] -> MUX1.A;
    CONNECT B[1] -> MUX1.B;
    CONNECT S  -> MUX1.S; // Share the Select line
    CONNECT MUX1.Out -> Out[1];

    CONNECT A[2] -> MUX2.A;
    CONNECT B[2] -> MUX2.B;
    CONNECT S  -> MUX2.S; // Share the Select line
    CONNECT MUX2.Out -> Out[2];

    CONNECT A[3] -> MUX3.A;
    CONNECT B[3] -> MUX3.B;
    CONNECT S  -> MUX3.S; // Share the Select line
    CONNECT MUX3.Out -> Out[3];
}

