// Tests for MUX_32_1_BUS<W> at W = 4 (input k = In[4k .. 4k+3]): every select
//
// Generated by `cargo test --release --lib riscv::clt_gen -- --ignored`
// from the simulator; the circuit is checked against Rust references and the
// instruction-level simulator in src/riscv/tests.rs and cpu_tests.rs.

TESTS FOR MUX_32_1_BUS<4> {
    TEST "vectors 0..9" {
        SET In[127:0] 0x8306286060C18A140000030015800A00, S[4:0] 0x00;
        EVAL;
        ASSERT Out[3:0] 0x0;
        SET In[127:0] 0xA604143C89E14C1826E77270B9200C00, S[4:0] 0x01;
        EVAL;
        ASSERT Out[3:0] 0x0;
        SET In[127:0] 0xED2977C6ADD2ED9120DFC04FB0228880, S[4:0] 0x02;
        EVAL;
        ASSERT Out[3:0] 0x8;
        SET In[127:0] 0xA630D84048116692C026123811940C0A, S[4:0] 0x03;
        EVAL;
        ASSERT Out[3:0] 0x0;
        SET In[127:0] 0x4E6B88E28F781E5EFD8360F5A1B4A0DF, S[4:0] 0x04;
        EVAL;
        ASSERT Out[3:0] 0x4;
        SET In[127:0] 0x37B2298545165C11527619EAE46EB9E2, S[4:0] 0x05;
        EVAL;
        ASSERT Out[3:0] 0x6;
        SET In[127:0] 0x04EF8A6F8AC3F8007A2C0737685B54E9, S[4:0] 0x06;
        EVAL;
        ASSERT Out[3:0] 0x8;
        SET In[127:0] 0x65E122A21CFC130F8BCA0B9165C87FF0, S[4:0] 0x07;
        EVAL;
        ASSERT Out[3:0] 0x6;
        SET In[127:0] 0x0A5B28462345373856C9C0BE7472C8E9, S[4:0] 0x08;
        EVAL;
        ASSERT Out[3:0] 0xE;
        SET In[127:0] 0xCDC6A700812F6C30F860FAA43E057356, S[4:0] 0x09;
        EVAL;
        ASSERT Out[3:0] 0xA;
    }

    TEST "vectors 10..19" {
        SET In[127:0] 0x5EE8B7EF6BEFC495ED82B6AB5BA03EE8, S[4:0] 0x0A;
        EVAL;
        ASSERT Out[3:0] 0x6;
        SET In[127:0] 0x91207C63FC1A4E60A8CA1C908AE39E5C, S[4:0] 0x0B;
        EVAL;
        ASSERT Out[3:0] 0x1;
        SET In[127:0] 0xA64AF6FDC9725639285FB29CB145E2FC, S[4:0] 0x0C;
        EVAL;
        ASSERT Out[3:0] 0xF;
        SET In[127:0] 0x0CBDCCAB7BE7B9AC33FC2C281D181CD5, S[4:0] 0x0D;
        EVAL;
        ASSERT Out[3:0] 0xF;
        SET In[127:0] 0xA286A3967AD1E1245162B50718759DDF, S[4:0] 0x0E;
        EVAL;
        ASSERT Out[3:0] 0x1;
        SET In[127:0] 0xC07F04624A9BDB717E3238E4C9B48BE6, S[4:0] 0x0F;
        EVAL;
        ASSERT Out[3:0] 0x7;
        SET In[127:0] 0xE1BBBBC21AA5E16677E40C8772981087, S[4:0] 0x10;
        EVAL;
        ASSERT Out[3:0] 0x6;
        SET In[127:0] 0x9C5D420A13BB6242692168EFED8C3324, S[4:0] 0x11;
        EVAL;
        ASSERT Out[3:0] 0x4;
        SET In[127:0] 0xCAC10FF595B7040E448F32640D00C406, S[4:0] 0x12;
        EVAL;
        ASSERT Out[3:0] 0x4;
        SET In[127:0] 0xE18D64EED221A9556E9A2580A0D0A986, S[4:0] 0x13;
        EVAL;
        ASSERT Out[3:0] 0xA;
    }

    TEST "vectors 20..29" {
        SET In[127:0] 0xE2721BBA370EB8B97225FA5D8C4B1F47, S[4:0] 0x14;
        EVAL;
        ASSERT Out[3:0] 0xE;
        SET In[127:0] 0xFF99E09C166DDADF0F85F85200C9AB88, S[4:0] 0x15;
        EVAL;
        ASSERT Out[3:0] 0x6;
        SET In[127:0] 0xC4C7FAEB65B0CC872F276A4DA33856AA, S[4:0] 0x16;
        EVAL;
        ASSERT Out[3:0] 0x5;
        SET In[127:0] 0xFBC832836ED453877D0E2EC11F646CDE, S[4:0] 0x17;
        EVAL;
        ASSERT Out[3:0] 0x6;
        SET In[127:0] 0x193ADE57FDE0191523ADC13CA2ADFAE0, S[4:0] 0x18;
        EVAL;
        ASSERT Out[3:0] 0x7;
        SET In[127:0] 0xBD0EAA79E92F27DFC12593D651F13C67, S[4:0] 0x19;
        EVAL;
        ASSERT Out[3:0] 0x7;
        SET In[127:0] 0x0C5EEE7C4EB4248C40747FEC696F6E50, S[4:0] 0x1A;
        EVAL;
        ASSERT Out[3:0] 0xE;
        SET In[127:0] 0xF798BE14AD0CC95A5AF97A06403BEFC5, S[4:0] 0x1B;
        EVAL;
        ASSERT Out[3:0] 0xB;
        SET In[127:0] 0xEE2D3691B1CAEBC4DE5E237DD2DFC648, S[4:0] 0x1C;
        EVAL;
        ASSERT Out[3:0] 0xD;
        SET In[127:0] 0x2C5549A24D3031CDB53D847FA34D0F13, S[4:0] 0x1D;
        EVAL;
        ASSERT Out[3:0] 0x5;
    }

    TEST "vectors 30..31" {
        SET In[127:0] 0x2344054C2CA47E6B0063453B464382EE, S[4:0] 0x1E;
        EVAL;
        ASSERT Out[3:0] 0x3;
        SET In[127:0] 0xE5CB43516A733A0F15187F868A81CC57, S[4:0] 0x1F;
        EVAL;
        ASSERT Out[3:0] 0xE;
    }
}
