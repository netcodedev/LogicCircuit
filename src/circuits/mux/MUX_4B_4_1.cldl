CIRCUIT MUX_4B_4_1 {
    // Inputs: Four 4-bit data buses (In0, In1, In2, In3)
    INPUT In0[4];
    INPUT In1[4];
    INPUT In2[4];
    INPUT In3[4];
    // Two Select inputs (S[0], S[1])
    INPUT S[2];

    // Output: Selected 4-bit data bus (Out)
    OUTPUT Out[4];

    PART MUX_A: MUX_4B_2_1; // Selects between In0 and In1 based on S[0]
    PART MUX_B: MUX_4B_2_1; // Selects between In2 and In3 based on S[0]
    PART MUX_C: MUX_4B_2_1; // Selects between MUX_A output and MUX_B output based on S[1]

    CONNECT In0 -> MUX_A.A;
    CONNECT In1 -> MUX_A.B;
    CONNECT S[0] -> MUX_A.S;

    CONNECT In2 -> MUX_B.A;
    CONNECT In3 -> MUX_B.B;
    CONNECT S[0] -> MUX_B.S;

    CONNECT MUX_A.Out -> MUX_C.A;
    CONNECT MUX_B.Out -> MUX_C.B;
    CONNECT S[1] -> MUX_C.S;

    CONNECT MUX_C.Out -> Out;
}
