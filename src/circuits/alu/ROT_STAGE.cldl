CIRCUIT ROT_STAGE<W, S> {
    // One stage of a right rotator: with Sel=1, Out = In rotated right by S
    // bits (bit i takes bit (i+S) mod W); with Sel=0, Out = In. Unlike
    // SHIFT_STAGE there is no fill mux on the upper bits, so every bit
    // passes exactly one mux.
    INPUT In[W];
    INPUT Sel;

    OUTPUT Out[W];

    FOR i IN 0..W {
        PART Mux[i]: MUX_2_1;
        CONNECT In[i] -> Mux[i].A;
        CONNECT Sel -> Mux[i].S;
        CONNECT Mux[i].Out -> Out[i];
    }
    FOR i IN 0..W-S {
        CONNECT In[i+S] -> Mux[i].B;
    }
    FOR i IN W-S..W {
        CONNECT In[i+S-W] -> Mux[i].B;
    }
}
