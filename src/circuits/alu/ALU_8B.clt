// Test suite for the 8-bit ALU (00=ADD 01=AND 10=OR 11=XOR)

TESTS FOR ALU_8B {
    TEST "ADD: 100 + 50 = 150" {
        SET A[0] 0, A[1] 0, A[2] 1, A[3] 0, A[4] 0, A[5] 1, A[6] 1, A[7] 0; // A = 100
        SET B[0] 0, B[1] 1, B[2] 0, B[3] 0, B[4] 1, B[5] 1, B[6] 0, B[7] 0; // B = 50
        SET Cin 0;
        SET S[0] 0, S[1] 0;
        EVAL;
        ASSERT Result[0] 0; ASSERT Result[1] 1; ASSERT Result[2] 1; ASSERT Result[3] 0; ASSERT Result[4] 1; ASSERT Result[5] 0; ASSERT Result[6] 0; ASSERT Result[7] 1; // Result = 150
        ASSERT Cout 0;
        ASSERT Z 0;
    }

    TEST "ADD: 255 + 1 = 0 (Cout=1, Z=1)" {
        SET A[0] 1, A[1] 1, A[2] 1, A[3] 1, A[4] 1, A[5] 1, A[6] 1, A[7] 1; // A = 255
        SET B[0] 1, B[1] 0, B[2] 0, B[3] 0, B[4] 0, B[5] 0, B[6] 0, B[7] 0; // B = 1
        SET Cin 0;
        SET S[0] 0, S[1] 0;
        EVAL;
        ASSERT Result[0] 0; ASSERT Result[1] 0; ASSERT Result[2] 0; ASSERT Result[3] 0; ASSERT Result[4] 0; ASSERT Result[5] 0; ASSERT Result[6] 0; ASSERT Result[7] 0; // Result = 0
        ASSERT Cout 1;
        ASSERT Z 1;
    }

    TEST "ADD with Cin: 100 + 50 + 1 = 151" {
        SET A[0] 0, A[1] 0, A[2] 1, A[3] 0, A[4] 0, A[5] 1, A[6] 1, A[7] 0; // A = 100
        SET B[0] 0, B[1] 1, B[2] 0, B[3] 0, B[4] 1, B[5] 1, B[6] 0, B[7] 0; // B = 50
        SET Cin 1;
        SET S[0] 0, S[1] 0;
        EVAL;
        ASSERT Result[0] 1; ASSERT Result[1] 1; ASSERT Result[2] 1; ASSERT Result[3] 0; ASSERT Result[4] 1; ASSERT Result[5] 0; ASSERT Result[6] 0; ASSERT Result[7] 1; // Result = 151
        ASSERT Cout 0;
        ASSERT Z 0;
    }

    TEST "ADD: 200 + 100 = 44 (Cout=1)" {
        SET A[0] 0, A[1] 0, A[2] 0, A[3] 1, A[4] 0, A[5] 0, A[6] 1, A[7] 1; // A = 200
        SET B[0] 0, B[1] 0, B[2] 1, B[3] 0, B[4] 0, B[5] 1, B[6] 1, B[7] 0; // B = 100
        SET Cin 0;
        SET S[0] 0, S[1] 0;
        EVAL;
        ASSERT Result[0] 0; ASSERT Result[1] 0; ASSERT Result[2] 1; ASSERT Result[3] 1; ASSERT Result[4] 0; ASSERT Result[5] 1; ASSERT Result[6] 0; ASSERT Result[7] 0; // Result = 44
        ASSERT Cout 1;
        ASSERT Z 0;
    }

    TEST "AND: 0xCC & 0xAA = 0x88" {
        SET A[0] 0, A[1] 0, A[2] 1, A[3] 1, A[4] 0, A[5] 0, A[6] 1, A[7] 1; // A = 204
        SET B[0] 0, B[1] 1, B[2] 0, B[3] 1, B[4] 0, B[5] 1, B[6] 0, B[7] 1; // B = 170
        SET Cin 0;
        SET S[0] 1, S[1] 0;
        EVAL;
        ASSERT Result[0] 0; ASSERT Result[1] 0; ASSERT Result[2] 0; ASSERT Result[3] 1; ASSERT Result[4] 0; ASSERT Result[5] 0; ASSERT Result[6] 0; ASSERT Result[7] 1; // Result = 136
        ASSERT Cout 0;
        ASSERT Z 0;
    }

    TEST "OR: 0xCC | 0xAA = 0xEE" {
        SET A[0] 0, A[1] 0, A[2] 1, A[3] 1, A[4] 0, A[5] 0, A[6] 1, A[7] 1; // A = 204
        SET B[0] 0, B[1] 1, B[2] 0, B[3] 1, B[4] 0, B[5] 1, B[6] 0, B[7] 1; // B = 170
        SET Cin 0;
        SET S[0] 0, S[1] 1;
        EVAL;
        ASSERT Result[0] 0; ASSERT Result[1] 1; ASSERT Result[2] 1; ASSERT Result[3] 1; ASSERT Result[4] 0; ASSERT Result[5] 1; ASSERT Result[6] 1; ASSERT Result[7] 1; // Result = 238
        ASSERT Cout 0;
        ASSERT Z 0;
    }

    TEST "XOR: 0xCC ^ 0xAA = 0x66" {
        SET A[0] 0, A[1] 0, A[2] 1, A[3] 1, A[4] 0, A[5] 0, A[6] 1, A[7] 1; // A = 204
        SET B[0] 0, B[1] 1, B[2] 0, B[3] 1, B[4] 0, B[5] 1, B[6] 0, B[7] 1; // B = 170
        SET Cin 0;
        SET S[0] 1, S[1] 1;
        EVAL;
        ASSERT Result[0] 0; ASSERT Result[1] 1; ASSERT Result[2] 1; ASSERT Result[3] 0; ASSERT Result[4] 0; ASSERT Result[5] 1; ASSERT Result[6] 1; ASSERT Result[7] 0; // Result = 102
        ASSERT Cout 0;
        ASSERT Z 0;
    }

    TEST "XOR: 0xAA ^ 0xAA = 0 (Z=1)" {
        SET A[0] 0, A[1] 1, A[2] 0, A[3] 1, A[4] 0, A[5] 1, A[6] 0, A[7] 1; // A = 170
        SET B[0] 0, B[1] 1, B[2] 0, B[3] 1, B[4] 0, B[5] 1, B[6] 0, B[7] 1; // B = 170
        SET Cin 0;
        SET S[0] 1, S[1] 1;
        EVAL;
        ASSERT Result[0] 0; ASSERT Result[1] 0; ASSERT Result[2] 0; ASSERT Result[3] 0; ASSERT Result[4] 0; ASSERT Result[5] 0; ASSERT Result[6] 0; ASSERT Result[7] 0; // Result = 0
        ASSERT Cout 0;
        ASSERT Z 1;
    }

}
