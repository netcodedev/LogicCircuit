// Tests for the 16-bit ALU: every ALU function code with its control bits, results and flags

TESTS FOR ALU_16B {
    TEST "ADD 0x04D2, 0x10E1 = 0x15B3 C0 Z0 N0 V0" {
        SET A[0] 0, A[1] 1, A[2] 0, A[3] 0, A[4] 1, A[5] 0, A[6] 1, A[7] 1, A[8] 0, A[9] 0, A[10] 1, A[11] 0, A[12] 0, A[13] 0, A[14] 0, A[15] 0;
        SET B[0] 1, B[1] 0, B[2] 0, B[3] 0, B[4] 0, B[5] 1, B[6] 1, B[7] 1, B[8] 0, B[9] 0, B[10] 0, B[11] 0, B[12] 1, B[13] 0, B[14] 0, B[15] 0;
        SET Cin 0, InvB 0, ZeroA 0, S[0] 0, S[1] 0;
        EVAL;
        ASSERT Result[0] 1; ASSERT Result[1] 1; ASSERT Result[2] 0; ASSERT Result[3] 0; ASSERT Result[4] 1; ASSERT Result[5] 1; ASSERT Result[6] 0; ASSERT Result[7] 1; ASSERT Result[8] 1; ASSERT Result[9] 0; ASSERT Result[10] 1; ASSERT Result[11] 0; ASSERT Result[12] 1; ASSERT Result[13] 0; ASSERT Result[14] 0; ASSERT Result[15] 0;
        ASSERT Cout 0; ASSERT Z 0; ASSERT N 0; ASSERT V 0;
    }

    TEST "ADD 0x7FFF, 0x0001 = 0x8000 C0 Z0 N1 V1" {
