        SET Cin 0, InvB 0, ZeroA 0, S[0] 0, S[1] 0;
        EVAL;
        ASSERT Result[0] 0; ASSERT Result[1] 0; ASSERT Result[2] 0; ASSERT Result[3] 0; ASSERT Result[4] 0; ASSERT Result[5] 0; ASSERT Result[6] 0; ASSERT Result[7] 0; ASSERT Result[8] 0; ASSERT Result[9] 0; ASSERT Result[10] 0; ASSERT Result[11] 0; ASSERT Result[12] 0; ASSERT Result[13] 0; ASSERT Result[14] 0; ASSERT Result[15] 1;
