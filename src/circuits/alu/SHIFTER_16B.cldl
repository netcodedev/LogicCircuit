CIRCUIT SHIFTER_16B {
    // 16-bit barrel shifter: shifts A by Amt (0..15) bits.
    //
    //   op    Left Rot Arith
    //   SHL    1    0    0     zeros in from the right
    //   SHR    0    0    0     zeros in from the left
    //   SAR    0    0    1     copies of A[15] in from the left
    //   ROL    1    1    0
    //   ROR    0    1    0
    //
    // A rotator plus a mask: four stages rotate right (by 1, 2, 4, 8), a left
    // rotation by n is a right rotation by 16 - n (the stage selects are the
    // two's complement of Amt when Left = 1). For shifts, the bits that came
    // around are then replaced by the fill bit: Keep marks the bits that
    // stay (Amt zeros shifted in from the left into a word of ones gives the
    // mask of a right shift; read in reverse, that of a left shift). The
    // word passes the four stage muxes and one output mux, the mask is built
    // alongside. Arith must be 0 for left shifts.
    INPUT A[16];
    INPUT Amt[4];
    INPUT Left;
    INPUT Rot;
    INPUT Arith;

    OUTPUT Out[16];

    // Rotation amount: Amt, or 16 - Amt for left (-n: bit k = n[k] XOR
    // (n[0] OR ... OR n[k-1]))
    PART Or01: OR;
    PART Or012: OR;
    PART Neg1And: AND;
    PART Neg2And: AND;
    PART Neg3And: AND;
    PART R1Xor: XOR;
    PART R2Xor: XOR;
    PART R3Xor: XOR;
    PART Stage1: ROT_STAGE<16, 1>;
    PART Stage2: ROT_STAGE<16, 2>;
    PART Stage4: ROT_STAGE<16, 4>;
    PART Stage8: ROT_STAGE<16, 8>;

    // Mask: ones shifted right by Amt, zeros in
    PART C_TRUE: NOR;              // Constant 1 (VCC), NOR(0,0) = 1
    PART C_FALSE: AND;             // Constant 0: AND(0,0) = 0
    PART Mask1: SHIFT_STAGE<16, 1>;
    PART Mask2: SHIFT_STAGE<16, 2>;
    PART Mask4: SHIFT_STAGE<16, 4>;
    PART Mask8: SHIFT_STAGE<16, 8>;
    PART KeepMux: MUX_2_1_BUS<16>; // right mask, reversed (left) mask
    PART KeepOr: OR_BUS<16>;       // ... or Rot: keep every bit
    PART FillAnd: AND;             // fill bit = Arith AND A[15]
    FOR i IN 0..16 {
        PART OutMux[i]: MUX_2_1;   // fill, rotated bit
    }

    CONNECT Amt[0] -> Or01.in1;
    CONNECT Amt[1] -> Or01.in2;
    CONNECT Or01.out -> Or012.in1;
    CONNECT Amt[2] -> Or012.in2;
    CONNECT Left -> Neg1And.in1;
    CONNECT Amt[0] -> Neg1And.in2;
    CONNECT Left -> Neg2And.in1;
    CONNECT Or01.out -> Neg2And.in2;
    CONNECT Left -> Neg3And.in1;
    CONNECT Or012.out -> Neg3And.in2;
    CONNECT Amt[1] -> R1Xor.in1;
    CONNECT Neg1And.out -> R1Xor.in2;
    CONNECT Amt[2] -> R2Xor.in1;
    CONNECT Neg2And.out -> R2Xor.in2;
    CONNECT Amt[3] -> R3Xor.in1;
    CONNECT Neg3And.out -> R3Xor.in2;

    CONNECT A -> Stage1.In;
    CONNECT Stage1.Out -> Stage2.In;
    CONNECT Stage2.Out -> Stage4.In;
    CONNECT Stage4.Out -> Stage8.In;
    CONNECT Amt[0] -> Stage1.Sel;
    CONNECT R1Xor.out -> Stage2.Sel;
    CONNECT R2Xor.out -> Stage4.Sel;
    CONNECT R3Xor.out -> Stage8.Sel;

    CONNECT C_TRUE.out -> Mask1.In;      // tee: all ones
    CONNECT Mask1.Out -> Mask2.In;
    CONNECT Mask2.Out -> Mask4.In;
    CONNECT Mask4.Out -> Mask8.In;
    CONNECT Amt[0] -> Mask1.Sel;
    CONNECT Amt[1] -> Mask2.Sel;
    CONNECT Amt[2] -> Mask4.Sel;
    CONNECT Amt[3] -> Mask8.Sel;
    CONNECT C_FALSE.out -> Mask1.Rot;
    CONNECT C_FALSE.out -> Mask2.Rot;
    CONNECT C_FALSE.out -> Mask4.Rot;
    CONNECT C_FALSE.out -> Mask8.Rot;
    CONNECT C_FALSE.out -> Mask1.Fill;
    CONNECT C_FALSE.out -> Mask2.Fill;
    CONNECT C_FALSE.out -> Mask4.Fill;
    CONNECT C_FALSE.out -> Mask8.Fill;
    CONNECT Mask8.Out -> KeepMux.A;
    FOR i IN 0..16 {
        CONNECT Mask8.Out[15-i] -> KeepMux.B[i];
    }
    CONNECT Left -> KeepMux.S;
    CONNECT KeepMux.Out -> KeepOr.A;
    CONNECT Rot -> KeepOr.B;             // tee

    CONNECT Arith -> FillAnd.in1;
    CONNECT A[15] -> FillAnd.in2;
    FOR i IN 0..16 {
        CONNECT FillAnd.out -> OutMux[i].A;
        CONNECT Stage8.Out[i] -> OutMux[i].B;
        CONNECT KeepOr.Out[i] -> OutMux[i].S;
        CONNECT OutMux[i].Out -> Out[i];
    }
}
