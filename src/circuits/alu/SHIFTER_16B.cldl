CIRCUIT SHIFTER_16B {
    // 16-bit barrel shifter: shifts A by Amt (0..15) bits.
    //
    //   op    Left Rot Arith
    //   SHL    1    0    0     zeros in from the right
    //   SHR    0    0    0     zeros in from the left
    //   SAR    0    0    1     copies of A[15] in from the left
    //   ROL    1    1    0
    //   ROR    0    1    0
    //
    // The four stages only shift right (by 1, 2, 4, 8). Left shifts reverse
    // the bit order before and after, so a right shift of the reversed word
    // is a left shift of the original. Arith must be 0 for left shifts.
    INPUT A[16];
    INPUT Amt[4];
    INPUT Left;
    INPUT Rot;
    INPUT Arith;

    OUTPUT Out[16];

    PART RevIn: MUX_2_1_BUS<16>;   // Left=1: reversed A
    PART Stage1: SHIFT_STAGE<16, 1>;
    PART Stage2: SHIFT_STAGE<16, 2>;
    PART Stage4: SHIFT_STAGE<16, 4>;
    PART Stage8: SHIFT_STAGE<16, 8>;
    PART RevOut: MUX_2_1_BUS<16>;  // Left=1: reverse back
    PART FillAnd: AND;             // fill bit = Arith AND A[15]

    // Input reversal
    CONNECT A -> RevIn.A;
    FOR i IN 0..16 {
        CONNECT A[15-i] -> RevIn.B[i];
    }
    CONNECT Left -> RevIn.S;

    CONNECT Arith -> FillAnd.in1;
    CONNECT A[15] -> FillAnd.in2;

    // Stages: shift by 1, 2, 4, 8 when the matching Amt bit is set.
    CONNECT RevIn.Out -> Stage1.In;
    CONNECT Stage1.Out -> Stage2.In;
    CONNECT Stage2.Out -> Stage4.In;
    CONNECT Stage4.Out -> Stage8.In;
    CONNECT Amt[0] -> Stage1.Sel;
    CONNECT Amt[1] -> Stage2.Sel;
    CONNECT Amt[2] -> Stage4.Sel;
    CONNECT Amt[3] -> Stage8.Sel;
    CONNECT Rot -> Stage1.Rot;
    CONNECT Rot -> Stage2.Rot;
    CONNECT Rot -> Stage4.Rot;
    CONNECT Rot -> Stage8.Rot;
    CONNECT FillAnd.out -> Stage1.Fill;
    CONNECT FillAnd.out -> Stage2.Fill;
    CONNECT FillAnd.out -> Stage4.Fill;
    CONNECT FillAnd.out -> Stage8.Fill;

    // Output reversal
    CONNECT Stage8.Out -> RevOut.A;
    FOR i IN 0..16 {
        CONNECT Stage8.Out[15-i] -> RevOut.B[i];
    }
    CONNECT Left -> RevOut.S;
    CONNECT RevOut.Out -> Out;
}
