CIRCUIT SHIFT_STAGE_R<W, S> {
    // One stage of a right shifter: with Sel=1, Out = In shifted right by S
    // bits with Fill shifted in at the top; with Sel=0, Out = In. Unlike
    // SHIFT_STAGE it cannot rotate, so every bit is a single 2:1 mux.
    INPUT In[W];
    INPUT Sel;
    INPUT Fill;

    OUTPUT Out[W];

    FOR i IN 0..W {
        PART Mux[i]: MUX_2_1;
        CONNECT In[i] -> Mux[i].A;
        CONNECT Sel -> Mux[i].S;
        CONNECT Mux[i].Out -> Out[i];
    }
    FOR i IN 0..W-S {
        CONNECT In[i+S] -> Mux[i].B;
    }
    FOR i IN W-S..W {
        CONNECT Fill -> Mux[i].B;
    }
}
