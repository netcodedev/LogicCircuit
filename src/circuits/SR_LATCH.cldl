CIRCUIT SRLatch {
    INPUT nS, nR;
    OUTPUT Q, nQ;

    PART G_Q: NAND;  // This gate's output is Q
    PART G_nQ: NAND; // This gate's output is nQ

    CONNECT nS -> G_Q.in1;
    CONNECT nR -> G_nQ.in1;

    CONNECT G_nQ.out -> G_Q.in2;
    CONNECT G_Q.out -> G_nQ.in2;

    CONNECT G_Q.out -> Q;
    CONNECT G_nQ.out -> nQ;
}