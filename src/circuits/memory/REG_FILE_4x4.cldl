CIRCUIT REG_FILE_4x4 {
    // A 4-register file, each register is 4 bits wide.
    // Features two read ports (A and B) and one write port.

    // --- Inputs ---
    INPUT DataIn[4];     // Data to write
    INPUT WriteAddr[2];  // Address (0-3) to write to
    INPUT WriteEnable;   // 1 to write, 0 to hold
    INPUT ReadAddrA[2];  // Address (0-3) for read port A
    INPUT ReadAddrB[2];  // Address (0-3) for read port B
    INPUT CLK;           // Clock signal

    // --- Outputs ---
    OUTPUT DataOutA[4];   // Data from read port A
    OUTPUT DataOutB[4];   // Data from read port B

    // --- Storage Parts ---
    PART R0: REGISTER_4B;
    PART R1: REGISTER_4B;
    PART R2: REGISTER_4B;
    PART R3: REGISTER_4B;

    // --- Write Logic Parts ---
    PART WriteDecoder: DECODER_2_4;

    // --- Read Logic Parts ---
    PART ReadMuxA: MUX_4B_4_1;
    PART ReadMuxB: MUX_4B_4_1;

    // --- Connections ---

    // 1. Write Logic:
    // Connect the decoder to the Write Address and Enable.
    CONNECT WriteAddr -> WriteDecoder.A;
    CONNECT WriteEnable -> WriteDecoder.Enable;

    // Connect the decoder outputs to the Load pin of each register.
    CONNECT WriteDecoder.O[0] -> R0.Load;
    CONNECT WriteDecoder.O[1] -> R1.Load;
    CONNECT WriteDecoder.O[2] -> R2.Load;
    CONNECT WriteDecoder.O[3] -> R3.Load;

    // Fan-out the DataIn bus to all four registers.
    // R0 Data Input
    CONNECT DataIn -> R0.Data;
    // R1 Data Input
    CONNECT DataIn -> R1.Data;
    // R2 Data Input
    CONNECT DataIn -> R2.Data;
    // R3 Data Input
    CONNECT DataIn -> R3.Data;

    // 2. Read Logic (Port A):
    // Connect register outputs (Q bus) to Mux A inputs.
    CONNECT R0.Q -> ReadMuxA.In0;
    CONNECT R1.Q -> ReadMuxA.In1;
    CONNECT R2.Q -> ReadMuxA.In2;
    CONNECT R3.Q -> ReadMuxA.In3;
    
    // Connect Read Address A to Mux A Select.
    CONNECT ReadAddrA -> ReadMuxA.S;
    
    // Connect Mux A Output to DataOutA.
    CONNECT ReadMuxA.Out -> DataOutA;

    // 3. Read Logic (Port B):
    // Connect register outputs (Q bus) to Mux B inputs.
    CONNECT R0.Q -> ReadMuxB.In0;
    CONNECT R1.Q -> ReadMuxB.In1;
    CONNECT R2.Q -> ReadMuxB.In2;
    CONNECT R3.Q -> ReadMuxB.In3;

    // Connect Read Address B to Mux B Select.
    CONNECT ReadAddrB -> ReadMuxB.S;

    // Connect Mux B Output to DataOutB.
    CONNECT ReadMuxB.Out -> DataOutB;

    // 4. Clock Connection:
    // Fan-out the master clock to all four registers.
    CONNECT CLK -> R0.CLK;
    CONNECT CLK -> R1.CLK;
    CONNECT CLK -> R2.CLK;
    CONNECT CLK -> R3.CLK;
}

