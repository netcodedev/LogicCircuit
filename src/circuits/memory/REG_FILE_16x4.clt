// Test suite for the 16x4 Register File (with R0 hardwired to 0)

TESTS FOR REG_FILE_16x4 {
    TEST "Initial State: Read R0 and R15" {
        // Registers R1-R15 are initialized to 0 by their own INIT blocks.
        // R0 is hardwired to 0.
        SET ReadAddrA[0] 0, ReadAddrA[1] 0, ReadAddrA[2] 0, ReadAddrA[3] 0; // Read R0
        SET ReadAddrB[0] 1, ReadAddrB[1] 1, ReadAddrB[2] 1, ReadAddrB[3] 1; // Read R15
        EVAL;
        
        ASSERT DataOutA[0] 0; ASSERT DataOutA[1] 0; ASSERT DataOutA[2] 0; ASSERT DataOutA[3] 0;
        ASSERT DataOutB[0] 0; ASSERT DataOutB[1] 0; ASSERT DataOutB[2] 0; ASSERT DataOutB[3] 0;
    }

    TEST "Write R15, Read R15 (Port A)" {
        // Write 10 (1010) to R15
        SET DataIn[0] 0, DataIn[1] 1, DataIn[2] 0, DataIn[3] 1;
        SET WriteAddr[0] 1, WriteAddr[1] 1, WriteAddr[2] 1, WriteAddr[3] 1; // Addr 15
        SET WriteEnable 1;
        SEQ CLK 0 -> CLK 1 -> CLK 0;
        
        // Stop writing, Read R15 from Port A
        SET WriteEnable 0;
        SET ReadAddrA[0] 1, ReadAddrA[1] 1, ReadAddrA[2] 1, ReadAddrA[3] 1; // Read R15
        EVAL;
        
        // Assert output is 10
        ASSERT DataOutA[0] 0;
        ASSERT DataOutA[1] 1;
        ASSERT DataOutA[2] 0;
        ASSERT DataOutA[3] 1;
    }

    TEST "Write R1, Read R1 (Port B) and R15 (Port A)" {
        // Write 5 (0101) to R1
        SET DataIn[0] 1, DataIn[1] 0, DataIn[2] 1, DataIn[3] 0;
        SET WriteAddr[0] 1, WriteAddr[1] 0, WriteAddr[2] 0, WriteAddr[3] 0; // Addr 1
        SET WriteEnable 1;
        SEQ CLK 0 -> CLK 1 -> CLK 0;
        
        // Stop writing
        SET WriteEnable 0;
        
        // Read R15 from Port A (should still be 10)
        SET ReadAddrA[0] 1, ReadAddrA[1] 1, ReadAddrA[2] 1, ReadAddrA[3] 1;
        // Read R1 from Port B
        SET ReadAddrB[0] 1, ReadAddrB[1] 0, ReadAddrB[2] 0, ReadAddrB[3] 0;
        EVAL;
        
        // Assert Port A (R15) is 10
        ASSERT DataOutA[0] 0;
        ASSERT DataOutA[1] 1;
        ASSERT DataOutA[2] 0;
        ASSERT DataOutA[3] 1;
        
        // Assert Port B (R1) is 5
        ASSERT DataOutB[0] 1;
        ASSERT DataOutB[1] 0;
        ASSERT DataOutB[2] 1;
        ASSERT DataOutB[3] 0;
    }

    TEST "Test R0 Hardwire: Attempt Write R0, Read R0" {
        // Attempt to write 9 (1001) to R0
        SET DataIn[0] 1, DataIn[1] 0, DataIn[2] 0, DataIn[3] 1;
        SET WriteAddr[0] 0, WriteAddr[1] 0, WriteAddr[2] 0, WriteAddr[3] 0; // Addr 0
        SET WriteEnable 1;
        SEQ CLK 0 -> CLK 1 -> CLK 0; // Clock pulse
        
        // Stop writing
        SET WriteEnable 0;
        
        // Read R0 from Port A
        SET ReadAddrA[0] 0, ReadAddrA[1] 0, ReadAddrA[2] 0, ReadAddrA[3] 0;
        EVAL;
        
        // Assert R0 is still 0 (write was ignored)
        ASSERT DataOutA[0] 0;
        ASSERT DataOutA[1] 0;
        ASSERT DataOutA[2] 0;
        ASSERT DataOutA[3] 0;
    }

    TEST "Test R0 Hardwire: Read R0 (Port B)" {
        // Read R0 from Port B
        SET ReadAddrB[0] 0, ReadAddrB[1] 0, ReadAddrB[2] 0, ReadAddrB[3] 0;
        EVAL;
        
        // Assert R0 is 0
        ASSERT DataOutB[0] 0;
        ASSERT DataOutB[1] 0;
        ASSERT DataOutB[2] 0;
        ASSERT DataOutB[3] 0;
    }

    TEST "Write mid-file R7, read on both ports" {
        // Write 12 (1100) to R7 (addr 0111)
        SET DataIn[0] 0, DataIn[1] 0, DataIn[2] 1, DataIn[3] 1;
        SET WriteAddr[0] 1, WriteAddr[1] 1, WriteAddr[2] 1, WriteAddr[3] 0;
        SET WriteEnable 1;
        SEQ CLK 0 -> CLK 1 -> CLK 0;

        SET WriteEnable 0;
        SET ReadAddrA[0] 1, ReadAddrA[1] 1, ReadAddrA[2] 1, ReadAddrA[3] 0; // R7 on A
        SET ReadAddrB[0] 1, ReadAddrB[1] 1, ReadAddrB[2] 1, ReadAddrB[3] 0; // R7 on B
        EVAL;
        ASSERT DataOutA[0] 0; ASSERT DataOutA[1] 0; ASSERT DataOutA[2] 1; ASSERT DataOutA[3] 1;
        ASSERT DataOutB[0] 0; ASSERT DataOutB[1] 0; ASSERT DataOutB[2] 1; ASSERT DataOutB[3] 1;
    }

    TEST "WriteEnable=0 holds R7; untouched R8 reads 0" {
        // Attempt to overwrite R7 (holds 12) with 3 (0011) while WriteEnable=0
        SET DataIn[0] 1, DataIn[1] 1, DataIn[2] 0, DataIn[3] 0;
        SET WriteAddr[0] 1, WriteAddr[1] 1, WriteAddr[2] 1, WriteAddr[3] 0; // Addr 7
        SET WriteEnable 0;
        SEQ CLK 0 -> CLK 1 -> CLK 0;

        SET ReadAddrA[0] 1, ReadAddrA[1] 1, ReadAddrA[2] 1, ReadAddrA[3] 0; // R7
        SET ReadAddrB[0] 0, ReadAddrB[1] 0, ReadAddrB[2] 0, ReadAddrB[3] 1; // R8 (1000)
        EVAL;
        ASSERT DataOutA[0] 0; ASSERT DataOutA[1] 0; ASSERT DataOutA[2] 1; ASSERT DataOutA[3] 1; // R7 still 12
        ASSERT DataOutB[0] 0; ASSERT DataOutB[1] 0; ASSERT DataOutB[2] 0; ASSERT DataOutB[3] 0; // R8 = 0
    }
}
