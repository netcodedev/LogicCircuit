// Tests for REG_FILE_32<W> (x0 hardwired 0) at W = 32
//
// Generated by `cargo test --release --lib riscv::clt_gen -- --ignored`
// from the simulator; the circuit is checked against Rust references and the
// instruction-level simulator in src/riscv/tests.rs and cpu_tests.rs.

TESTS FOR REG_FILE_32<32> {
    TEST "write every register, read it back on both ports" {
        SET DataIn[31:0] 0x0000001F, WriteAddr[4:0] 0x00, WriteEnable 1, ReadAddrA[4:0] 0x00, ReadAddrB[4:0] 0x1F;
        SEQ CLK 0 -> CLK 1 -> CLK 0;
        EVAL;
        ASSERT DataOutA[31:0] 0x00000000; ASSERT DataOutB[31:0] 0x00000000;
        SET DataIn[31:0] 0xFFFFFFFF, WriteAddr[4:0] 0x01, WriteEnable 1, ReadAddrA[4:0] 0x01, ReadAddrB[4:0] 0x00;
        SEQ CLK 0 -> CLK 1 -> CLK 0;
        EVAL;
        ASSERT DataOutA[31:0] 0xFFFFFFFF; ASSERT DataOutB[31:0] 0x00000000;
        SET DataIn[31:0] 0x0000001F, WriteAddr[4:0] 0x02, WriteEnable 1, ReadAddrA[4:0] 0x02, ReadAddrB[4:0] 0x01;
        SEQ CLK 0 -> CLK 1 -> CLK 0;
        EVAL;
        ASSERT DataOutA[31:0] 0x0000001F; ASSERT DataOutB[31:0] 0xFFFFFFFF;
        SET DataIn[31:0] 0xFFFFFFFD, WriteAddr[4:0] 0x03, WriteEnable 1, ReadAddrA[4:0] 0x03, ReadAddrB[4:0] 0x02;
        SEQ CLK 0 -> CLK 1 -> CLK 0;
        EVAL;
        ASSERT DataOutA[31:0] 0xFFFFFFFD; ASSERT DataOutB[31:0] 0x0000001F;
        SET DataIn[31:0] 0xFFFFFFBF, WriteAddr[4:0] 0x04, WriteEnable 1, ReadAddrA[4:0] 0x04, ReadAddrB[4:0] 0x03;
        SEQ CLK 0 -> CLK 1 -> CLK 0;
        EVAL;
        ASSERT DataOutA[31:0] 0xFFFFFFBF; ASSERT DataOutB[31:0] 0xFFFFFFFD;
        SET DataIn[31:0] 0x4A25CAE7, WriteAddr[4:0] 0x05, WriteEnable 1, ReadAddrA[4:0] 0x05, ReadAddrB[4:0] 0x04;
        SEQ CLK 0 -> CLK 1 -> CLK 0;
        EVAL;
        ASSERT DataOutA[31:0] 0x4A25CAE7; ASSERT DataOutB[31:0] 0xFFFFFFBF;
        SET DataIn[31:0] 0xFFFFFF53, WriteAddr[4:0] 0x06, WriteEnable 1, ReadAddrA[4:0] 0x06, ReadAddrB[4:0] 0x05;
        SEQ CLK 0 -> CLK 1 -> CLK 0;
        EVAL;
        ASSERT DataOutA[31:0] 0xFFFFFF53; ASSERT DataOutB[31:0] 0x4A25CAE7;
        SET DataIn[31:0] 0x00000021, WriteAddr[4:0] 0x07, WriteEnable 1, ReadAddrA[4:0] 0x07, ReadAddrB[4:0] 0x06;
        SEQ CLK 0 -> CLK 1 -> CLK 0;
        EVAL;
        ASSERT DataOutA[31:0] 0x00000021; ASSERT DataOutB[31:0] 0xFFFFFF53;
        SET DataIn[31:0] 0x7D5EC211, WriteAddr[4:0] 0x08, WriteEnable 1, ReadAddrA[4:0] 0x08, ReadAddrB[4:0] 0x07;
        SEQ CLK 0 -> CLK 1 -> CLK 0;
        EVAL;
        ASSERT DataOutA[31:0] 0x7D5EC211; ASSERT DataOutB[31:0] 0x00000021;
        SET DataIn[31:0] 0xFA41A373, WriteAddr[4:0] 0x09, WriteEnable 1, ReadAddrA[4:0] 0x09, ReadAddrB[4:0] 0x08;
        SEQ CLK 0 -> CLK 1 -> CLK 0;
        EVAL;
        ASSERT DataOutA[31:0] 0xFA41A373; ASSERT DataOutB[31:0] 0x7D5EC211;
        SET DataIn[31:0] 0x2160C2A7, WriteAddr[4:0] 0x0A, WriteEnable 1, ReadAddrA[4:0] 0x0A, ReadAddrB[4:0] 0x09;
        SEQ CLK 0 -> CLK 1 -> CLK 0;
        EVAL;
        ASSERT DataOutA[31:0] 0x2160C2A7; ASSERT DataOutB[31:0] 0xFA41A373;
        SET DataIn[31:0] 0x59A8B8AF, WriteAddr[4:0] 0x0B, WriteEnable 1, ReadAddrA[4:0] 0x0B, ReadAddrB[4:0] 0x0A;
        SEQ CLK 0 -> CLK 1 -> CLK 0;
        EVAL;
        ASSERT DataOutA[31:0] 0x59A8B8AF; ASSERT DataOutB[31:0] 0x2160C2A7;
        SET DataIn[31:0] 0xFFFFFF8B, WriteAddr[4:0] 0x0C, WriteEnable 1, ReadAddrA[4:0] 0x0C, ReadAddrB[4:0] 0x0B;
        SEQ CLK 0 -> CLK 1 -> CLK 0;
        EVAL;
        ASSERT DataOutA[31:0] 0xFFFFFF8B; ASSERT DataOutB[31:0] 0x59A8B8AF;
        SET DataIn[31:0] 0x5582C93B, WriteAddr[4:0] 0x0D, WriteEnable 1, ReadAddrA[4:0] 0x0D, ReadAddrB[4:0] 0x0C;
        SEQ CLK 0 -> CLK 1 -> CLK 0;
        EVAL;
        ASSERT DataOutA[31:0] 0x5582C93B; ASSERT DataOutB[31:0] 0xFFFFFF8B;
        SET DataIn[31:0] 0xFFFFFFB3, WriteAddr[4:0] 0x0E, WriteEnable 1, ReadAddrA[4:0] 0x0E, ReadAddrB[4:0] 0x0D;
        SEQ CLK 0 -> CLK 1 -> CLK 0;
        EVAL;
        ASSERT DataOutA[31:0] 0xFFFFFFB3; ASSERT DataOutB[31:0] 0x5582C93B;
        SET DataIn[31:0] 0x000000A7, WriteAddr[4:0] 0x0F, WriteEnable 1, ReadAddrA[4:0] 0x0F, ReadAddrB[4:0] 0x0E;
        SEQ CLK 0 -> CLK 1 -> CLK 0;
        EVAL;
        ASSERT DataOutA[31:0] 0x000000A7; ASSERT DataOutB[31:0] 0xFFFFFFB3;
        SET DataIn[31:0] 0xB48CCAAF, WriteAddr[4:0] 0x10, WriteEnable 1, ReadAddrA[4:0] 0x10, ReadAddrB[4:0] 0x0F;
        SEQ CLK 0 -> CLK 1 -> CLK 0;
        EVAL;
        ASSERT DataOutA[31:0] 0xB48CCAAF; ASSERT DataOutB[31:0] 0x000000A7;
        SET DataIn[31:0] 0xB7E85BC3, WriteAddr[4:0] 0x11, WriteEnable 1, ReadAddrA[4:0] 0x11, ReadAddrB[4:0] 0x10;
        SEQ CLK 0 -> CLK 1 -> CLK 0;
        EVAL;
        ASSERT DataOutA[31:0] 0xB7E85BC3; ASSERT DataOutB[31:0] 0xB48CCAAF;
        SET DataIn[31:0] 0x00000001, WriteAddr[4:0] 0x12, WriteEnable 1, ReadAddrA[4:0] 0x12, ReadAddrB[4:0] 0x11;
        SEQ CLK 0 -> CLK 1 -> CLK 0;
        EVAL;
        ASSERT DataOutA[31:0] 0x00000001; ASSERT DataOutB[31:0] 0xB7E85BC3;
        SET DataIn[31:0] 0x5406DE3D, WriteAddr[4:0] 0x13, WriteEnable 1, ReadAddrA[4:0] 0x13, ReadAddrB[4:0] 0x12;
        SEQ CLK 0 -> CLK 1 -> CLK 0;
        EVAL;
        ASSERT DataOutA[31:0] 0x5406DE3D; ASSERT DataOutB[31:0] 0x00000001;
        SET DataIn[31:0] 0xEEEE2C1F, WriteAddr[4:0] 0x14, WriteEnable 1, ReadAddrA[4:0] 0x14, ReadAddrB[4:0] 0x13;
        SEQ CLK 0 -> CLK 1 -> CLK 0;
        EVAL;
        ASSERT DataOutA[31:0] 0xEEEE2C1F; ASSERT DataOutB[31:0] 0x5406DE3D;
        SET DataIn[31:0] 0x45087C67, WriteAddr[4:0] 0x15, WriteEnable 1, ReadAddrA[4:0] 0x15, ReadAddrB[4:0] 0x14;
        SEQ CLK 0 -> CLK 1 -> CLK 0;
        EVAL;
        ASSERT DataOutA[31:0] 0x45087C67; ASSERT DataOutB[31:0] 0xEEEE2C1F;
        SET DataIn[31:0] 0xE6718447, WriteAddr[4:0] 0x16, WriteEnable 1, ReadAddrA[4:0] 0x16, ReadAddrB[4:0] 0x15;
        SEQ CLK 0 -> CLK 1 -> CLK 0;
        EVAL;
        ASSERT DataOutA[31:0] 0xE6718447; ASSERT DataOutB[31:0] 0x45087C67;
        SET DataIn[31:0] 0x5C663665, WriteAddr[4:0] 0x17, WriteEnable 1, ReadAddrA[4:0] 0x17, ReadAddrB[4:0] 0x16;
        SEQ CLK 0 -> CLK 1 -> CLK 0;
        EVAL;
        ASSERT DataOutA[31:0] 0x5C663665; ASSERT DataOutB[31:0] 0xE6718447;
        SET DataIn[31:0] 0xE33361AB, WriteAddr[4:0] 0x18, WriteEnable 1, ReadAddrA[4:0] 0x18, ReadAddrB[4:0] 0x17;
        SEQ CLK 0 -> CLK 1 -> CLK 0;
        EVAL;
        ASSERT DataOutA[31:0] 0xE33361AB; ASSERT DataOutB[31:0] 0x5C663665;
        SET DataIn[31:0] 0xFABF1BFB, WriteAddr[4:0] 0x19, WriteEnable 1, ReadAddrA[4:0] 0x19, ReadAddrB[4:0] 0x18;
        SEQ CLK 0 -> CLK 1 -> CLK 0;
        EVAL;
        ASSERT DataOutA[31:0] 0xFABF1BFB; ASSERT DataOutB[31:0] 0xE33361AB;
        SET DataIn[31:0] 0x00000021, WriteAddr[4:0] 0x1A, WriteEnable 1, ReadAddrA[4:0] 0x1A, ReadAddrB[4:0] 0x19;
        SEQ CLK 0 -> CLK 1 -> CLK 0;
        EVAL;
        ASSERT DataOutA[31:0] 0x00000021; ASSERT DataOutB[31:0] 0xFABF1BFB;
        SET DataIn[31:0] 0x00000001, WriteAddr[4:0] 0x1B, WriteEnable 1, ReadAddrA[4:0] 0x1B, ReadAddrB[4:0] 0x1A;
        SEQ CLK 0 -> CLK 1 -> CLK 0;
        EVAL;
        ASSERT DataOutA[31:0] 0x00000001; ASSERT DataOutB[31:0] 0x00000021;
        SET DataIn[31:0] 0x000000E7, WriteAddr[4:0] 0x1C, WriteEnable 1, ReadAddrA[4:0] 0x1C, ReadAddrB[4:0] 0x1B;
        SEQ CLK 0 -> CLK 1 -> CLK 0;
        EVAL;
        ASSERT DataOutA[31:0] 0x000000E7; ASSERT DataOutB[31:0] 0x00000001;
        SET DataIn[31:0] 0xF4A2474F, WriteAddr[4:0] 0x1D, WriteEnable 1, ReadAddrA[4:0] 0x1D, ReadAddrB[4:0] 0x1C;
        SEQ CLK 0 -> CLK 1 -> CLK 0;
        EVAL;
        ASSERT DataOutA[31:0] 0xF4A2474F; ASSERT DataOutB[31:0] 0x000000E7;
        SET DataIn[31:0] 0xFFFFFF25, WriteAddr[4:0] 0x1E, WriteEnable 1, ReadAddrA[4:0] 0x1E, ReadAddrB[4:0] 0x1D;
        SEQ CLK 0 -> CLK 1 -> CLK 0;
        EVAL;
        ASSERT DataOutA[31:0] 0xFFFFFF25; ASSERT DataOutB[31:0] 0xF4A2474F;
        SET DataIn[31:0] 0xFFFFFFC9, WriteAddr[4:0] 0x1F, WriteEnable 1, ReadAddrA[4:0] 0x1F, ReadAddrB[4:0] 0x1E;
        SEQ CLK 0 -> CLK 1 -> CLK 0;
        EVAL;
        ASSERT DataOutA[31:0] 0xFFFFFFC9; ASSERT DataOutB[31:0] 0xFFFFFF25;
    }

    TEST "disabled writes change nothing; random reads" {
        SET DataIn[31:0] 0x7C88C5DB, WriteAddr[4:0] 0x1D, WriteEnable 0, ReadAddrA[4:0] 0x0C, ReadAddrB[4:0] 0x0F;
        SEQ CLK 0 -> CLK 1 -> CLK 0;
        EVAL;
        ASSERT DataOutA[31:0] 0xFFFFFF8B; ASSERT DataOutB[31:0] 0x000000A7;
        SET DataIn[31:0] 0x34156370, WriteAddr[4:0] 0x0C, WriteEnable 0, ReadAddrA[4:0] 0x1E, ReadAddrB[4:0] 0x11;
        SEQ CLK 0 -> CLK 1 -> CLK 0;
        EVAL;
        ASSERT DataOutA[31:0] 0xFFFFFF25; ASSERT DataOutB[31:0] 0xB7E85BC3;
        SET DataIn[31:0] 0x00000001, WriteAddr[4:0] 0x06, WriteEnable 0, ReadAddrA[4:0] 0x15, ReadAddrB[4:0] 0x1B;
        SEQ CLK 0 -> CLK 1 -> CLK 0;
        EVAL;
        ASSERT DataOutA[31:0] 0x45087C67; ASSERT DataOutB[31:0] 0x00000001;
        SET DataIn[31:0] 0x651D09D2, WriteAddr[4:0] 0x1C, WriteEnable 0, ReadAddrA[4:0] 0x07, ReadAddrB[4:0] 0x0C;
        SEQ CLK 0 -> CLK 1 -> CLK 0;
        EVAL;
        ASSERT DataOutA[31:0] 0x00000021; ASSERT DataOutB[31:0] 0xFFFFFF8B;
        SET DataIn[31:0] 0xFFFFFF39, WriteAddr[4:0] 0x1B, WriteEnable 0, ReadAddrA[4:0] 0x0E, ReadAddrB[4:0] 0x14;
        SEQ CLK 0 -> CLK 1 -> CLK 0;
        EVAL;
        ASSERT DataOutA[31:0] 0xFFFFFFB3; ASSERT DataOutB[31:0] 0xEEEE2C1F;
        SET DataIn[31:0] 0x72C1FD64, WriteAddr[4:0] 0x04, WriteEnable 0, ReadAddrA[4:0] 0x0C, ReadAddrB[4:0] 0x04;
        SEQ CLK 0 -> CLK 1 -> CLK 0;
        EVAL;
        ASSERT DataOutA[31:0] 0xFFFFFF8B; ASSERT DataOutB[31:0] 0xFFFFFFBF;
        SET DataIn[31:0] 0x0000001F, WriteAddr[4:0] 0x09, WriteEnable 0, ReadAddrA[4:0] 0x0B, ReadAddrB[4:0] 0x1F;
        SEQ CLK 0 -> CLK 1 -> CLK 0;
        EVAL;
        ASSERT DataOutA[31:0] 0x59A8B8AF; ASSERT DataOutB[31:0] 0xFFFFFFC9;
        SET DataIn[31:0] 0x04C7BD00, WriteAddr[4:0] 0x05, WriteEnable 0, ReadAddrA[4:0] 0x1A, ReadAddrB[4:0] 0x07;
        SEQ CLK 0 -> CLK 1 -> CLK 0;
        EVAL;
        ASSERT DataOutA[31:0] 0x00000021; ASSERT DataOutB[31:0] 0x00000021;
        SET DataIn[31:0] 0x871964BA, WriteAddr[4:0] 0x1A, WriteEnable 0, ReadAddrA[4:0] 0x10, ReadAddrB[4:0] 0x09;
        SEQ CLK 0 -> CLK 1 -> CLK 0;
        EVAL;
        ASSERT DataOutA[31:0] 0xB48CCAAF; ASSERT DataOutB[31:0] 0xFA41A373;
        SET DataIn[31:0] 0x6DCC2594, WriteAddr[4:0] 0x10, WriteEnable 0, ReadAddrA[4:0] 0x1C, ReadAddrB[4:0] 0x07;
        SEQ CLK 0 -> CLK 1 -> CLK 0;
        EVAL;
        ASSERT DataOutA[31:0] 0x000000E7; ASSERT DataOutB[31:0] 0x00000021;
        SET DataIn[31:0] 0x80000000, WriteAddr[4:0] 0x08, WriteEnable 0, ReadAddrA[4:0] 0x0F, ReadAddrB[4:0] 0x0F;
        SEQ CLK 0 -> CLK 1 -> CLK 0;
        EVAL;
        ASSERT DataOutA[31:0] 0x000000A7; ASSERT DataOutB[31:0] 0x000000A7;
        SET DataIn[31:0] 0x44AD6C0E, WriteAddr[4:0] 0x12, WriteEnable 0, ReadAddrA[4:0] 0x0B, ReadAddrB[4:0] 0x0E;
        SEQ CLK 0 -> CLK 1 -> CLK 0;
        EVAL;
        ASSERT DataOutA[31:0] 0x59A8B8AF; ASSERT DataOutB[31:0] 0xFFFFFFB3;
        SET DataIn[31:0] 0xFFFFFF03, WriteAddr[4:0] 0x07, WriteEnable 0, ReadAddrA[4:0] 0x0E, ReadAddrB[4:0] 0x00;
        SEQ CLK 0 -> CLK 1 -> CLK 0;
        EVAL;
        ASSERT DataOutA[31:0] 0xFFFFFFB3; ASSERT DataOutB[31:0] 0x00000000;
        SET DataIn[31:0] 0x86883AAA, WriteAddr[4:0] 0x03, WriteEnable 0, ReadAddrA[4:0] 0x18, ReadAddrB[4:0] 0x1C;
        SEQ CLK 0 -> CLK 1 -> CLK 0;
        EVAL;
        ASSERT DataOutA[31:0] 0xE33361AB; ASSERT DataOutB[31:0] 0x000000E7;
        SET DataIn[31:0] 0xFFFFFFC6, WriteAddr[4:0] 0x05, WriteEnable 0, ReadAddrA[4:0] 0x18, ReadAddrB[4:0] 0x01;
        SEQ CLK 0 -> CLK 1 -> CLK 0;
        EVAL;
        ASSERT DataOutA[31:0] 0xE33361AB; ASSERT DataOutB[31:0] 0xFFFFFFFF;
        SET DataIn[31:0] 0xFFFFFFF5, WriteAddr[4:0] 0x19, WriteEnable 0, ReadAddrA[4:0] 0x0F, ReadAddrB[4:0] 0x1B;
        SEQ CLK 0 -> CLK 1 -> CLK 0;
        EVAL;
        ASSERT DataOutA[31:0] 0x000000A7; ASSERT DataOutB[31:0] 0x00000001;
        SET DataIn[31:0] 0x0000001F, WriteAddr[4:0] 0x11, WriteEnable 0, ReadAddrA[4:0] 0x1D, ReadAddrB[4:0] 0x0B;
        SEQ CLK 0 -> CLK 1 -> CLK 0;
        EVAL;
        ASSERT DataOutA[31:0] 0xF4A2474F; ASSERT DataOutB[31:0] 0x59A8B8AF;
        SET DataIn[31:0] 0x74736179, WriteAddr[4:0] 0x08, WriteEnable 0, ReadAddrA[4:0] 0x02, ReadAddrB[4:0] 0x04;
        SEQ CLK 0 -> CLK 1 -> CLK 0;
        EVAL;
        ASSERT DataOutA[31:0] 0x0000001F; ASSERT DataOutB[31:0] 0xFFFFFFBF;
        SET DataIn[31:0] 0x77BDF69D, WriteAddr[4:0] 0x06, WriteEnable 0, ReadAddrA[4:0] 0x08, ReadAddrB[4:0] 0x0E;
        SEQ CLK 0 -> CLK 1 -> CLK 0;
        EVAL;
        ASSERT DataOutA[31:0] 0x7D5EC211; ASSERT DataOutB[31:0] 0xFFFFFFB3;
        SET DataIn[31:0] 0x000000E3, WriteAddr[4:0] 0x14, WriteEnable 0, ReadAddrA[4:0] 0x06, ReadAddrB[4:0] 0x1D;
        SEQ CLK 0 -> CLK 1 -> CLK 0;
        EVAL;
        ASSERT DataOutA[31:0] 0xFFFFFF53; ASSERT DataOutB[31:0] 0xF4A2474F;
        SET DataIn[31:0] 0x00000020, WriteAddr[4:0] 0x1B, WriteEnable 0, ReadAddrA[4:0] 0x0F, ReadAddrB[4:0] 0x06;
        SEQ CLK 0 -> CLK 1 -> CLK 0;
        EVAL;
        ASSERT DataOutA[31:0] 0x000000A7; ASSERT DataOutB[31:0] 0xFFFFFF53;
        SET DataIn[31:0] 0xFFFFFF31, WriteAddr[4:0] 0x1C, WriteEnable 0, ReadAddrA[4:0] 0x1D, ReadAddrB[4:0] 0x1B;
        SEQ CLK 0 -> CLK 1 -> CLK 0;
        EVAL;
        ASSERT DataOutA[31:0] 0xF4A2474F; ASSERT DataOutB[31:0] 0x00000001;
        SET DataIn[31:0] 0x7FFFFFFF, WriteAddr[4:0] 0x05, WriteEnable 0, ReadAddrA[4:0] 0x05, ReadAddrB[4:0] 0x1C;
        SEQ CLK 0 -> CLK 1 -> CLK 0;
        EVAL;
        ASSERT DataOutA[31:0] 0x4A25CAE7; ASSERT DataOutB[31:0] 0x000000E7;
        SET DataIn[31:0] 0x80000000, WriteAddr[4:0] 0x15, WriteEnable 0, ReadAddrA[4:0] 0x01, ReadAddrB[4:0] 0x08;
        SEQ CLK 0 -> CLK 1 -> CLK 0;
        EVAL;
        ASSERT DataOutA[31:0] 0xFFFFFFFF; ASSERT DataOutB[31:0] 0x7D5EC211;
    }
}
