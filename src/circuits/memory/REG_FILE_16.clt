        ASSERT DataOutA[0] 0; ASSERT DataOutA[1] 0; ASSERT DataOutA[2] 1; ASSERT DataOutA[3] 1; ASSERT DataOutA[4] 0; ASSERT DataOutA[5] 1; ASSERT DataOutA[6] 1; ASSERT DataOutA[7] 0; ASSERT DataOutA[8] 0; ASSERT DataOutA[9] 0; ASSERT DataOutA[10] 1; ASSERT DataOutA[11] 1; ASSERT DataOutA[12] 1; ASSERT DataOutA[13] 1; ASSERT DataOutA[14] 1; ASSERT DataOutA[15] 1;
        ASSERT DataOutB[0] 1; ASSERT DataOutB[1] 1; ASSERT DataOutB[2] 1; ASSERT DataOutB[3] 1; ASSERT DataOutB[4] 0; ASSERT DataOutB[5] 1; ASSERT DataOutB[6] 0; ASSERT DataOutB[7] 1; ASSERT DataOutB[8] 1; ASSERT DataOutB[9] 1; ASSERT DataOutB[10] 1; ASSERT DataOutB[11] 0; ASSERT DataOutB[12] 0; ASSERT DataOutB[13] 1; ASSERT DataOutB[14] 0; ASSERT DataOutB[15] 0;
        SET ReadAddrA[0] 0, ReadAddrA[1] 1, ReadAddrA[2] 1, ReadAddrA[3] 1;
        SET ReadAddrB[0] 1, ReadAddrB[1] 0, ReadAddrB[2] 0, ReadAddrB[3] 0;
        EVAL;
        ASSERT DataOutA[0] 1; ASSERT DataOutA[1] 1; ASSERT DataOutA[2] 0; ASSERT DataOutA[3] 0; ASSERT DataOutA[4] 0; ASSERT DataOutA[5] 0; ASSERT DataOutA[6] 1; ASSERT DataOutA[7] 1; ASSERT DataOutA[8] 1; ASSERT DataOutA[9] 1; ASSERT DataOutA[10] 1; ASSERT DataOutA[11] 1; ASSERT DataOutA[12] 0; ASSERT DataOutA[13] 0; ASSERT DataOutA[14] 0; ASSERT DataOutA[15] 0;
        ASSERT DataOutB[0] 0; ASSERT DataOutB[1] 0; ASSERT DataOutB[2] 0; ASSERT DataOutB[3] 1; ASSERT DataOutB[4] 1; ASSERT DataOutB[5] 0; ASSERT DataOutB[6] 1; ASSERT DataOutB[7] 0; ASSERT DataOutB[8] 0; ASSERT DataOutB[9] 0; ASSERT DataOutB[10] 1; ASSERT DataOutB[11] 0; ASSERT DataOutB[12] 1; ASSERT DataOutB[13] 0; ASSERT DataOutB[14] 0; ASSERT DataOutB[15] 0;
        SET ReadAddrA[0] 1, ReadAddrA[1] 1, ReadAddrA[2] 1, ReadAddrA[3] 1;
        SET ReadAddrB[0] 0, ReadAddrB[1] 0, ReadAddrB[2] 0, ReadAddrB[3] 0;
        EVAL;
        ASSERT DataOutA[0] 0; ASSERT DataOutA[1] 1; ASSERT DataOutA[2] 0; ASSERT DataOutA[3] 1; ASSERT DataOutA[4] 1; ASSERT DataOutA[5] 0; ASSERT DataOutA[6] 0; ASSERT DataOutA[7] 0; ASSERT DataOutA[8] 1; ASSERT DataOutA[9] 1; ASSERT DataOutA[10] 0; ASSERT DataOutA[11] 0; ASSERT DataOutA[12] 0; ASSERT DataOutA[13] 1; ASSERT DataOutA[14] 0; ASSERT DataOutA[15] 0;
        ASSERT DataOutB[0] 0; ASSERT DataOutB[1] 0; ASSERT DataOutB[2] 0; ASSERT DataOutB[3] 0; ASSERT DataOutB[4] 0; ASSERT DataOutB[5] 0; ASSERT DataOutB[6] 0; ASSERT DataOutB[7] 0; ASSERT DataOutB[8] 0; ASSERT DataOutB[9] 0; ASSERT DataOutB[10] 0; ASSERT DataOutB[11] 0; ASSERT DataOutB[12] 0; ASSERT DataOutB[13] 0; ASSERT DataOutB[14] 0; ASSERT DataOutB[15] 0;
    }

    TEST "R0 ignores writes" {
        SET WriteAddr[0] 0, WriteAddr[1] 0, WriteAddr[2] 0, WriteAddr[3] 0;
        SET DataIn[0] 1, DataIn[1] 1, DataIn[2] 1, DataIn[3] 1, DataIn[4] 0, DataIn[5] 1, DataIn[6] 1, DataIn[7] 1, DataIn[8] 0, DataIn[9] 1, DataIn[10] 1, DataIn[11] 1, DataIn[12] 1, DataIn[13] 1, DataIn[14] 0, DataIn[15] 1;
        SET WriteEnable 1;
        SEQ CLK 0 -> CLK 1 -> CLK 0;
        SET WriteEnable 0;
        SET ReadAddrA[0] 0, ReadAddrA[1] 0, ReadAddrA[2] 0, ReadAddrA[3] 0;
        SET ReadAddrB[0] 0, ReadAddrB[1] 0, ReadAddrB[2] 0, ReadAddrB[3] 0;
        EVAL;
        ASSERT DataOutA[0] 0; ASSERT DataOutA[1] 0; ASSERT DataOutA[2] 0; ASSERT DataOutA[3] 0; ASSERT DataOutA[4] 0; ASSERT DataOutA[5] 0; ASSERT DataOutA[6] 0; ASSERT DataOutA[7] 0; ASSERT DataOutA[8] 0; ASSERT DataOutA[9] 0; ASSERT DataOutA[10] 0; ASSERT DataOutA[11] 0; ASSERT DataOutA[12] 0; ASSERT DataOutA[13] 0; ASSERT DataOutA[14] 0; ASSERT DataOutA[15] 0;
        ASSERT DataOutB[0] 0; ASSERT DataOutB[1] 0; ASSERT DataOutB[2] 0; ASSERT DataOutB[3] 0; ASSERT DataOutB[4] 0; ASSERT DataOutB[5] 0; ASSERT DataOutB[6] 0; ASSERT DataOutB[7] 0; ASSERT DataOutB[8] 0; ASSERT DataOutB[9] 0; ASSERT DataOutB[10] 0; ASSERT DataOutB[11] 0; ASSERT DataOutB[12] 0; ASSERT DataOutB[13] 0; ASSERT DataOutB[14] 0; ASSERT DataOutB[15] 0;
    }

    TEST "WriteEnable=0 keeps the value" {
        SET WriteAddr[0] 1, WriteAddr[1] 0, WriteAddr[2] 1, WriteAddr[3] 0;
        SET DataIn[0] 1, DataIn[1] 0, DataIn[2] 1, DataIn[3] 1, DataIn[4] 0, DataIn[5] 1, DataIn[6] 0, DataIn[7] 1, DataIn[8] 0, DataIn[9] 1, DataIn[10] 1, DataIn[11] 1, DataIn[12] 1, DataIn[13] 0, DataIn[14] 1, DataIn[15] 1;
        SET WriteEnable 0;
        SEQ CLK 0 -> CLK 1 -> CLK 0;
        SET WriteEnable 0;
        SET ReadAddrA[0] 1, ReadAddrA[1] 0, ReadAddrA[2] 1, ReadAddrA[3] 0;
        SET ReadAddrB[0] 0, ReadAddrB[1] 1, ReadAddrB[2] 1, ReadAddrB[3] 0;
        EVAL;
        ASSERT DataOutA[0] 0; ASSERT DataOutA[1] 0; ASSERT DataOutA[2] 1; ASSERT DataOutA[3] 0; ASSERT DataOutA[4] 1; ASSERT DataOutA[5] 1; ASSERT DataOutA[6] 0; ASSERT DataOutA[7] 1; ASSERT DataOutA[8] 1; ASSERT DataOutA[9] 0; ASSERT DataOutA[10] 0; ASSERT DataOutA[11] 0; ASSERT DataOutA[12] 0; ASSERT DataOutA[13] 1; ASSERT DataOutA[14] 1; ASSERT DataOutA[15] 0;
        ASSERT DataOutB[0] 1; ASSERT DataOutB[1] 1; ASSERT DataOutB[2] 0; ASSERT DataOutB[3] 1; ASSERT DataOutB[4] 0; ASSERT DataOutB[5] 0; ASSERT DataOutB[6] 0; ASSERT DataOutB[7] 0; ASSERT DataOutB[8] 1; ASSERT DataOutB[9] 0; ASSERT DataOutB[10] 1; ASSERT DataOutB[11] 0; ASSERT DataOutB[12] 1; ASSERT DataOutB[13] 1; ASSERT DataOutB[14] 1; ASSERT DataOutB[15] 0;
    }

    TEST "Overwrite R7" {
        SET WriteAddr[0] 1, WriteAddr[1] 1, WriteAddr[2] 1, WriteAddr[3] 0;
        SET DataIn[0] 1, DataIn[1] 1, DataIn[2] 1, DataIn[3] 1, DataIn[4] 1, DataIn[5] 1, DataIn[6] 1, DataIn[7] 1, DataIn[8] 1, DataIn[9] 1, DataIn[10] 1, DataIn[11] 1, DataIn[12] 1, DataIn[13] 1, DataIn[14] 1, DataIn[15] 1;
        SET WriteEnable 1;
        SEQ CLK 0 -> CLK 1 -> CLK 0;
        SET WriteEnable 0;
        SET ReadAddrA[0] 1, ReadAddrA[1] 1, ReadAddrA[2] 1, ReadAddrA[3] 0;
        SET ReadAddrB[0] 0, ReadAddrB[1] 0, ReadAddrB[2] 0, ReadAddrB[3] 1;
        EVAL;
        ASSERT DataOutA[0] 1; ASSERT DataOutA[1] 1; ASSERT DataOutA[2] 1; ASSERT DataOutA[3] 1; ASSERT DataOutA[4] 1; ASSERT DataOutA[5] 1; ASSERT DataOutA[6] 1; ASSERT DataOutA[7] 1; ASSERT DataOutA[8] 1; ASSERT DataOutA[9] 1; ASSERT DataOutA[10] 1; ASSERT DataOutA[11] 1; ASSERT DataOutA[12] 1; ASSERT DataOutA[13] 1; ASSERT DataOutA[14] 1; ASSERT DataOutA[15] 1;
        ASSERT DataOutB[0] 1; ASSERT DataOutB[1] 0; ASSERT DataOutB[2] 0; ASSERT DataOutB[3] 1; ASSERT DataOutB[4] 1; ASSERT DataOutB[5] 1; ASSERT DataOutB[6] 0; ASSERT DataOutB[7] 1; ASSERT DataOutB[8] 1; ASSERT DataOutB[9] 1; ASSERT DataOutB[10] 0; ASSERT DataOutB[11] 1; ASSERT DataOutB[12] 1; ASSERT DataOutB[13] 0; ASSERT DataOutB[14] 0; ASSERT DataOutB[15] 1;
    }
}
