CIRCUIT SR_LATCH {
    INPUT Set, Reset;
    OUTPUT Q, nQ;

    PART G_Q: NOR;
    PART G_nQ: NOR;

    CONNECT G_Q.out -> Q;
    CONNECT G_nQ.out -> nQ;

    CONNECT Reset -> G_Q.in1;
    CONNECT G_nQ.out -> G_Q.in2;

    CONNECT Set -> G_nQ.in2;
    CONNECT G_Q.out -> G_nQ.in1;

    INIT {
        SEQ Reset 1 -> Reset 0;
    }
}
