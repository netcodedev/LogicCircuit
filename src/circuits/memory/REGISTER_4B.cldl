CIRCUIT REGISTER_4B {
    // Inputs: 4 Data bits bus (D) and 1 Clock signal (CLK)
    INPUT D[4];
    INPUT CLK;

    // Outputs: 4 Stored bits bus (Q) and their complements bus (nQ)
    OUTPUT Q[4];
    OUTPUT nQ[4]; 

    PART DFF0: DFLIP_FLOP; // Stores bit 0
    PART DFF1: DFLIP_FLOP; // Stores bit 1
    PART DFF2: DFLIP_FLOP; // Stores bit 2
    PART DFF3: DFLIP_FLOP; // Stores bit 3

    CONNECT CLK -> DFF0.CLK;
    CONNECT CLK -> DFF1.CLK;
    CONNECT CLK -> DFF2.CLK;
    CONNECT CLK -> DFF3.CLK;

    CONNECT D[0] -> DFF0.D;
    CONNECT D[1] -> DFF1.D;
    CONNECT D[2] -> DFF2.D;
    CONNECT D[3] -> DFF3.D;

    CONNECT DFF0.Q -> Q[0];
    CONNECT DFF1.Q -> Q[1];
    CONNECT DFF2.Q -> Q[2];
    CONNECT DFF3.Q -> Q[3];

    CONNECT DFF0.nQ -> nQ[0];
    CONNECT DFF1.nQ -> nQ[1];
    CONNECT DFF2.nQ -> nQ[2];
    CONNECT DFF3.nQ -> nQ[3];

    INIT {
        // Set all data inputs low, pulse the clock once (0->1->0)
        SEQ D[0] 0, D[1] 0, D[2] 0, D[3] 0, CLK 0 -> CLK 1 -> CLK 0;
    }
}
